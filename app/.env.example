# Huda reader: every environment variable the code reads (app/src, app/scripts, next.config.ts).
# Copy to .env.local (git-ignored) and fill in only what you need. Never commit real values.
# With none of these set, `pnpm build` produces the static reader: no server, no "ask", no sign-in.
# Empty value = unset. A default in a comment is what the code uses when the variable is unset.

# --- Server mode switches (read at BUILD time as well as at run time) ---
# "1" builds a Node server and enables the "ask" routes (/api/ask, /api/transcribe, /api/key-check).
HUDA_ASK=
# "1" builds a Node server and enables the adaptive weaving route (/api/weave).
HUDA_WEAVE=

# --- Retrieval database (PostgreSQL 18 with the pgvector extension) ---
# Connection string used by "ask" retrieval and by `pnpm rag:ingest` and `pnpm eval:retrieval`.
# Unset: book-passage retrieval for "ask" is off (the code checks DATABASE_URL before using it).
DATABASE_URL=
# Connection string of a throw-away database for the database tests (tests skip when unset).
HUDA_TEST_DATABASE_URL=
# Schema that holds the retrieval tables (default: rag; tests use rag_test).
HUDA_RAG_SCHEMA=
# Retrieval legs: hybrid | lexical | dense (default: hybrid).
HUDA_RAG_MODE=
# "local" turns on the in-process embedding model (default: off, lexical retrieval only).
HUDA_EMBED=
# Folder that contains Xenova/multilingual-e5-small/ (needed only when HUDA_EMBED=local).
HUDA_EMBED_MODEL_DIR=
# Repository root used by `pnpm rag:ingest` to find .cache/ (default: the parent of app/).
HUDA_REPO_ROOT=

# --- "Ask" behaviour ---
# Comma-separated provider order: opencode-go | openai | gemini | anthropic | groq (default: every provider whose key is set, in that order).
HUDA_ASK_PROVIDER=
# Model name for the chosen provider (default: gpt-6-luna; claude-sonnet-5-5 for anthropic; gemini-3.8-flash for gemini).
HUDA_ASK_MODEL=
# Model name when the provider is groq (default: openai/gpt-oss-120b).
HUDA_ASK_GROQ_MODEL=
# Model name when the provider is gemini and the key is the one a reviewer types in the UI (default: gemini-3.8-flash).
HUDA_ASK_GEMINI_MODEL=
# Model that answers when the gemini model is down (HTTP 5xx, 429 or no answer from the network). Unset: gemini-3.5-flash-lite; set to an empty string: no fallback.
HUDA_ASK_GEMINI_FALLBACK_MODEL=
# Model name when the provider is openai and the key is the one a reviewer types in the UI (default: gpt-6-luna).
HUDA_ASK_OPENAI_MODEL=
# Model tried only when the openai model is not available to that account. Unset: gpt-5-mini; set to an empty string: no fallback.
HUDA_ASK_OPENAI_FALLBACK_MODEL=
# Reasoning effort sent to the provider, or "default" to send none (default: low).
HUDA_ASK_EFFORT=
# "extractive" skips the written answer and returns chosen sentences only (default: composed answer).
HUDA_ASK_MODE=
# "0" turns off the supporting-sentence stage (default: on).
HUDA_ASK_SUPPORT=
# "0" turns off book-passage retrieval even when DATABASE_URL is set (default: on).
HUDA_ASK_SOURCES=
# "1" stores readers' questions in the database for evaluation (default: off; nothing is stored).
HUDA_ASK_LOG_QUESTIONS=
# Requests per minute used by `pnpm eval:ask` (default: 10).
HUDA_ASK_EVAL_RPM=

# --- Provider keys (all optional; the reviewer can also type their own key in the UI) ---
# OpenCode Go (the default provider for "ask").
OPENCODE_GO_API_KEY=
# OpenAI (fallback provider).
OPENAI_API_KEY=
# Google AI Studio (Gemini provider).
GEMINI_API_KEY=
# Anthropic (Claude provider).
ANTHROPIC_API_KEY=
# Groq: speech-to-text for the voice question, and the optional groq text provider.
GROQ_API_KEY=

# --- Voice question ---
# Base URL of a local Whisper-compatible server, used instead of Groq (default: the Groq endpoint).
HUDA_VOICE_STT_URL=
# Speech-to-text model name (default: whisper-large-v3).
HUDA_VOICE_STT_MODEL=
# Model that repairs transcription errors; "0" turns the repair off (default: openai/gpt-oss-120b).
HUDA_VOICE_FIX_MODEL=

# --- Sign-in (Clerk): being added, optional, decision 089. Never blocks reading or "ask". ---
# Enabled only in a server build (HUDA_ASK=1 or HUDA_WEAVE=1) when the publishable key is set; use production keys on the live service.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Sign-in and sign-up page paths (render.yaml sets /sign-in and /sign-up).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

# --- Development only ---
# Alternative Next.js build folder, used to build beside a running dev server (default: .next).
M009_DIST=
