{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 10400,
    "dDurationMs": 9660,
    "segs": [ {
      "utf8": "بسم الله الرحمن الرحيم الحمد لله والصلاه\nوالسلام على رسول الله وعلى اله وصحبه ومن"
    } ]
  }, {
    "tStartMs": 20060,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "والاه. السلام عليكم ورحمة الله وبركاته."
    } ]
  }, {
    "tStartMs": 26420,
    "dDurationMs": 8520,
    "segs": [ {
      "utf8": "حين يزداد الظلام وتتلبد سماء الواقع بالفتن\nوغيوم الشبهات"
    } ]
  }, {
    "tStartMs": 36020,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "يحتاج الانسان الى كهف يؤويه ويحميه."
    } ]
  }, {
    "tStartMs": 42140,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "يحتاج الى نور يضيء له الطريق."
    } ]
  }, {
    "tStartMs": 46430,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "يحتاج الى نور ياتي على هذه الظلمات فيبدد\nبها."
    } ]
  }, {
    "tStartMs": 53870,
    "dDurationMs": 9490,
    "segs": [ {
      "utf8": "يحتاج الى. الى شيء يبدد كل ما حوله من فتن\nويضيء الطريق وينير الطريق والمسار"
    } ]
  }, {
    "tStartMs": 63750,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "امام عيني ليسير الى الامام على الصراط\nالمستقيم."
    } ]
  }, {
    "tStartMs": 70020,
    "dDurationMs": 9420,
    "segs": [ {
      "utf8": "وهنا تاتي سوره الكهف هذه السوره العظيمه التي\nورد في فضلها الاحاديث الكثيره والمتعدده"
    } ]
  }, {
    "tStartMs": 80100,
    "dDurationMs": 8910,
    "segs": [ {
      "utf8": "عن النبي صلى الله عليه وسلم يقول في ذلك من\nقرا سوره الكهف ليله الجمعه"
    } ]
  }, {
    "tStartMs": 89820,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "اضاء له من النور ما بينه وبين البيت العتيق."
    } ]
  }, {
    "tStartMs": 95040,
    "dDurationMs": 9960,
    "segs": [ {
      "utf8": "وفي حديث صحيح اخر من حفظ عشر ايات من اول\nسوره الكهف وفي روايه من اخرها عصم"
    } ]
  }, {
    "tStartMs": 105000,
    "dDurationMs": 9630,
    "segs": [ {
      "utf8": "من فتنه الدجال حديث اخر صحيح من قرا سوره\nالكهف كانت له نورا الى"
    } ]
  }, {
    "tStartMs": 114630,
    "dDurationMs": 9550,
    "segs": [ {
      "utf8": "يوم القيامه من مقامه الى مكه ومن قرا عشر\nايات من اخرها ثم خرج الدجال"
    } ]
  }, {
    "tStartMs": 124540,
    "dDurationMs": 8580,
    "segs": [ {
      "utf8": "لم يضره ومن توضا فقال سبحانك اللهم وبحمدك\nاشهد ان لا اله الا انت"
    } ]
  }, {
    "tStartMs": 133690,
    "dDurationMs": 9120,
    "segs": [ {
      "utf8": "استغفرك واتوب اليك كتب له في رق ثم جعل في\nطابع فلم يكسر الى يوم القيامه."
    } ]
  }, {
    "tStartMs": 143740,
    "dDurationMs": 9900,
    "segs": [ {
      "utf8": "هذه سوره الكهف كل الاحاديث الوارده في فضلها\nتبين بان هناك في هذه السوره"
    } ]
  }, {
    "tStartMs": 154030,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "من المعاني ومن الوقفات التي اذا ما تدبرها\nالمؤمن وهو يكرر قراءه هذه السوره في كل اسبوع"
    } ]
  }, {
    "tStartMs": 164890,
    "dDurationMs": 9090,
    "segs": [ {
      "utf8": "سيكون له ملاذ سيكون له حمايه سيكون له ماوى\nمن الفتن وخاصه فتن اخر الزمان"
    } ]
  }, {
    "tStartMs": 174550,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "التي تحدثت عنها هذه السورة العظيمة."
    } ]
  }, {
    "tStartMs": 178690,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "فيا ترى ماذا في هذه السورة من معاني تستجلب\nوتستدعي تبديد الفتن والظلمات؟ ماذا في"
    } ]
  }, {
    "tStartMs": 188680,
    "dDurationMs": 9450,
    "segs": [ {
      "utf8": "سورة الكهف من النور لكي يبدد به الانسان\nالظلمات التي باتت تحيط به من كل حدب ومن كل"
    } ]
  }, {
    "tStartMs": 198130,
    "dDurationMs": 9390,
    "segs": [ {
      "utf8": "صوب؟ السورة مكية نزلت على النبي صلى الله\nعليه وسلم وهو في حالة شديدة هو"
    } ]
  }, {
    "tStartMs": 207520,
    "dDurationMs": 9540,
    "segs": [ {
      "utf8": "واصحابه من المعاناة، من الضعف، من التنكيل،\nمن كل نواحي التعذيب المختلفة التي تفنن"
    } ]
  }, {
    "tStartMs": 217060,
    "dDurationMs": 8820,
    "segs": [ {
      "utf8": "المشركون في صبها على النبي صلى الله عليه\nوسلم واصحابه في محاولة يائسة بائسة"
    } ]
  }, {
    "tStartMs": 226810,
    "dDurationMs": 5610,
    "segs": [ {
      "utf8": "لثني النبي عليه الصلاة والسلام عن الاستمرار\nفي دعوته المباركة."
    } ]
  }, {
    "tStartMs": 233410,
    "dDurationMs": 8680,
    "segs": [ {
      "utf8": "في تلك الأثناء، وفي تلك الأجواء من المحن ومن\nالتعذيب ومن الضعف والشعور بالضعف والشعور"
    } ]
  }, {
    "tStartMs": 242090,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "بمعنى الفتنة في الدين."
    } ]
  }, {
    "tStartMs": 244100,
    "dDurationMs": 9660,
    "segs": [ {
      "utf8": "حقيقة لان الكلام او الحديث الذي سنأتي عليه\nتباعا ان شاء الله في سورة الكهف حديث عن مختلف"
    } ]
  }, {
    "tStartMs": 253790,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "انواع الفتن. ابتلاءات."
    } ]
  }, {
    "tStartMs": 255950,
    "dDurationMs": 8880,
    "segs": [ {
      "utf8": "محن. ولكن سنجد ان اشد فتنة يمكن ان يتعرض\nاليها الانسان ان يفتن في دينه."
    } ]
  }, {
    "tStartMs": 265640,
    "dDurationMs": 9360,
    "segs": [ {
      "utf8": "فالنبي صلى الله عليه وسلم واصحابه الكرام في\nتلك الاجواء كانوا يتعرضون لفتنة والامتحان"
    } ]
  }, {
    "tStartMs": 275000,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "وابتلاء في الدين وهذه من اشد الفتن."
    } ]
  }, {
    "tStartMs": 280220,
    "dDurationMs": 8850,
    "segs": [ {
      "utf8": "جاءت السورة المباركة التي هي في تعداد النزول\nحسب نزول القرآن الكريم تحتل المرتبة التاسعة"
    } ]
  }, {
    "tStartMs": 289070,
    "dDurationMs": 9150,
    "segs": [ {
      "utf8": "وستين. جاءت هذه السورة التي تعضد وتقوي\nالنواحي التي ينبغي ان"
    } ]
  }, {
    "tStartMs": 298250,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "يمتلكها الانسان في اي وقت وفي اي زمان اذا\nاراد ان يواجه الفتن."
    } ]
  }, {
    "tStartMs": 304970,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "وبخاصه فتنه الدين جاءت على النبي عليه الصلاه\nوالسلام ونزلت عليه وعلى اصحابه لتبين له"
    } ]
  }, {
    "tStartMs": 315410,
    "dDurationMs": 8490,
    "segs": [ {
      "utf8": "ان تلك الفتن وتلك الامتحانات مهما قويت ومهما\nكان فيها من جوانب مؤلمه ومآسي"
    } ]
  }, {
    "tStartMs": 324440,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "وابتلاءات ومحن فانها ستزول."
    } ]
  }, {
    "tStartMs": 328790,
    "dDurationMs": 9510,
    "segs": [ {
      "utf8": "المخرج الاساسي من كيفية التخلص من هذه الفتن\nيكمن في تأكيد التوحيد في تكريس"
    } ]
  }, {
    "tStartMs": 338300,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "التوحيد كما هي العادة في مختلف السور المكية\nوفي كل القرآن."
    } ]
  }, {
    "tStartMs": 345110,
    "dDurationMs": 9100,
    "segs": [ {
      "utf8": "كلما ازدادت قوة التوحيد في القلب كلما ازدادت\nقوة التمسك بهذا التوحيد وتصحيحه من كل شائبة"
    } ]
  }, {
    "tStartMs": 354750,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "واخلاص. وتخليص العمل لله عز وجل."
    } ]
  }, {
    "tStartMs": 358560,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "وجعل العمل خالصا لوجهه سبحانه."
    } ]
  }, {
    "tStartMs": 361950,
    "dDurationMs": 8790,
    "segs": [ {
      "utf8": "كلما كان ذلك عصمة للانسان اكثر فاكثر نحو\nالتمسك بهذا الدين والابتعاد عن كل الفتن."
    } ]
  }, {
    "tStartMs": 371880,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "السورة العظيمة حددت اسباب الفتن واجواء الفتن\nفي كل زمان."
    } ]
  }, {
    "tStartMs": 378840,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "رسالة باقية كما هو القران."
    } ]
  }, {
    "tStartMs": 381600,
    "dDurationMs": 9900,
    "segs": [ {
      "utf8": "وحددت كذلك معها كيفية الخطوات التي يمكن ان\nيسير عليها الانسان للتخلص من ظلمات الفتن"
    } ]
  }, {
    "tStartMs": 391860,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "ومن نور الفتن."
    } ]
  }, {
    "tStartMs": 393390,
    "dDurationMs": 6990,
    "segs": [ {
      "utf8": "فكانت بحق هذه السورة العظيمة نور يضيء\nللانسان في طريق الحياة."
    } ]
  }, {
    "tStartMs": 400860,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "نور يضيء له في طريق الفتن المتلاطمه."
    } ]
  }, {
    "tStartMs": 404640,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "حين يزداد السواد في تلك الفتن."
    } ]
  }, {
    "tStartMs": 407460,
    "dDurationMs": 9730,
    "segs": [ {
      "utf8": "ولذلك لا عجب ان يكون اول كلمة في هذه السورة\nالمفتتحة بالتحميد لله سبحانه"
    } ]
  }, {
    "tStartMs": 417190,
    "dDurationMs": 9810,
    "segs": [ {
      "utf8": "وتعالى. ولا عجب كذلك ذلك الترابط العجيب بين\nختام ونهاية سورة الاسراء حين يقول الله عز وجل"
    } ]
  }, {
    "tStartMs": 427000,
    "dDurationMs": 9180,
    "segs": [ {
      "utf8": "وقل الحمد لله الذي لم يتخذ ولدا ولم يكن له\nشريك في الملك ولم يكن له ولي من الذل"
    } ]
  }, {
    "tStartMs": 436270,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "وكبره تكبيرا."
    } ]
  }, {
    "tStartMs": 438400,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "ثم تأتي سورة الكهف التي."
    } ]
  }, {
    "tStartMs": 441310,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "هناك فاصل زمني واسع بين سورة الاسراء وسورة\nالكهف ولكنها في ترتيب المصحف الذي بني على"
    } ]
  }, {
    "tStartMs": 451030,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "التوقيف من عند الله عز وجل ان يفتتحها بالحمد\nفقال الحمد لله الذي انزل على عبده الكتاب."
    } ]
  }, {
    "tStartMs": 461590,
    "dDurationMs": 8590,
    "segs": [ {
      "utf8": "ثم ان سورة الكهف هي واحدة من خمس سور في\nالقرآن افتتحها الله عز وجل بقوله."
    } ]
  }, {
    "tStartMs": 470210,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "الحمد لله."
    } ]
  }, {
    "tStartMs": 472640,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "والسورة العظيمة شملت كل معاني الحمد."
    } ]
  }, {
    "tStartMs": 477110,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "على أي نعمة."
    } ]
  }, {
    "tStartMs": 478580,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "نعمة القرآن العظيم."
    } ]
  }, {
    "tStartMs": 480650,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "تأملوا معي قول الله عز وجل."
    } ]
  }, {
    "tStartMs": 483380,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "الحمد لله الذي أنزل على عبده الكتاب، ولم\nيجعل له عوجا قيما لينذر بأسا شديدا من لدنه،"
    } ]
  }, {
    "tStartMs": 493610,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "ويبشر المؤمنين الذين يعملون الصالحات أن لهم\nأجرا حسنا."
    } ]
  }, {
    "tStartMs": 500870,
    "dDurationMs": 9600,
    "segs": [ {
      "utf8": "الحمد لله ملء الحمد ملء القلب تسبيحا، وحمدا\nعلى نعمة القرآن أنزل على عبده الكتاب"
    } ]
  }, {
    "tStartMs": 511220,
    "dDurationMs": 7770,
    "segs": [ {
      "utf8": "الذي ما من شك أن ما من نعمة في هذا الكون هي\nأعظم من هذا الكتاب العظيم."
    } ]
  }, {
    "tStartMs": 519620,
    "dDurationMs": 6750,
    "segs": [ {
      "utf8": "ولنا أن نتدبر الآن ونبدأ بإدراك معاني الخروج\nمن الفتن."
    } ]
  }, {
    "tStartMs": 527110,
    "dDurationMs": 8070,
    "segs": [ {
      "utf8": "ما من فتنة مهما كانت تلك الفتنة في الدين او\nفي الرزق او في الولد او في السلطان او في"
    } ]
  }, {
    "tStartMs": 535180,
    "dDurationMs": 9150,
    "segs": [ {
      "utf8": "الجاه او في القوة في القديم او في الحديث الا\nوالقران هو مفتاح النجاة منها قارب النجاة."
    } ]
  }, {
    "tStartMs": 544900,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "بدون القرآن."
    } ]
  }, {
    "tStartMs": 546580,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "وبدون اللجوء الى القرآن العظيم."
    } ]
  }, {
    "tStartMs": 549730,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "لا يمكن ان يكون هناك عصم من الفتن."
    } ]
  }, {
    "tStartMs": 553090,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "لا يمكن اذا هو القرآن."
    } ]
  }, {
    "tStartMs": 555610,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "ولذا جاء."
    } ]
  }, {
    "tStartMs": 556660,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "الحمد لله الذي انزل على عبده الكتاب وجاء\nبذكر عبده صلى الله عليه وسلم قبل القرآن"
    } ]
  }, {
    "tStartMs": 566650,
    "dDurationMs": 9120,
    "segs": [ {
      "utf8": "تشريفا واصطفاء واعلاء لمنزلته صلى الله عليه\nوسلم وقد قيل في اول سوره الاسراء."
    } ]
  }, {
    "tStartMs": 575770,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "وهكذا التدبر بمعنى اننا حين نتدبر القرآن نصل\nاول السور"
    } ]
  }, {
    "tStartMs": 584780,
    "dDurationMs": 6030,
    "segs": [ {
      "utf8": "بخواتيمها نصل بدايات السور بخواتيمها."
    } ]
  }, {
    "tStartMs": 591290,
    "dDurationMs": 8520,
    "segs": [ {
      "utf8": "ثم ننظر ونتدبر في افتتاحية السورة التي قبلها\nوالسورة التي بعدها سورة الإسراء يقول فيها"
    } ]
  }, {
    "tStartMs": 599810,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "الله عز وجل سبحان الذي أسرى بعبده."
    } ]
  }, {
    "tStartMs": 604790,
    "dDurationMs": 7530,
    "segs": [ {
      "utf8": "والعبودية هنا تشريف للنبي صلى الله عليه وسلم\nلأنها عبودية من نوع خاص."
    } ]
  }, {
    "tStartMs": 612680,
    "dDurationMs": 7890,
    "segs": [ {
      "utf8": "النبي صلى الله عليه وسلم أصبح عبدا من نوع\nخاص صلوات ربي وسلامه عليه."
    } ]
  }, {
    "tStartMs": 620840,
    "dDurationMs": 9960,
    "segs": [ {
      "utf8": "والآن في سورة الكهف يفتتح فيقول الحمد لله\nالذي أنزل على عبده صلى الله عليه وسلم"
    } ]
  }, {
    "tStartMs": 631220,
    "dDurationMs": 9540,
    "segs": [ {
      "utf8": "الكتاب. إذن هو الكتاب، هو القرآن اسمه من كل\nالفتن من كل فتن الزمان والمكان، لا"
    } ]
  }, {
    "tStartMs": 640760,
    "dDurationMs": 9700,
    "segs": [ {
      "utf8": "حماية ولا عصمة إلا بهذا الوحي والرجوع اليه\nالذي يقوم حياه الانسان ولذلك قال ولم يجعل له"
    } ]
  }, {
    "tStartMs": 650460,
    "dDurationMs": 7080,
    "segs": [ {
      "utf8": "عوجا. القران بطبيعته يقوم حين تنحرف الاهواء\nبالانسان عن المسار."
    } ]
  }, {
    "tStartMs": 658140,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "الفتن بطبيعتها كما سنأتي عليها وتعرضها سوره\nالكهف."
    } ]
  }, {
    "tStartMs": 663390,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "الفتن بطبيعتها تحاول ان تحرف الانسان عن\nمساره الصحيح."
    } ]
  }, {
    "tStartMs": 669150,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "تحاول ان تخرج بنا عن الطريق المستقيم."
    } ]
  }, {
    "tStartMs": 673410,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "تحاول ان تخرجنا باهوائهم وظلماتها عن الطريق\nالمستقيم."
    } ]
  }, {
    "tStartMs": 679860,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "من الذي يقوم ويصحح المسار."
    } ]
  }, {
    "tStartMs": 682980,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "القران. الرجوع اليه."
    } ]
  }, {
    "tStartMs": 685260,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "ولذا كان لابد لي من ان اقرأ سورة الكهف."
    } ]
  }, {
    "tStartMs": 690300,
    "dDurationMs": 8880,
    "segs": [ {
      "utf8": "على الاقل ما بين الجمعتين لتضيء لي الطريق\nلتضيء لي الدرب اذا نسيت او غفلت عن الاتصال"
    } ]
  }, {
    "tStartMs": 699180,
    "dDurationMs": 8030,
    "segs": [ {
      "utf8": "والتواصل. وهذا لا ينبغي ان يكون بالقران\nالعظيم بالوحي خلال الاسبوع او خلال الجمعه من"
    } ]
  }, {
    "tStartMs": 707210,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "الجمعه الى الجمعه."
    } ]
  }, {
    "tStartMs": 708830,
    "dDurationMs": 9420,
    "segs": [ {
      "utf8": "ستاتي سوره الكهف لتعدل المسار من جديد لتقوم\nبربطه بهذا القرآن العظيم لتقوم بشد من جديد"
    } ]
  }, {
    "tStartMs": 718250,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "للسير على الطريق الصحيح الذي لا ينبغي ان\nاحيد عنه."
    } ]
  }, {
    "tStartMs": 724820,
    "dDurationMs": 9630,
    "segs": [ {
      "utf8": "اول فتنة عظيمة تحدثت عنها السورة وبينت فيها\nكانت فتنة الدين ووضعت قبل ان تبدأ"
    } ]
  }, {
    "tStartMs": 734450,
    "dDurationMs": 9870,
    "segs": [ {
      "utf8": "بعرض الفتنة او الابتلاء او المحنة ووضعت\nالاسس التي ينبغي التمسك بها للخروج من فتنة"
    } ]
  }, {
    "tStartMs": 744320,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "الدين التي هي اشد فتنة على الاطلاق قديما او\nحديثا."
    } ]
  }, {
    "tStartMs": 750050,
    "dDurationMs": 7680,
    "segs": [ {
      "utf8": "ولذا ورد في الدعاء الصحيح اللهم لا تجعل\nفتنتنا في ديننا لان الفتنة في الدين صعبة"
    } ]
  }, {
    "tStartMs": 758000,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "شديدة قد لا ينجو منها الإنسان والعياذ بالله."
    } ]
  }, {
    "tStartMs": 762390,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "السورة بدأت وتحدثت."
    } ]
  }, {
    "tStartMs": 764880,
    "dDurationMs": 8430,
    "segs": [ {
      "utf8": "بعد الحديث عن القرءان وأهمية اللجوء اليه\nومكانة القرآن بدأت بالحديث عن أي شيء."
    } ]
  }, {
    "tStartMs": 773790,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "عن التوحيد."
    } ]
  }, {
    "tStartMs": 775560,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "مسألة التوحيد كيف؟ الله عز وجل عرض في الايه\nالرابعه وينذر الذين قالوا اتخذ الله"
    } ]
  }, {
    "tStartMs": 785550,
    "dDurationMs": 9180,
    "segs": [ {
      "utf8": "ولدا ما لهم به من علم ولا لابائهم كبرت كلمه\nتخرج من افواههم ان يقولون الا كذبا"
    } ]
  }, {
    "tStartMs": 795240,
    "dDurationMs": 6300,
    "segs": [ {
      "utf8": "فلعلك باخع نفسك على آثارهم إن لم يؤمنوا بهذا\nالحديث أسفا."
    } ]
  }, {
    "tStartMs": 801990,
    "dDurationMs": 9900,
    "segs": [ {
      "utf8": "التوحيد. وسورة الكهف تقدم لي نماذج من الخلل\nفي التوحيد والعقيده منها الدعاء اتخاذ"
    } ]
  }, {
    "tStartMs": 811890,
    "dDurationMs": 9640,
    "segs": [ {
      "utf8": "الشريك او الولد لله سبحانه وتعالى وهو واحد\nجل في علاه اعظم جريمه يرتكبها الانسان في"
    } ]
  }, {
    "tStartMs": 821530,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "حق نفسه وفي حق الاخرين وفي حق المجتمع الذي\nيعيش فيه."
    } ]
  }, {
    "tStartMs": 827320,
    "dDurationMs": 9780,
    "segs": [ {
      "utf8": "ان يدعي ان لله ولد، ان يدعي ان لله شريك في\nملكه سبحانه وتعالى جريمه نكران التوحيد"
    } ]
  }, {
    "tStartMs": 837310,
    "dDurationMs": 9570,
    "segs": [ {
      "utf8": "جريمه الشرك جريمه الخلل في هذا التوحيد ثم\nتاتي الايه في تسليه وفي وقفه رائعه قبل"
    } ]
  }, {
    "tStartMs": 846880,
    "dDurationMs": 5940,
    "segs": [ {
      "utf8": "الحديث عن الفتنه الاولى فتنه الدين للنبي صلى\nالله عليه وسلم."
    } ]
  }, {
    "tStartMs": 853180,
    "dDurationMs": 9210,
    "segs": [ {
      "utf8": "النبي صلوات ربي وسلامه عليه كان يحمل من\nالانسانيه ومن معاني الحنان والعاطفه"
    } ]
  }, {
    "tStartMs": 862990,
    "dDurationMs": 6030,
    "segs": [ {
      "utf8": "ما طغت على جوانب متعدده في شخصيته العظيمه\nصلى الله عليه وسلم."
    } ]
  }, {
    "tStartMs": 869020,
    "dDurationMs": 6450,
    "segs": [ {
      "utf8": "كان كان في غاية الحنان كان في غايه الرأفة\nوالشفقه على قومه."
    } ]
  }, {
    "tStartMs": 875860,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "ولنا ان نقف هنا وقفة بسيطة."
    } ]
  }, {
    "tStartMs": 879110,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "القوم كانوا يصومونه واصحابه سوء العذاب."
    } ]
  }, {
    "tStartMs": 883700,
    "dDurationMs": 5940,
    "segs": [ {
      "utf8": "القوم تفننوا فيه في ان ينزلوا به صلى الله\nعليه وسلم."
    } ]
  }, {
    "tStartMs": 889640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "اشكال متعددة من التعذيب والإهانة."
    } ]
  }, {
    "tStartMs": 893600,
    "dDurationMs": 7950,
    "segs": [ {
      "utf8": "رموا حتى الاوساخ من الناقة على ظهره الشريف\nصلى الله عليه وسلم وهو يصلي في صحن الحرم."
    } ]
  }, {
    "tStartMs": 901970,
    "dDurationMs": 9030,
    "segs": [ {
      "utf8": "ما تركوا وسيلة إلا وسلكها في محاولة لردعه\nصلى الله عليه وسلم عن الاستمرار في دعوته."
    } ]
  }, {
    "tStartMs": 911630,
    "dDurationMs": 9060,
    "segs": [ {
      "utf8": "ولكن ذلك القلب العظيم قلب النبي صلى الله\nعليه وسلم الذي ما ارسل الا رحمة للعالمين الذي"
    } ]
  }, {
    "tStartMs": 920690,
    "dDurationMs": 8940,
    "segs": [ {
      "utf8": "وصفه ربه عزوجل فقال انك لعلى خلق عظيم وانك\nلعلى خلق عظيم."
    } ]
  }, {
    "tStartMs": 930050,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "هذا القلب العظيم كان يفيض بالمحبة والحنان\nوالشفقة على قومه."
    } ]
  }, {
    "tStartMs": 935480,
    "dDurationMs": 7630,
    "segs": [ {
      "utf8": "قومي فجاءت الاية فلعلك باخع نفسك على آثارهم\nإن لم يؤمنوا بهذا الحديث أسفا."
    } ]
  }, {
    "tStartMs": 943350,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "يا محمد صلى الله عليه وسلم اسى تذهب نفسك\nعليهم حسرات لعدم ايمان قومك"
    } ]
  }, {
    "tStartMs": 953190,
    "dDurationMs": 9510,
    "segs": [ {
      "utf8": "بهذا الكتاب ستقتل نفسك والايه يعني كلمات\nفلعلك باخع نفسك على اثارهم."
    } ]
  }, {
    "tStartMs": 962970,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "لم ترد في كتاب الله الا في موضعين موضع سوره\nالشعراء."
    } ]
  }, {
    "tStartMs": 967950,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "والموضع الثاني الذي لم تاتي بعده ابدا في\nسوره الكهف."
    } ]
  }, {
    "tStartMs": 972480,
    "dDurationMs": 9360,
    "segs": [ {
      "utf8": "عتاب وتسليه ورأفة وشفقه بهذا النبي العظيم\nالذي بلغ حنانه وشفقته وشفقته"
    } ]
  }, {
    "tStartMs": 982350,
    "dDurationMs": 9570,
    "segs": [ {
      "utf8": "على قومه الكافرين الذين يقومون بتعذيبه\nواصحابه هذه الشفقه العظيمه لدرجه ان نفسه قد"
    } ]
  }, {
    "tStartMs": 991920,
    "dDurationMs": 6670,
    "segs": [ {
      "utf8": "باتت تذهب حسرات على عدم الايمان واتباع هذا\nالقران العظيم."
    } ]
  }, {
    "tStartMs": 998800,
    "dDurationMs": 9690,
    "segs": [ {
      "utf8": "اسف الاسف ليس لاجل عدم ايمانهم او اتباعهم له\nكشخص ابدا الاسف على انهم لم يدركوا بعد"
    } ]
  }, {
    "tStartMs": 1008520,
    "dDurationMs": 7320,
    "segs": [ {
      "utf8": "عظمه القران العظيم الاسف على قومه بانهم لم\nيدركوا نور القران العظيم."
    } ]
  }, {
    "tStartMs": 1015840,
    "dDurationMs": 6510,
    "segs": [ {
      "utf8": "وهذه لفته رائعه لكل انسان يدعو الى سبيل ربك\nبالحكمه والموعظه الحسنه."
    } ]
  }, {
    "tStartMs": 1022980,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "حين ينحاز الناس عن طريق الحق عوضا عن ان تشعر\nبنوع من الحقد او ربما بنوع من الغيظ عليهم"
    } ]
  }, {
    "tStartMs": 1033180,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "اشعر بالرأفة لهم لمن يخالف هذا الدين."
    } ]
  }, {
    "tStartMs": 1037080,
    "dDurationMs": 7890,
    "segs": [ {
      "utf8": "اشعر بمشاعر العطف والشفقه على الخساره\nالعظيمه التي خسرها هؤلاء حين اعرضوا عن هذا"
    } ]
  }, {
    "tStartMs": 1044970,
    "dDurationMs": 6750,
    "segs": [ {
      "utf8": "الكتاب العظيم عوضا عن الشعور باي مشاعر من\nالغيظ او مشاعر من الحنق."
    } ]
  }, {
    "tStartMs": 1053230,
    "dDurationMs": 6270,
    "segs": [ {
      "utf8": "ثم تأتي الآية فتقول إنا جعلنا ما على الأرض\nزينة لها حقيقة الحياة."
    } ]
  }, {
    "tStartMs": 1059710,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "هذه خطوة أخرى من خطوات العصمة والخروج من\nالفتن."
    } ]
  }, {
    "tStartMs": 1064390,
    "dDurationMs": 8340,
    "segs": [ {
      "utf8": "اذا الوسيلة الاولى التمسك بالقران العظيم\nواللجوء اليه والاحتماء باياته العظيمة."
    } ]
  }, {
    "tStartMs": 1073240,
    "dDurationMs": 8760,
    "segs": [ {
      "utf8": "الوسيلة الثانية العظيمة التوحيد وتنقيته\nالمستمرة يوما بيوم وأولا بأول من كل شائبة"
    } ]
  }, {
    "tStartMs": 1082000,
    "dDurationMs": 9300,
    "segs": [ {
      "utf8": "تشوب. الوسيلة الثالثة إدراك حقيقة الدنيا\nووضع هذا الادراك نصب عيني وانا الاحظ الفتن"
    } ]
  }, {
    "tStartMs": 1091780,
    "dDurationMs": 8580,
    "segs": [ {
      "utf8": "وانا انظر الى السماء سماء الواقع الملبد\nبغيوم الفتن والمحن والابتلاءات والخطوب مهما"
    } ]
  }, {
    "tStartMs": 1100390,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "عظمت. ان هذه الدنيا في نهاية الامر ليست شيئا\nيذكر."
    } ]
  }, {
    "tStartMs": 1107650,
    "dDurationMs": 5470,
    "segs": [ {
      "utf8": "الله سبحانه وتعالى بقدرته المطلقة سيجعلها\nصعيدا جرزا."
    } ]
  }, {
    "tStartMs": 1113720,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "الغاية من وجودها."
    } ]
  }, {
    "tStartMs": 1115460,
    "dDurationMs": 9630,
    "segs": [ {
      "utf8": "الغايه من ان تكون زينه الغايه من وجود كل هذه\nالاجواء فيها لنبلوهم ايهم احسن عملا وهو"
    } ]
  }, {
    "tStartMs": 1125090,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "العالم بعباده سبحانه وتعالى."
    } ]
  }, {
    "tStartMs": 1128300,
    "dDurationMs": 9750,
    "segs": [ {
      "utf8": "احسن العمل سوره الكهف من خلال تدبر معانيها\nيوما بعد يوم وما بين الجمعتين واستذكار هذه"
    } ]
  }, {
    "tStartMs": 1138050,
    "dDurationMs": 7230,
    "segs": [ {
      "utf8": "المعاني في حياتي تؤهلني لان اصبح انسان يحسن\nالعمل في هذه الدنيا."
    } ]
  }, {
    "tStartMs": 1145820,
    "dDurationMs": 9480,
    "segs": [ {
      "utf8": "انسان يتعلم الاخلاص يتعلم فن الاخلاص، يتعلم\nصنعه الاخلاص حتى لا يغادر"
    } ]
  }, {
    "tStartMs": 1155300,
    "dDurationMs": 7110,
    "segs": [ {
      "utf8": "الاخلاص اي عمل يقوم به مهما كان ذلك العمل\nبسيطا او متواضعا."
    } ]
  }, {
    "tStartMs": 1162920,
    "dDurationMs": 8510,
    "segs": [ {
      "utf8": "لان الله سبحانه وتعالى لا ينظر الى حجم العمل\nالذي اقوم به ولا الى حجم الصدقه التي اقدمها"
    } ]
  }, {
    "tStartMs": 1171430,
    "dDurationMs": 6210,
    "segs": [ {
      "utf8": "بين يديه سبحانه، ولا الى عدد الركعات التي\nاركع لها واقف بين يديه."
    } ]
  }, {
    "tStartMs": 1177640,
    "dDurationMs": 9060,
    "segs": [ {
      "utf8": "سبحانه ينظر الى شيء اخر ينظر الى القلب الذي\nيتوجه اليه، ينظر الى الصدقه ليس من معيارنا."
    } ]
  }, {
    "tStartMs": 1186700,
    "dDurationMs": 9030,
    "segs": [ {
      "utf8": "نحن في بعض الاحيان مليون دينار ام نصف دينار\nولكن ينظر الى ذلك القلب الذي اخرجها قبل ان"
    } ]
  }, {
    "tStartMs": 1195730,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "تخرج وتمتد اليد."
    } ]
  }, {
    "tStartMs": 1197590,
    "dDurationMs": 9630,
    "segs": [ {
      "utf8": "بالصدقه ينظر الى الى القلب الذي قام حين يقوم\nوهو يصلي بين يدي ربه ينظر الى تلك الدمعه"
    } ]
  }, {
    "tStartMs": 1207220,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "التي تخرج من خشيته وتنسكب من خشيته."
    } ]
  }, {
    "tStartMs": 1211870,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "في جنح الظلام."
    } ]
  }, {
    "tStartMs": 1213340,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "وفي جنح الليل ليغفر بها لصاحبه."
    } ]
  }, {
    "tStartMs": 1217000,
    "dDurationMs": 6030,
    "segs": [ {
      "utf8": "الاخلاص لا يمكن ان يتقبل العمل بدون الاخلاص."
    } ]
  }, {
    "tStartMs": 1223060,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "ليبلوكم ايكم احسن عملا."
    } ]
  }, {
    "tStartMs": 1226030,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "اخلاص العمل."
    } ]
  }, {
    "tStartMs": 1227540,
    "dDurationMs": 8430,
    "segs": [ {
      "utf8": "ثم أن يكون العمل وفق ما جاء في هذا الوحي\nالعظيم ولذا قال أنزل على عبده الكتاب ولم يجعل"
    } ]
  }, {
    "tStartMs": 1235970,
    "dDurationMs": 9900,
    "segs": [ {
      "utf8": "له عوجا. ان امتلكت وتمنن الخالق المنان عليك\nبالإخلاص لابد أن تراقب العمل لكي"
    } ]
  }, {
    "tStartMs": 1245870,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "يكون وفق ما جاء في هذا الكتاب العظيم فلا\nيعوج بك يمينا ولا شمالا."
    } ]
  }, {
    "tStartMs": 1253220,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "يا لها من سورة عظيمة."
    } ]
  }, {
    "tStartMs": 1255560,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "ثم تأتي الاية وانا لجاعلون ما عليها صعيدا\nجرزا."
    } ]
  }, {
    "tStartMs": 1261440,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "لتسلي قلوب المؤمنين."
    } ]
  }, {
    "tStartMs": 1263960,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "ليس فقط النبي صلى الله عليه وسلم."
    } ]
  }, {
    "tStartMs": 1266930,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "كل مؤمن. كل مؤمن سيبتلى ويفتن في دينه."
    } ]
  }, {
    "tStartMs": 1272390,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "او في اي فتنة ستتعرض لها سورة الكهف."
    } ]
  }, {
    "tStartMs": 1276170,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "لانها جمعت الفتن."
    } ]
  }, {
    "tStartMs": 1278060,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "وانا لجاعلون ما عليها صعيدا جرزا حين."
    } ]
  }, {
    "tStartMs": 1282110,
    "dDurationMs": 6880,
    "segs": [ {
      "utf8": "حين يصيبنا ما يصيب كما يحدث في ايامنا\nالحالية في الواقع الذي نعيش."
    } ]
  }, {
    "tStartMs": 1289080,
    "dDurationMs": 7650,
    "segs": [ {
      "utf8": "حين تزداد الخطوب والفتن ويبدأ الانسان يشعر\nبالاسى والالم والاسف على ما يحدث من حوله."
    } ]
  }, {
    "tStartMs": 1297150,
    "dDurationMs": 5610,
    "segs": [ {
      "utf8": "تاتي الاية فتغسل القلب وتمسح على هذا القلب\nالالام والاحزان."
    } ]
  }, {
    "tStartMs": 1302760,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "بقول الله وانا لجاعلون ما عليها صعيدا جرزا."
    } ]
  }, {
    "tStartMs": 1306990,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "الدنيا بكل ما فيها."
    } ]
  }, {
    "tStartMs": 1309480,
    "dDurationMs": 9690,
    "segs": [ {
      "utf8": "مبانيها وما فيها واشخاصها واعيانها وحوادثها\nوالامها وافراحها واحزانها وافراحها"
    } ]
  }, {
    "tStartMs": 1319170,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "وصعودها ونزولها."
    } ]
  }, {
    "tStartMs": 1321120,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "صعيدا جرزا كانه لم يكن."
    } ]
  }, {
    "tStartMs": 1324180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "فلا عليك."
    } ]
  }, {
    "tStartMs": 1325380,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "لا عليك."
    } ]
  }, {
    "tStartMs": 1326580,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "لا تنشغل بالخطوب عما انت عليه."
    } ]
  }, {
    "tStartMs": 1330810,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "لا تشغلك الخطوب والفتن والمحن والمآسي\nوالالام والاحزان."
    } ]
  }, {
    "tStartMs": 1336150,
    "dDurationMs": 8950,
    "segs": [ {
      "utf8": "ان اعداد العدة لذلك اليوم العظيم الذي سيأتي\nلا محال عن اعداد العدة لاجل احسان العمل حين"
    } ]
  }, {
    "tStartMs": 1345100,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "تقدم عمل قدمه خالصا لوجه ربك قدم احسن العمل\nبين يدي الله اما الدنيا اما الفتن فلا تاخذ"
    } ]
  }, {
    "tStartMs": 1355090,
    "dDurationMs": 9960,
    "segs": [ {
      "utf8": "منك الوقت الكثير دع عنك ذلك ثم تاتي الايه ام\nحسبت ان اصحاب الكهف والرقيم كانوا من اياتنا"
    } ]
  }, {
    "tStartMs": 1365050,
    "dDurationMs": 9060,
    "segs": [ {
      "utf8": "عجبا. وقد وردت بعض الاحاديث وفي بعض التفاسير\nان النبي صلى الله عليه وسلم ساله قومه"
    } ]
  }, {
    "tStartMs": 1375430,
    "dDurationMs": 9660,
    "segs": [ {
      "utf8": "بعد ان ارسلوا الى يهود يريدون مساعده اليهود\nفي كيفيه احراج النبي صلى الله عليه وسلم في"
    } ]
  }, {
    "tStartMs": 1385090,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "بعض الاسئله التي لم يكن قطعا يعرف عنها اي\nشيء."
    } ]
  }, {
    "tStartMs": 1389410,
    "dDurationMs": 9330,
    "segs": [ {
      "utf8": "ومن هذه الاسئله فتيه قصه الفتيه القصه كما\nوردت في بعض التفاسير بانواع"
    } ]
  }, {
    "tStartMs": 1398740,
    "dDurationMs": 8470,
    "segs": [ {
      "utf8": "مختلفه من التفاصيل التي لم يذكرها القران\nالكريم وطالما ان القران لم يذكرها نتوقف عندها"
    } ]
  }, {
    "tStartMs": 1407630,
    "dDurationMs": 9420,
    "segs": [ {
      "utf8": "واذهب الى الى ابعاد القصه وما تريد ان تغرسه\nفي نفسي وفي قلبي من هم الفتيه كيف خرجوا في اي"
    } ]
  }, {
    "tStartMs": 1417050,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "زمان كم كان عددهم؟ القران لم يحفل بذلك كله."
    } ]
  }, {
    "tStartMs": 1422630,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "القران يريدني فقط ان اقف على معاني القصه."
    } ]
  }, {
    "tStartMs": 1427910,
    "dDurationMs": 9750,
    "segs": [ {
      "utf8": "ما هي هذه القصه قصه فتيه شباب شباب تعرضوا\nلاصعب محنه يمكن ان يتعرض لها انسان."
    } ]
  }, {
    "tStartMs": 1438230,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "محنه الدين. الفتنه في الدين."
    } ]
  }, {
    "tStartMs": 1441530,
    "dDurationMs": 9600,
    "segs": [ {
      "utf8": "هذه الفتنه في الدين التي تعرض لها مجموعه من\nالشباب انهم كما قالت الايات"
    } ]
  }, {
    "tStartMs": 1451670,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "بداوا بمواجهه الفتنه فتنه الدين المجتمع الذي\nكانوا يعيشون فيه."
    } ]
  }, {
    "tStartMs": 1458210,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "السلطان الذي كان يسيطر على ذلك المجتمع."
    } ]
  }, {
    "tStartMs": 1462520,
    "dDurationMs": 7500,
    "segs": [ {
      "utf8": "القوة كانت تريد ان تثني هؤلاء الفتية والشباب\nعن التمسك بدينهم."
    } ]
  }, {
    "tStartMs": 1470680,
    "dDurationMs": 9750,
    "segs": [ {
      "utf8": "ودعونا نربط الان بين ما تعرض له الفتية وما\nتعرض له النبي صلى الله عليه وسلم واصحابه في"
    } ]
  }, {
    "tStartMs": 1480430,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "ذلك الوقت."
    } ]
  }, {
    "tStartMs": 1483070,
    "dDurationMs": 8130,
    "segs": [ {
      "utf8": "اصحاب النبي عليه الصلاة والسلام واجهوا مكة\nقريش بعتادها بقوتها بالمجتمع الذي كانوا"
    } ]
  }, {
    "tStartMs": 1491200,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "يعيشون فيه بكل شيء."
    } ]
  }, {
    "tStartMs": 1493840,
    "dDurationMs": 9450,
    "segs": [ {
      "utf8": "والفتية هؤلاء الشباب تعرضوا لمحنة مختلفة في\nتلك الاثناء بنفس المسار مسار الدين"
    } ]
  }, {
    "tStartMs": 1503290,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "التوحيد من قوم اخرين ربما كانوا مع يهود ربما\nكانوا في ذلك الزمان."
    } ]
  }, {
    "tStartMs": 1510010,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "المهم الدعوة واحدة."
    } ]
  }, {
    "tStartMs": 1513130,
    "dDurationMs": 7240,
    "segs": [ {
      "utf8": "ودعونا نتوقف ونحن نصل ما بين تلك المحنة وتلك\nالفتنة في كل زمان ومكان."
    } ]
  }, {
    "tStartMs": 1520370,
    "dDurationMs": 8910,
    "segs": [ {
      "utf8": "قد يتعرض الانسان شابا كان او في اي مرحله\nعمريه لفتنه الدين فتنه المجتمع احيانا فتنه"
    } ]
  }, {
    "tStartMs": 1529280,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "الاسره انا ابتغيت وجه الله عز وجل انا قررت\nان اغير مساري انا قررت فقلت ربنا"
    } ]
  }, {
    "tStartMs": 1539120,
    "dDurationMs": 9240,
    "segs": [ {
      "utf8": "اتنا من لدنك رحمه وهيئ لنا من امرنا رشدا\nوقومي او مجتمعي او اسرتي او العالم من حولي"
    } ]
  }, {
    "tStartMs": 1548720,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "اراد ان يسلك طريقا اخر وانا قررت ان اسلك\nطريق التوحيد."
    } ]
  }, {
    "tStartMs": 1553940,
    "dDurationMs": 9630,
    "segs": [ {
      "utf8": "فتنه ام ليست بفتنه فتنه فتنه كبيره ابتلاء\nكبير لاني معنى ذلك حين اقرر واتخذ قرار"
    } ]
  }, {
    "tStartMs": 1563570,
    "dDurationMs": 9360,
    "segs": [ {
      "utf8": "تغيير المسار الذي انا فيه سأواجه تحديات كما\nواجهت تحديات هؤلاء الفتيه كما"
    } ]
  }, {
    "tStartMs": 1572930,
    "dDurationMs": 6350,
    "segs": [ {
      "utf8": "واجهها النبي صلى الله عليه وسلم واصحابه لن\nيتركوه قومه قطعا."
    } ]
  }, {
    "tStartMs": 1580210,
    "dDurationMs": 8520,
    "segs": [ {
      "utf8": "القوم من قريش قرروا مواجهه ذلك الدين بكل\nالوسائل والاساليب وهنا تاتي معنى التسليم"
    } ]
  }, {
    "tStartMs": 1589240,
    "dDurationMs": 9270,
    "segs": [ {
      "utf8": "للنبي صلى الله عليه وسلم ولاصحابه ولكل مؤمن\nيؤمن بالحق ويدافع عن الحق ويقرر ان يغير"
    } ]
  }, {
    "tStartMs": 1598510,
    "dDurationMs": 9600,
    "segs": [ {
      "utf8": "حياته. كثير منا خاصه في في الزمن الذي نعيش\nفيه ليس بالضروره القضيه تكون توحيد"
    } ]
  }, {
    "tStartMs": 1608140,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "شرك وكفر."
    } ]
  }, {
    "tStartMs": 1609550,
    "dDurationMs": 9630,
    "segs": [ {
      "utf8": "لا انا ممكن كما في زماننا الذي ابتلينا فيه\nانا ممكن اكون فقط قررت ان اعيش التوحيد لاننا"
    } ]
  }, {
    "tStartMs": 1619180,
    "dDurationMs": 7800,
    "segs": [ {
      "utf8": "اليوم كثير من المسلمين وكثير من العوائل كثير\nمن الاسر يوحدون الله عز وجل باللسان يقولون لا"
    } ]
  }, {
    "tStartMs": 1626980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "اله الا الله محمد رسول الله."
    } ]
  }, {
    "tStartMs": 1629170,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "ولكن كل جزئيات وتفاصيل حياتي ابعد ما تكون عن\nلا اله الا الله محمد رسول الله وهنا يواجه"
    } ]
  }, {
    "tStartMs": 1638890,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "الانسان المحنه الحقيقيه."
    } ]
  }, {
    "tStartMs": 1641860,
    "dDurationMs": 9090,
    "segs": [ {
      "utf8": "قررت ان اغير مساري عن اسرتي عن المجتمع عن\nالمؤسسه التي اعيش فيها ماذا افعل؟ سوره الكهف"
    } ]
  }, {
    "tStartMs": 1651100,
    "dDurationMs": 9390,
    "segs": [ {
      "utf8": "عرضت السبب الاخر او الوسيله الرابعه تقريبا\nالتاليه من وسائل"
    } ]
  }, {
    "tStartMs": 1660640,
    "dDurationMs": 9510,
    "segs": [ {
      "utf8": "مواجهه الفتن والصعوبات كيف؟ فقالوا ربنا اتنا\nمن لدنك رحمه وهيئ لنا من امرنا رشدا"
    } ]
  }, {
    "tStartMs": 1670510,
    "dDurationMs": 8910,
    "segs": [ {
      "utf8": "الدعاء الدعاء المتواصل لله سبحانه وتعالى طلب\nالمعونه منه المستمره"
    } ]
  }, {
    "tStartMs": 1680050,
    "dDurationMs": 9240,
    "segs": [ {
      "utf8": "طلب الهدايه ربنا اتنا من لدنك رحمه وهيئ لنا\nمن امرنا رشدا بدون الدعاء"
    } ]
  }, {
    "tStartMs": 1689740,
    "dDurationMs": 7630,
    "segs": [ {
      "utf8": "بدون الالتجاء المتواصل هذه الوسيله العظيمه\nلمواجهه الفتن الدعاء المتواصل لله سبحانه"
    } ]
  }, {
    "tStartMs": 1697370,
    "dDurationMs": 9780,
    "segs": [ {
      "utf8": "وتعالى بان يرحمني برحمته الواسعه ان يقيني من\nالفتن وتأملوا معي اختيار الكلمة رشدا."
    } ]
  }, {
    "tStartMs": 1707360,
    "dDurationMs": 8580,
    "segs": [ {
      "utf8": "الرشد. الرشد الذي يهدي الانسان الرشد الذي\nيقدم للانسان الهداية."
    } ]
  }, {
    "tStartMs": 1716450,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "حين تختلط الاوراق امام عيني."
    } ]
  }, {
    "tStartMs": 1719300,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "حين لا يدري اي سبيل او اي طريق يمكن ان\nيسلكه."
    } ]
  }, {
    "tStartMs": 1724250,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "هيئ لنا من امرنا رشدا."
    } ]
  }, {
    "tStartMs": 1727010,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "الاختيار الصائب."
    } ]
  }, {
    "tStartMs": 1729440,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "الاختيار الصح."
    } ]
  }, {
    "tStartMs": 1731120,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "حين تختلط الاوراق."
    } ]
  }, {
    "tStartMs": 1733100,
    "dDurationMs": 8670,
    "segs": [ {
      "utf8": "من الذي يهيئ الرشد؟ من الذي يهيئ للانسان\nالصلاح؟ من الذي يضيء الطريق امام الانسان حين"
    } ]
  }, {
    "tStartMs": 1741770,
    "dDurationMs": 9630,
    "segs": [ {
      "utf8": "تختلط الاوراق؟ من الذي يهيئ لهذا الانسان حين\nتختلط الاوراق وتتعدد الفتن؟ من الذي يهيئ له"
    } ]
  }, {
    "tStartMs": 1751400,
    "dDurationMs": 9730,
    "segs": [ {
      "utf8": "النور والصلاح والرحمة سوى الله سبحانه وتعالى\nفكان التوجه الى الله من اعظم وسائل لمواجهة"
    } ]
  }, {
    "tStartMs": 1761130,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "الفتن. الدعاء."
    } ]
  }, {
    "tStartMs": 1763950,
    "dDurationMs": 9660,
    "segs": [ {
      "utf8": "ثم ياتي لتأتي الإجابة الفتية هؤلاء المجموعة\nمن الشباب الذين كما يبدو في سوره الكهف تعرضوا"
    } ]
  }, {
    "tStartMs": 1773610,
    "dDurationMs": 9960,
    "segs": [ {
      "utf8": "لمحنة ان قومهم قد حادوا عن التوحيد ان قومهم\nقد ابتغوا الشرك واتخاذ الشرك مسارا"
    } ]
  }, {
    "tStartMs": 1783600,
    "dDurationMs": 8760,
    "segs": [ {
      "utf8": "بعيدا عن توحيد الله عز وجل وهم اتخذوا قرار\nالتوحيد مسلكا لحياتهم وواجهوا هذه الفتنه."
    } ]
  }, {
    "tStartMs": 1793050,
    "dDurationMs": 9870,
    "segs": [ {
      "utf8": "ربي عز وجل سبحانه وتعالى اعطاهم العلاج\nاعطاهم الهدايه وتأملوا قول الله عز وجل."
    } ]
  }, {
    "tStartMs": 1803490,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "نحن نقص عليك نباهم بالحق."
    } ]
  }, {
    "tStartMs": 1807360,
    "dDurationMs": 8520,
    "segs": [ {
      "utf8": "في اشاره واضحه للنبي صلى الله عليه وسلم\nولاتباع هذا الكتاب العظيم لا تذهب بعيدا وتخوض"
    } ]
  }, {
    "tStartMs": 1815880,
    "dDurationMs": 7350,
    "segs": [ {
      "utf8": "في الاسرائيليات وفي القصص المختلفه المنسوجه\nحول اصحاب الكهف من يهود ومن غيرهم."
    } ]
  }, {
    "tStartMs": 1823680,
    "dDurationMs": 9870,
    "segs": [ {
      "utf8": "نحن نقص عليك نباهم بالحق الحق في هذا الكتاب\nالعظيم ما قصتهم بعيدا عن كل الخزعبلات التي"
    } ]
  }, {
    "tStartMs": 1833550,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "يمكن ان تحاك حولهم."
    } ]
  }, {
    "tStartMs": 1836100,
    "dDurationMs": 9660,
    "segs": [ {
      "utf8": "فتيه امنوا بربهم في كلمتين امنوا بربهم حين\nيصبح الايمان القرار الذي اتخذه."
    } ]
  }, {
    "tStartMs": 1846390,
    "dDurationMs": 7950,
    "segs": [ {
      "utf8": "كيف تكون النتيجه حين يصبح الايمان والتوحيد\nالخالص هو القرار الذي اقرره."
    } ]
  }, {
    "tStartMs": 1854790,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "انظر الى النتيجه في نفس الايه وزدناهم هدى."
    } ]
  }, {
    "tStartMs": 1858930,
    "dDurationMs": 9780,
    "segs": [ {
      "utf8": "خلاص انتهت المساله طلبت الهدايه من الله\nسيهديك من طلب الهدايه من الله هداه ومن اوى"
    } ]
  }, {
    "tStartMs": 1868740,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "الى الله اواه آواه، ومن اعتصم به عصمه وقاه،\nومن توكل عليه كفاه، ومن أراد العزة والهداية"
    } ]
  }, {
    "tStartMs": 1878730,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "في غير طريق الله رب سبحانه وتعالى اضله\nوعماه."
    } ]
  }, {
    "tStartMs": 1885420,
    "dDurationMs": 9750,
    "segs": [ {
      "utf8": "تأملوا معي ثم الجزء الذي بعد ذلك وربطنا على\nقلوبهم لماذا؟ وكلمة ربطنا"
    } ]
  }, {
    "tStartMs": 1895590,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "لم تأتي في كتاب الله ربطنا على قلوبهم إلا في\nموضعين."
    } ]
  }, {
    "tStartMs": 1900600,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "الموضع الاول مع الفتية."
    } ]
  }, {
    "tStartMs": 1902490,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "الشباب. الشباب الحلو."
    } ]
  }, {
    "tStartMs": 1905010,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "الشباب الذي يقرر ويتخذ قرار الايمان."
    } ]
  }, {
    "tStartMs": 1908730,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "الشباب الذي يتخذ قرار تغيير المنكر والخطأ\nالى الصواب."
    } ]
  }, {
    "tStartMs": 1914010,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "الى الرشاد. الى النور."
    } ]
  }, {
    "tStartMs": 1916050,
    "dDurationMs": 9240,
    "segs": [ {
      "utf8": "الشباب الذي يتخذ قرار ان يصبح مصابيح ونور\nتضيء به ظلمات الدنيا والفتن والمحن."
    } ]
  }, {
    "tStartMs": 1925530,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "مهما تعددت وتنوعت."
    } ]
  }, {
    "tStartMs": 1927480,
    "dDurationMs": 7780,
    "segs": [ {
      "utf8": "وفي اي زمان كانت الجزاء الهدى والربط على\nالقلب ربطنا على قلوبهم."
    } ]
  }, {
    "tStartMs": 1935650,
    "dDurationMs": 9210,
    "segs": [ {
      "utf8": "وفي قضيه ام موسى موسى عليه السلام حين قال\nلولا ان ربطنا على قلبها الربط على القلب لا"
    } ]
  }, {
    "tStartMs": 1944860,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "ياتي الا من عند الله عز وجل."
    } ]
  }, {
    "tStartMs": 1946840,
    "dDurationMs": 9660,
    "segs": [ {
      "utf8": "تثبيت تثبيت يمسك القلب ويربطه على الحق وعلى\nالصواب حتى لا يطير"
    } ]
  }, {
    "tStartMs": 1956500,
    "dDurationMs": 9390,
    "segs": [ {
      "utf8": "هذا القلب من شده خوف او من شده حزن او من شده\nفرح او من شده انحراف نحو الفتن"
    } ]
  }, {
    "tStartMs": 1966370,
    "dDurationMs": 7560,
    "segs": [ {
      "utf8": "ولذا في بعض ايات القران قلوبهم هواء تصبح\nالقلوب تطير تطير مع الفتن."
    } ]
  }, {
    "tStartMs": 1974890,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "اما هؤلاء الذين يتخذون قرار التوحيد وقرار\nالايمان بربهم عز وجل باخلاص اخلاص لا"
    } ]
  }, {
    "tStartMs": 1984730,
    "dDurationMs": 9760,
    "segs": [ {
      "utf8": "يطلع عليه ولا يعلمه الا من خلق سبحانه تكون\nالنتيجه من جنس العمل ما هي النتيجه؟ الربط على"
    } ]
  }, {
    "tStartMs": 1994490,
    "dDurationMs": 9030,
    "segs": [ {
      "utf8": "القلب انتهت القضيه حسمت خرجوا من الفتنه\nبسلام وهكذا كل من يريد ان يخرج من فتنه الدين"
    } ]
  }, {
    "tStartMs": 2003940,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "كل من يريد ان يربط الله على قلبه."
    } ]
  }, {
    "tStartMs": 2008350,
    "dDurationMs": 8910,
    "segs": [ {
      "utf8": "الاجابه موجوده في سوره الكهف امنوا بربهم\nايمان حقيقي ايمان ليس الايمان الضعيف هو"
    } ]
  }, {
    "tStartMs": 2017530,
    "dDurationMs": 7740,
    "segs": [ {
      "utf8": "الايمان القوي ما معنى ايمان قوي ايمان قوي\nبمعنى اني مستعد ان اتنازل عن كل شيء لاجل الله"
    } ]
  }, {
    "tStartMs": 2025270,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "عز وجل. كل شيء بصدق وليس مجرد ادعاء."
    } ]
  }, {
    "tStartMs": 2029680,
    "dDurationMs": 8520,
    "segs": [ {
      "utf8": "جاء في بعض الاحاديث التي لا باس كذلك او بعض\nالاثار والتي رويت حول قضيه اصحاب الكهف ولا"
    } ]
  }, {
    "tStartMs": 2038200,
    "dDurationMs": 9340,
    "segs": [ {
      "utf8": "باس باسنادها ان هؤلاء الفتيه كانوا من اسر\nرفيعه المستوى المادي في قومهم يعني"
    } ]
  }, {
    "tStartMs": 2048170,
    "dDurationMs": 8970,
    "segs": [ {
      "utf8": "اسر لها مكانه في القوم اسر لها مكانة\nاجتماعية وسياسية ومادية ومعنوية وانهم تركوا"
    } ]
  }, {
    "tStartMs": 2057140,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "من ورائهم قصور."
    } ]
  }, {
    "tStartMs": 2059540,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "خرجوا من كل شيء لاي شيء."
    } ]
  }, {
    "tStartMs": 2062390,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "لكهف ابدا."
    } ]
  }, {
    "tStartMs": 2065030,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "اوى الفتيه الى الكهف وما هو الكهف."
    } ]
  }, {
    "tStartMs": 2068720,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "حفره منقوله طبيعيا بشكل طبيعي من عند الله عز\nوجل في جبل فقط."
    } ]
  }, {
    "tStartMs": 2075710,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "ترك القصر."
    } ]
  }, {
    "tStartMs": 2077570,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "ترك المال."
    } ]
  }, {
    "tStartMs": 2079100,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "ترك المكانه الاجتماعيه."
    } ]
  }, {
    "tStartMs": 2080930,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "ترك كل شيء وراء ظهره."
    } ]
  }, {
    "tStartMs": 2083120,
    "dDurationMs": 8190,
    "segs": [ {
      "utf8": "ادار ظهره ووجه وجهه للذي خلقه وفطر السماوات\nوالارض بالحق فوجد كل شيء عنده."
    } ]
  }, {
    "tStartMs": 2091790,
    "dDurationMs": 9630,
    "segs": [ {
      "utf8": "وتأملوا معي وانظروا الى المفارقه العجيبه حين\nتدير وجهك لله سبحانه وتعالى وحده لا شريك له."
    } ]
  }, {
    "tStartMs": 2101780,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "وتدير ظهرك للدنيا بأسرها."
    } ]
  }, {
    "tStartMs": 2105300,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "وتبتغي وجه الخالق سبحانه."
    } ]
  }, {
    "tStartMs": 2107880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "يعطيك الدنيا والاخرة."
    } ]
  }, {
    "tStartMs": 2111600,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "ولكن حين تدير ظهرك لربك سبحانه وتعالى."
    } ]
  }, {
    "tStartMs": 2116370,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "وتدير وجهك للدنيا سعيا لهذه الدنيا وملذاتها."
    } ]
  }, {
    "tStartMs": 2123090,
    "dDurationMs": 8040,
    "segs": [ {
      "utf8": "منصبا او جاها او كرسيا او او او مكانة او اي\nشيء من اشياء الدنيا الفانية."
    } ]
  }, {
    "tStartMs": 2131580,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "تكون النتيجة ان الدنيا تدير وجهها عنك."
    } ]
  }, {
    "tStartMs": 2135930,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "وفي ذات الوقت."
    } ]
  }, {
    "tStartMs": 2137400,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "وتلك هي الكارثة."
    } ]
  }, {
    "tStartMs": 2139440,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "ان الله سبحانه وتعالى يدير وجهه الكريم عنك\nغضبا وسخطا."
    } ]
  }, {
    "tStartMs": 2145830,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "وتلك اكبر خسارة في الدنيا."
    } ]
  }, {
    "tStartMs": 2148440,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "فما قيمة ان تأتي كل الدنيا اليك تحت قدميك."
    } ]
  }, {
    "tStartMs": 2152640,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "ولكن رب سبحانه ساخط غاضب على هذا الانسان."
    } ]
  }, {
    "tStartMs": 2157230,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "حين يتخذ القرار الخطأ."
    } ]
  }, {
    "tStartMs": 2159990,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "عندما يتعرض لفتنة او لمحنه مهما كانت تلك\nالفتنه."
    } ]
  }, {
    "tStartMs": 2164750,
    "dDurationMs": 9300,
    "segs": [ {
      "utf8": "هذا القرار نفس القضيه كانت انظر الى بعد\nسنوات بعد قرون الى النبي صلى الله عليه وسلم"
    } ]
  }, {
    "tStartMs": 2174440,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "خرج في قومه وهو صاحب الحسب والنسب خرج على\nقومه على اسرته وادار ظهره للدنيا"
    } ]
  }, {
    "tStartMs": 2184160,
    "dDurationMs": 9210,
    "segs": [ {
      "utf8": "وما فيها ولذا قال قولته المشهوره لعمه ابي\nطالب حين قال والله يا عم لو وضعوا الشمس في"
    } ]
  }, {
    "tStartMs": 2193400,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "يميني والقمر في يساري على ان اترك هذا الامر\nما تركته او اهلك اهلك دونه."
    } ]
  }, {
    "tStartMs": 2200300,
    "dDurationMs": 8970,
    "segs": [ {
      "utf8": "هذا القرار هذه المحنه هذه فتنه الدين ولنا ان\nنتساءل نسال انفسنا ونحن نتدبر ونقرا سوره"
    } ]
  }, {
    "tStartMs": 2209270,
    "dDurationMs": 9810,
    "segs": [ {
      "utf8": "الكهف جمعه بعد جمعه كم انا مستعد ان اقدم من\nتنازلات لاجل ديني لاجل الدين الذي احمله لاجل"
    } ]
  }, {
    "tStartMs": 2219080,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "الايمان الذي احمله في قلبي."
    } ]
  }, {
    "tStartMs": 2221760,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "هل وصل ايماني الى درجة ايمان هؤلاء الفتية؟\nوانا انظر واقرأ."
    } ]
  }, {
    "tStartMs": 2228390,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "هل مستعد ان اضحي بكل شيء لاجل لا اله الا\nالله."
    } ]
  }, {
    "tStartMs": 2233910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "دين ايمان."
    } ]
  }, {
    "tStartMs": 2235680,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "بدون محاولة لتقديم تنازلات."
    } ]
  }, {
    "tStartMs": 2238800,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "مهما كان حجم هذه التنازلات."
    } ]
  }, {
    "tStartMs": 2241530,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "لا يمكن ان يسمى ايمان حقيقي."
    } ]
  }, {
    "tStartMs": 2244740,
    "dDurationMs": 8700,
    "segs": [ {
      "utf8": "الايمان الحقيقي الخالص الذي ينجيني في الدنيا\nمن الفتن وينزلني الفردوس الاعلى كما ستأتي"
    } ]
  }, {
    "tStartMs": 2253440,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "عليه الجزاء."
    } ]
  }, {
    "tStartMs": 2254670,
    "dDurationMs": 6030,
    "segs": [ {
      "utf8": "سيأتي في اخر سورة الكهف كانت لهم جنات\nالفردوس نزلا."
    } ]
  }, {
    "tStartMs": 2261180,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "لا يمكن أن يكون بدون ثمن."
    } ]
  }, {
    "tStartMs": 2263700,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "أنا حين أنزل بيت من بيوت الدنيا مهما كان\nادفع له ثمن."
    } ]
  }, {
    "tStartMs": 2268800,
    "dDurationMs": 8070,
    "segs": [ {
      "utf8": "ما هو الثمن الذي دفعته لاجل ان امتلك بيتا في\nالفردوس الاعلى؟ ما هو الثمن؟ الثمن لابد ان"
    } ]
  }, {
    "tStartMs": 2276900,
    "dDurationMs": 5810,
    "segs": [ {
      "utf8": "يكون تضحيات لا بد ان يكون مقابل هذه الفتن\nالتي اتعرض اليها."
    } ]
  }, {
    "tStartMs": 2283370,
    "dDurationMs": 9030,
    "segs": [ {
      "utf8": "تنتهي القصه بقولهم اذ قاموا فقالوا ربنا رب\nالسماوات والارض لن ندعو من دونه الها لقد قلنا"
    } ]
  }, {
    "tStartMs": 2292400,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "اذا شططا قضيه محسومه القوم والمجتمع من حولي\nارادوا قرارا اخر اتخذوا الها من دون الله"
    } ]
  }, {
    "tStartMs": 2302240,
    "dDurationMs": 9480,
    "segs": [ {
      "utf8": "عز وجل اما نحن فالقضيه مختلفه اعظم محنه هي\nهذه طلبوا اي شيء طلبوا التوحيد طلبوا"
    } ]
  }, {
    "tStartMs": 2311720,
    "dDurationMs": 9120,
    "segs": [ {
      "utf8": "القرار الصح وقضيه الاقامه فيها لفته عجيبه\nفيها نداء وخطاب للنبي صلى الله عليه وسلم ولكل"
    } ]
  }, {
    "tStartMs": 2320840,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "مؤمن بالحق قاموا."
    } ]
  }, {
    "tStartMs": 2323360,
    "dDurationMs": 6660,
    "segs": [ {
      "utf8": "الحق يحتاج الى قيام الحق يحتاج ان اقف على\nقدمي واجهر به."
    } ]
  }, {
    "tStartMs": 2330140,
    "dDurationMs": 8940,
    "segs": [ {
      "utf8": "طبعا بالحكمه والموعظه الحسنه ولكن يحتاج لقوه\nيحتاج الى قوه شديده قوه تحركني."
    } ]
  }, {
    "tStartMs": 2339410,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "قوه تبدا من القلب الذي امن بالحق الذي اؤمن\nبه."
    } ]
  }, {
    "tStartMs": 2343550,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "وتأملوا معي والقران كله عظيم وفيه وقفات\nعظيمه."
    } ]
  }, {
    "tStartMs": 2348260,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "هؤلاء قومنا اتخذوا من دونه الهه لولا ياتون\nعليهم بسلطان بين."
    } ]
  }, {
    "tStartMs": 2355430,
    "dDurationMs": 8460,
    "segs": [ {
      "utf8": "من اكثر اسباب الوقوع في الفتن يعني القوم\nالذين كذبوا والمجتمع الذي كان حول هؤلاء"
    } ]
  }, {
    "tStartMs": 2363890,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "الفتيه وقعوا في ابتلاء ولكن الفارق بينهم\nوبين الفتيه ان الفتيه نجحوا في الامتحان وان"
    } ]
  }, {
    "tStartMs": 2372290,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "القوم من حولهم رسبوا في ذلك الامتحان وذلك هو\nالخسران المبين."
    } ]
  }, {
    "tStartMs": 2378680,
    "dDurationMs": 9930,
    "segs": [ {
      "utf8": "من اكثر اسباب الرسوب والوقوع في ظلمات الفتن\nعدم وجود الدليل ليس لديهم دليل لولا ياتون"
    } ]
  }, {
    "tStartMs": 2388610,
    "dDurationMs": 9560,
    "segs": [ {
      "utf8": "عليهم بسلطان بين فمن اظلم ممن افترى على الله\nكذبا لماذا الافتراء؟ لماذا اسير وراء الفتنه"
    } ]
  }, {
    "tStartMs": 2398170,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "وانا اعلم ان هذه المحنه او هذه الفتنه تفتقر\nالى الدليل."
    } ]
  }, {
    "tStartMs": 2406030,
    "dDurationMs": 8610,
    "segs": [ {
      "utf8": "تتوالى الايات في قضية الفتنة التي تعرض لها\nهؤلاء الفتية واذا اعتزلتموهم وما يعبدون الا"
    } ]
  }, {
    "tStartMs": 2414640,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "الله فاووا الى الكهف ينشر لكم ربكم من رحمته."
    } ]
  }, {
    "tStartMs": 2418690,
    "dDurationMs": 8220,
    "segs": [ {
      "utf8": "وهنا الوقفة التي تبين معنى اسم سورة الكهف\nالتي سماها النبي صلى الله عليه وسلم في"
    } ]
  }, {
    "tStartMs": 2426910,
    "dDurationMs": 5010,
    "segs": [ {
      "utf8": "الاحاديث التي ذكرنا من قرا عشر ايات من اول\nسوره الكهف."
    } ]
  }, {
    "tStartMs": 2432370,
    "dDurationMs": 7140,
    "segs": [ {
      "utf8": "سميت الكهف سورة الكهف فيها قصص اخرى غير قضية\nالكهف لم سميت بالكهف."
    } ]
  }, {
    "tStartMs": 2439540,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "المحور الاساس الكهف فيه معنى الاحتماء\nوالاختباء."
    } ]
  }, {
    "tStartMs": 2445090,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "والايواء المعنى الحسي والمعنى المعاني\nالمعنوية."
    } ]
  }, {
    "tStartMs": 2451810,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "معاني الايواء جاءت في سورة الكهف."
    } ]
  }, {
    "tStartMs": 2454910,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "كذلك الربط واضح بين المعاني الحسية والمعاني\nالمعنوية."
    } ]
  }, {
    "tStartMs": 2460760,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "معاني الايواء والحماية والعصمة من الفتن."
    } ]
  }, {
    "tStartMs": 2464300,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "جاءت في هذه السورة العظيمة."
    } ]
  }, {
    "tStartMs": 2466550,
    "dDurationMs": 6870,
    "segs": [ {
      "utf8": "فاووا الى الكهف ينشر لكم ربكم من رحمته ويهيئ\nلكم من امركم مرفقا."
    } ]
  }, {
    "tStartMs": 2474350,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "وهنا وقفة عظيمة لكل مؤمن ولكل انسان تمر عليه\nبعض الفتن او بعض المحن."
    } ]
  }, {
    "tStartMs": 2482330,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "عليك ان تحسن الظن بالله عز وجل."
    } ]
  }, {
    "tStartMs": 2485780,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "عليك باليقين."
    } ]
  }, {
    "tStartMs": 2487100,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "انظر الى هؤلاء الفتية واذا اعتزلتموهم وما\nيعبدون الا الله فاووا الى الكهف ينشر لكم ربكم"
    } ]
  }, {
    "tStartMs": 2496820,
    "dDurationMs": 6900,
    "segs": [ {
      "utf8": "من رحمته. انظر الى الحديث الذي كان يدور بين\nهؤلاء الفتية على حداثة سنهم."
    } ]
  }, {
    "tStartMs": 2504290,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "هؤلاء الفتية ما كان فيهم احد من المثبطين."
    } ]
  }, {
    "tStartMs": 2508670,
    "dDurationMs": 9850,
    "segs": [ {
      "utf8": "ما كان فيهم احد ممن قلبه تحركه بركه المخاوف؟\nوماذا لو حدث ذلك؟ وماذا لو قام كذلك؟ وماذا لو"
    } ]
  }, {
    "tStartMs": 2518520,
    "dDurationMs": 8430,
    "segs": [ {
      "utf8": "قتلونا؟ وماذا لو سلبوا؟ ابدا ينشر لكم ربكم\nمن رحمته ويهيئ لكم من امركم مرفقا."
    } ]
  }, {
    "tStartMs": 2526980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "يقين. يقين."
    } ]
  }, {
    "tStartMs": 2529080,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "باني طالما خرجت لله عز وجل."
    } ]
  }, {
    "tStartMs": 2532620,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "لن يضيعني الله سبحانه وتعالى."
    } ]
  }, {
    "tStartMs": 2535290,
    "dDurationMs": 9510,
    "segs": [ {
      "utf8": "وتدبروا معي واستذكروا قول السيدة خديجة حين\nجاءها النبي صلى الله عليه وسلم مضطربا خائفا"
    } ]
  }, {
    "tStartMs": 2544800,
    "dDurationMs": 6150,
    "segs": [ {
      "utf8": "بعد غار حراء ماذا قالت له؟ قالت والله لن\nيخزيك الله ابدا."
    } ]
  }, {
    "tStartMs": 2551400,
    "dDurationMs": 9450,
    "segs": [ {
      "utf8": "انظر الى حسن اليقين حسن الظن بالله عز وجل لن\nيخزيك الله انت تصل الرحم وتفعل الخير وتأمر"
    } ]
  }, {
    "tStartMs": 2560850,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "بالمعروف لن يخزيك الله هذا حسن الظن."
    } ]
  }, {
    "tStartMs": 2565050,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "هذه الجرعة القوية من حسن الظن بالله عز وجل."
    } ]
  }, {
    "tStartMs": 2569760,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "نحتاج اليها اليوم."
    } ]
  }, {
    "tStartMs": 2571550,
    "dDurationMs": 7230,
    "segs": [ {
      "utf8": "يحتاج اليها كل مؤمن يمر بفتنه ومحنه وابتلاء\nواختبار ان يحسن الظن بالله."
    } ]
  }, {
    "tStartMs": 2578990,
    "dDurationMs": 9150,
    "segs": [ {
      "utf8": "لا يضيعك الله عز وجل طالما انت تحسن الظن\nبخالقك فالله عز وجل عند حسن ظن عبده به."
    } ]
  }, {
    "tStartMs": 2588470,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "احسن الظن بالله."
    } ]
  }, {
    "tStartMs": 2590570,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "اصحاب الحق."
    } ]
  }, {
    "tStartMs": 2591950,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "الضعفاء. البسطاء."
    } ]
  }, {
    "tStartMs": 2594470,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "حين يروا الناس وقد اجتمعوا عليهم قتلا\nوحصارا."
    } ]
  }, {
    "tStartMs": 2599330,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "وتجويعا وارهابا وتخويفا."
    } ]
  }, {
    "tStartMs": 2603020,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "احسن الظن بالله."
    } ]
  }, {
    "tStartMs": 2604820,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "احسن الظن بالله."
    } ]
  }, {
    "tStartMs": 2606470,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "قل في نفسك وفي قلبك ولكل من حولك."
    } ]
  }, {
    "tStartMs": 2609920,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "مهما قل عددهم."
    } ]
  }, {
    "tStartMs": 2611630,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "قل لهم. الله لن يضيعنا طالما نحن على الحق."
    } ]
  }, {
    "tStartMs": 2615560,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "والله لن يخذلنا الله عزوجل."
    } ]
  }, {
    "tStartMs": 2618020,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "وان تكالبت علينا قوى الارض."
    } ]
  }, {
    "tStartMs": 2620630,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "قوى الغرب او قوى الشرق."
    } ]
  }, {
    "tStartMs": 2622490,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "لن يخزينا الله طالما اننا على الحق."
    } ]
  }, {
    "tStartMs": 2625940,
    "dDurationMs": 9150,
    "segs": [ {
      "utf8": "قلها بثبات في قلبك واجهر بها بصوتك ومشاعرك\nواحاسيسك ان العالم كله لو اجتمع ضدك وانت على"
    } ]
  }, {
    "tStartMs": 2635090,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "الحق لن يخزيك الخالق الواحد الاحد سبحانه."
    } ]
  }, {
    "tStartMs": 2639290,
    "dDurationMs": 8910,
    "segs": [ {
      "utf8": "هكذا قالوا الفتيه حين اتوا الى هذا الكهف في\nبعد وفي عزله ينشر لكم من رحمته ويهيئ لكم من"
    } ]
  }, {
    "tStartMs": 2648200,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "امركم مرفقا وكان ربي سبحانه ويكون عند حسن ظن\nهؤلاء به."
    } ]
  }, {
    "tStartMs": 2654530,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "وانظر الى الايه التي تليها."
    } ]
  }, {
    "tStartMs": 2656810,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "وترى الشمس اذا طلعت تزاور عن كهفهم ذات\nاليمين."
    } ]
  }, {
    "tStartMs": 2661460,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "سخر لهم الاسباب واحدث لهم معجزه وخارق كونيه\nوحماهم من كل سوء."
    } ]
  }, {
    "tStartMs": 2669860,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "لماذا احسنوا الظن بالله سبحانه."
    } ]
  }, {
    "tStartMs": 2673520,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "قدموا التضحيه."
    } ]
  }, {
    "tStartMs": 2675800,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "قدموا الايمان."
    } ]
  }, {
    "tStartMs": 2677540,
    "dDurationMs": 7890,
    "segs": [ {
      "utf8": "اياك ان يخطر ويدور بخلدك في يوم من الايام\nانك تؤمن بالله وتدافع عن كلمه الحق الذي امنت"
    } ]
  }, {
    "tStartMs": 2685430,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "به وتدافع عن رساله الحق."
    } ]
  }, {
    "tStartMs": 2687770,
    "dDurationMs": 9700,
    "segs": [ {
      "utf8": "ثم ان الله يخزيك او يسلمك لاعداءك لا يمكن\nمستحيل جل سبحانه وتعالى ان يفعل ذلك مع"
    } ]
  }, {
    "tStartMs": 2697470,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "عباده عباده المؤمنين المخلصين ابدا انما هو\nصبر ساعه وابتلاء ومحنه ساعات ثم ياتي النصر"
    } ]
  }, {
    "tStartMs": 2707460,
    "dDurationMs": 9780,
    "segs": [ {
      "utf8": "النصر الموعود الذي وعد الله سبحانه به من امن\nبه ومن لجا اليه ولذا جاءت الايه في ختامها"
    } ]
  }, {
    "tStartMs": 2717480,
    "dDurationMs": 8670,
    "segs": [ {
      "utf8": "من يهدي الله من طلب الهدايه من الله سبحانه\nوتعالى لا يمكن ان تجد له مضلا وفي المقابل ومن"
    } ]
  }, {
    "tStartMs": 2726150,
    "dDurationMs": 5970,
    "segs": [ {
      "utf8": "يضلل فلن تجد له وليا مرشدا لا من شرق ولا من\nغرب."
    } ]
  }, {
    "tStartMs": 2732780,
    "dDurationMs": 9690,
    "segs": [ {
      "utf8": "ومن يرشدك حين يضيعك الله سبحانه وتعالى حين\nتنزل الظلمات على اعين البشر لانهم من"
    } ]
  }, {
    "tStartMs": 2742470,
    "dDurationMs": 9340,
    "segs": [ {
      "utf8": "جراء اعمالهم يعني سوره الكهف كما سنأتي عليها\nبعد قليل نجد ان الانسان حين يصم اذنيه عن الحق"
    } ]
  }, {
    "tStartMs": 2751990,
    "dDurationMs": 8310,
    "segs": [ {
      "utf8": "ويغلق عينيه عن الحق الذي يراه والنور الذي\nيراه امامه ماذا تكون النتيجه؟ لا يمكن الا ان"
    } ]
  }, {
    "tStartMs": 2760300,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "تنزل الظلمات على عينيه."
    } ]
  }, {
    "tStartMs": 2762340,
    "dDurationMs": 9600,
    "segs": [ {
      "utf8": "يرى الشمس امام عينيه ولكنه يغطيها فلا يكاد\nيراها لا نور ولا ضياء ولا بصيره ولا اي شيء"
    } ]
  }, {
    "tStartMs": 2771970,
    "dDurationMs": 5310,
    "segs": [ {
      "utf8": "اخر. ما الذي يضيء لك؟ ماذا تبقى لك؟ لن تجد\nله وليا مرشدا."
    } ]
  }, {
    "tStartMs": 2777880,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "تتوالى الايات بعد ذلك في قضيه اصحاب الكهف."
    } ]
  }, {
    "tStartMs": 2781870,
    "dDurationMs": 7200,
    "segs": [ {
      "utf8": "هذه الفتنه العظيمه فتنه الدين لتوضح كيف تكون\nالنتيجه بعد فتره من الزمن."
    } ]
  }, {
    "tStartMs": 2789100,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "اصبر على الحق الذي تؤمن به."
    } ]
  }, {
    "tStartMs": 2791740,
    "dDurationMs": 9270,
    "segs": [ {
      "utf8": "اصبر على الحق وستجد بعد ذلك كيف ان الله\nسبحانه وتعالى يفتح اسباب النجاه امام عينيك."
    } ]
  }, {
    "tStartMs": 2801370,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "وكذلك اثرنا عليهم بعد سنوات ما يزيد على\nالثلاثمائة سنة."
    } ]
  }, {
    "tStartMs": 2807480,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "ليعلموا أن وعد الله حق."
    } ]
  }, {
    "tStartMs": 2810900,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "علينا أن ندرك دائما أن وعد الله حق وان\nالساعه لا ريب فيها."
    } ]
  }, {
    "tStartMs": 2816660,
    "dDurationMs": 9390,
    "segs": [ {
      "utf8": "وان هؤلاء الاجيال المتعاقبه سواء من معك او\nمن بعدك من يكيدون لك ويأتون بالدسائس"
    } ]
  }, {
    "tStartMs": 2826050,
    "dDurationMs": 9870,
    "segs": [ {
      "utf8": "والمؤامرات ويضعون امامك الاحجار والعثرات في\nيوم من الايام سوف ينصاعون للحق الذي تؤمن به."
    } ]
  }, {
    "tStartMs": 2836190,
    "dDurationMs": 9060,
    "segs": [ {
      "utf8": "قد لا ترى ثمرة ذلك ولكن الاجيال التي تلحق\nسترى هذا الثمر وكذا النبي صلى الله عليه وسلم."
    } ]
  }, {
    "tStartMs": 2845730,
    "dDurationMs": 7710,
    "segs": [ {
      "utf8": "انظر معي وتدبر هؤلاء القوم من قريش الذين\nكذبوك وفعلوا ما فعلوا بك في مكة."
    } ]
  }, {
    "tStartMs": 2853830,
    "dDurationMs": 8220,
    "segs": [ {
      "utf8": "كيف كانوا عند فتح مكة بعد سنوات قليلة معدودة\nفي عمر الزمن وفي حساب الزمن وحساب التاريخ؟"
    } ]
  }, {
    "tStartMs": 2862260,
    "dDurationMs": 9370,
    "segs": [ {
      "utf8": "كيف كانوا؟ وكانوا كيف كانوا حين فتح الله لك\nأبواب مكة وأتيت ووقفت على رؤوسهم في تواضع"
    } ]
  }, {
    "tStartMs": 2871630,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "المؤمن المنتصر الذي يدرك بان النصر بيد الله\nليس بيد احد سواه."
    } ]
  }, {
    "tStartMs": 2883960,
    "dDurationMs": 8880,
    "segs": [ {
      "utf8": "كيف كان ذلك الموقف حين قالوا من حين سالهم\nالنبي صلى الله عليه وسلم ما تظنون اني فاعل"
    } ]
  }, {
    "tStartMs": 2892840,
    "dDurationMs": 9690,
    "segs": [ {
      "utf8": "بكم؟ قالوا اخ كريم وابن اخ كريم هذه المشاعر\nتاتي للنبي صلى الله عليه وسلم ولكل مؤمن وهو"
    } ]
  }, {
    "tStartMs": 2902530,
    "dDurationMs": 9480,
    "segs": [ {
      "utf8": "يقرا السوره في نهايتها حين يجد ان من هؤلاء\nوصل بهم حد التمجيد والاكبار لهؤلاء"
    } ]
  }, {
    "tStartMs": 2912010,
    "dDurationMs": 7890,
    "segs": [ {
      "utf8": "الفتيه بعد موتهم ووفاتهم وفاه طبيعيه ان\nيقيموا عليهم ضريحا ومسجدا يتعبدون ولبئس ما"
    } ]
  }, {
    "tStartMs": 2919900,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "ارادوا ان يقوموا به بعد وفاتهم."
    } ]
  }, {
    "tStartMs": 2923390,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "انظر الى الحق والى اهل الحق."
    } ]
  }, {
    "tStartMs": 2926120,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "في نهايه الامر لن يصح الا ذلك الحق."
    } ]
  }, {
    "tStartMs": 2931280,
    "dDurationMs": 9510,
    "segs": [ {
      "utf8": "ثم تاتي الايات بعد نهايه السوره انها نهايه\nالقصه في السوره ونهايه الفتنه الاولى والقصه"
    } ]
  }, {
    "tStartMs": 2940790,
    "dDurationMs": 8700,
    "segs": [ {
      "utf8": "الاولى فتنه الدين لتاتي على اول ما قد بدات\nبه في بيان واضح."
    } ]
  }, {
    "tStartMs": 2949580,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "ان اعظم وسيله للوقايه من اي فتن هو القران\nالعظيم."
    } ]
  }, {
    "tStartMs": 2955850,
    "dDurationMs": 9450,
    "segs": [ {
      "utf8": "واتل ما اوحي اليك من كتاب ربك لا مبدل\nلكلماته ولن تجد من دونه ملتحدا تريد من"
    } ]
  }, {
    "tStartMs": 2965300,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "يعصمك تريد من يحميك من دون هذا الكتاب\nالعظيم."
    } ]
  }, {
    "tStartMs": 2969860,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "لا يمكن حمايه من الفتن ومن الابتلاءات ومن\nالمحن."
    } ]
  }, {
    "tStartMs": 2975290,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "بدون القران لا يمكن ان تكون."
    } ]
  }, {
    "tStartMs": 2978860,
    "dDurationMs": 9310,
    "segs": [ {
      "utf8": "ولنا ان نقف هنا وقفة بسيطة ونحن في عالمنا\nالمعاصر الذي يموج بالفتن والاضطرابات والمحن."
    } ]
  }, {
    "tStartMs": 2988200,
    "dDurationMs": 5490,
    "segs": [ {
      "utf8": "كل يوم عشرات الاخبار تتناقل عن فتن متعددة."
    } ]
  }, {
    "tStartMs": 2994350,
    "dDurationMs": 8760,
    "segs": [ {
      "utf8": "من الذي يخرجنا من هذه الفتن؟ من الذي ينير\nلنا الطريق ونحن في ظلمات هذه الفتن القران."
    } ]
  }, {
    "tStartMs": 3003680,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "اياك ان تبتعد عن هذا القرآن."
    } ]
  }, {
    "tStartMs": 3006140,
    "dDurationMs": 9210,
    "segs": [ {
      "utf8": "واتل ما اوحي اليك من كتاب ربك الذي قد تكفل\nالله سبحانه وتعالى بحفظه فلا مبدل"
    } ]
  }, {
    "tStartMs": 3015350,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "لكلماته. ثم خطوة اخرى نحتاج اليها ونحن نمر\nفي الفتن."
    } ]
  }, {
    "tStartMs": 3022520,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "الرفقة الصالحة."
    } ]
  }, {
    "tStartMs": 3024230,
    "dDurationMs": 8190,
    "segs": [ {
      "utf8": "انظر لقول الله عز وجل واصبر نفسك مع الذين\nيدعون ربهم بالغداة والعشي يريدون وجهه."
    } ]
  }, {
    "tStartMs": 3032810,
    "dDurationMs": 9400,
    "segs": [ {
      "utf8": "الصبر وعدم الغفله عن ذكر الله عز وجل وايجاد\nرفقة صالحة كما كانت رفقة أصحاب الكهف ممكن ما"
    } ]
  }, {
    "tStartMs": 3042210,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "يزيد عددهم عن خمسة، ثلاثة، اربعة عشرة رفقة."
    } ]
  }, {
    "tStartMs": 3047730,
    "dDurationMs": 9540,
    "segs": [ {
      "utf8": "حتى لو هيأ الله لك صاحبا واحدا فقط صاحب صالح\nفقط يكفيك هذا من اعظم المكاسب في الدنيا وفي"
    } ]
  }, {
    "tStartMs": 3057270,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "الاخرة. ولذا جاء التنبيه للنبي صلى الله عليه\nوسلم وان كان قد ورد في نزولها ان قريش سألت"
    } ]
  }, {
    "tStartMs": 3065670,
    "dDurationMs": 8040,
    "segs": [ {
      "utf8": "النبي عليه الصلاة والسلام ان يستبعد صهيب\nوغير صهيب وبلال من المستضعفين والعبيد لكي"
    } ]
  }, {
    "tStartMs": 3073710,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "يجلسوا ويتفضل بالجلوس على مائدة القرآن."
    } ]
  }, {
    "tStartMs": 3077610,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "هيهات هيهات."
    } ]
  }, {
    "tStartMs": 3080400,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "وتأمل معي كيف القرآن يعالج هذه القضية."
    } ]
  }, {
    "tStartMs": 3084480,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "لا يمكن ان تجلس وتستحق التشريف."
    } ]
  }, {
    "tStartMs": 3088140,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "لان هذا تشريف ان تجلس على مائدة القرآن وذكر\nالله عز وجل."
    } ]
  }, {
    "tStartMs": 3093480,
    "dDurationMs": 9500,
    "segs": [ {
      "utf8": "هذا تشريف. اذا تريد هذا التشريف عليك ان تسقط\nمن نفسك اي نوع من انواع التعالي او التكبر على"
    } ]
  }, {
    "tStartMs": 3102980,
    "dDurationMs": 9300,
    "segs": [ {
      "utf8": "الاخرين حتى ولو كان ذرة من تكبر؟ لا يمكن ان\nيكون مجلس القرآن تحتاج ان ان تصحح."
    } ]
  }, {
    "tStartMs": 3112490,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "تحتاج ان تجعل القلب في مأمن من التكبر\nوالتعالي على الاخرين."
    } ]
  }, {
    "tStartMs": 3118400,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "لا تطع. ولذلك قال."
    } ]
  }, {
    "tStartMs": 3120020,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "ولا تعد عيناك عنهم تريد زينة الحياة الدنيا."
    } ]
  }, {
    "tStartMs": 3123830,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "ولا تطع من اغفلنا قلبه عن ذكرنا واتبع هواه."
    } ]
  }, {
    "tStartMs": 3128900,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "وكان أمره فرطا."
    } ]
  }, {
    "tStartMs": 3131030,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "لا تنظر الى هؤلاء."
    } ]
  }, {
    "tStartMs": 3132860,
    "dDurationMs": 7140,
    "segs": [ {
      "utf8": "قد اجد انسان قد اوتي من الجاه والمال والمكانة\nالاجتماعية المرموقة ما أوتي."
    } ]
  }, {
    "tStartMs": 3140390,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "ولكن ما قيمة حين يكون امره فرطا خلاص ضائع\nمنتهي."
    } ]
  }, {
    "tStartMs": 3147710,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "من الذي نهاه الاعتقاد الذي في قلبه."
    } ]
  }, {
    "tStartMs": 3151880,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "لا يوجد ايمان."
    } ]
  }, {
    "tStartMs": 3153410,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "لا توجد قيم."
    } ]
  }, {
    "tStartMs": 3154940,
    "dDurationMs": 8680,
    "segs": [ {
      "utf8": "وحين تغيب قيم الايمان والتوحيد لا يصبح\nللانسان مكانه حتى وان علت مكانته الدنيويه او"
    } ]
  }, {
    "tStartMs": 3163620,
    "dDurationMs": 7920,
    "segs": [ {
      "utf8": "الاجتماعيه. سوره الكهف تعيد الامور الى\nنصابها، تعيد الامور الى الحساب العظيم الذي"
    } ]
  }, {
    "tStartMs": 3171540,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "ينبغي ان نتوقف عنده."
    } ]
  }, {
    "tStartMs": 3174060,
    "dDurationMs": 7890,
    "segs": [ {
      "utf8": "الامور التي احيانا ناخذها هكذا على علاتها\nدون ان ندرك حقائق الامور دون ان نقرا ما بين"
    } ]
  }, {
    "tStartMs": 3181950,
    "dDurationMs": 8100,
    "segs": [ {
      "utf8": "السطور. ولذا جاءت الايه واصبر نفسك مع الذين\nيدعون ربهم بالغداه والعشي."
    } ]
  }, {
    "tStartMs": 3190200,
    "dDurationMs": 9960,
    "segs": [ {
      "utf8": "ودعونا نضع عشرات الخطوط تحت قوله يريدون وجهه\nالاخلاص قد يكون ضعفاء قد يكون"
    } ]
  }, {
    "tStartMs": 3200160,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "عبيد مو مهم."
    } ]
  }, {
    "tStartMs": 3202350,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "المهم انهم يريدون وجه الله عز وجل."
    } ]
  }, {
    "tStartMs": 3206250,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "ولا تطع من اغفلنا قلبه عن ذكرنا."
    } ]
  }, {
    "tStartMs": 3209490,
    "dDurationMs": 6740,
    "segs": [ {
      "utf8": "من اعظم اسباب الوقوع في الفتن الغفله عن ذكر\nالله عز وجل الغفله عن ذكر الله."
    } ]
  }, {
    "tStartMs": 3216470,
    "dDurationMs": 9510,
    "segs": [ {
      "utf8": "وهو سبحانه لا يغفل عن كيف نغفل عن الله عز\nوجل ليس فقط باللسان القلب القلب حين ينشغل"
    } ]
  }, {
    "tStartMs": 3226220,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "بمن سوى الله عز وجل عنه سبحانه ولماذا جاءت\nأغفلنا قلبه؟ لماذا يغفل الله عز وجل قلب انسان"
    } ]
  }, {
    "tStartMs": 3235550,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "لان هو بالبدايه غفل عن ذكر الله من غفل عن\nذكره سبحانه اغفل الله قلبه عن ذكره"
    } ]
  }, {
    "tStartMs": 3245300,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "ومن اعرض عن الله سبحانه وتعالى اعرض عنه وجعل\nله معيشه ضنكا ومن صد بوجهه وبقلبه"
    } ]
  }, {
    "tStartMs": 3255290,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "عنه سبحانه اعرض ربي وصد عنه صدودا."
    } ]
  }, {
    "tStartMs": 3259700,
    "dDurationMs": 8970,
    "segs": [ {
      "utf8": "ويا لها من خساره عظيمه ولذا جاءت الايه وقل\nالحق من ربكم فمن شاء فليؤمن ومن شاء فليكفر."
    } ]
  }, {
    "tStartMs": 3268670,
    "dDurationMs": 9900,
    "segs": [ {
      "utf8": "الحق واضح تماما والقرار بيدك انت ايها\nالانسان ثم تستحضر"
    } ]
  }, {
    "tStartMs": 3278570,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "الايه وتضع امام اعيننا ونحن نرى الفتن\nوالامتحانات والابتلاءات تترى في واقعنا وفي"
    } ]
  }, {
    "tStartMs": 3286040,
    "dDurationMs": 8550,
    "segs": [ {
      "utf8": "كما كان في واقع النبي صلى الله عليه وسلم وفي\nكل واقع انا اعتدنا للظالمين نارا احاط بهم"
    } ]
  }, {
    "tStartMs": 3294590,
    "dDurationMs": 9660,
    "segs": [ {
      "utf8": "سرادقها الدنيا ساعه انظر معي وتدبر كيف\nالقران يوضح لي ان الدنيا انتهت خلاص مهما"
    } ]
  }, {
    "tStartMs": 3304250,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "طالت سنه كم سنه عشره عشرين ثلاثين اربعين\nستنتهي."
    } ]
  }, {
    "tStartMs": 3311120,
    "dDurationMs": 9090,
    "segs": [ {
      "utf8": "انا اعتدنا للظالمين نارا احاط بهم سرادقها\nالقرار امامك انت ان ظلمت نفسك واتخذت القرار"
    } ]
  }, {
    "tStartMs": 3320210,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "الخطا والبعد عن الله عز وجل وعدم الايمان به."
    } ]
  }, {
    "tStartMs": 3324830,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "خلاص انتهت المساله محسومه."
    } ]
  }, {
    "tStartMs": 3327350,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "وان يستغيثوا يغاثوا بماء كالمهل."
    } ]
  }, {
    "tStartMs": 3330670,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "الاخيره الجزاء احتاج ان اضع الامور نصب عيني."
    } ]
  }, {
    "tStartMs": 3336880,
    "dDurationMs": 9210,
    "segs": [ {
      "utf8": "اي قرار تريد ان تتخذه في حياتك لا تنظر فقط\nالى اول القرار ولا الى الامور المحيطه به من"
    } ]
  }, {
    "tStartMs": 3346090,
    "dDurationMs": 9600,
    "segs": [ {
      "utf8": "متاعب. لا انظر الى نتيجه القرار وهذا ما فعله\nالفتيه في الكهف لم ينظروا الى بعد الاهل"
    } ]
  }, {
    "tStartMs": 3355690,
    "dDurationMs": 9180,
    "segs": [ {
      "utf8": "والاحباب لم ينظروا الى الخساره التي ضحوا بها\nابدا الماديه المحدودة نظروا الى الجزاء البعيد"
    } ]
  }, {
    "tStartMs": 3365200,
    "dDurationMs": 9510,
    "segs": [ {
      "utf8": "الاخره. ولذلك سورة الكهف نزلت على النبي صلى\nالله عليه وسلم وهي تعده وتعد اصحابه لقضية"
    } ]
  }, {
    "tStartMs": 3374710,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "الهجرة الى الحبشة."
    } ]
  }, {
    "tStartMs": 3375850,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "الهجرة الثانية الى الحبشة."
    } ]
  }, {
    "tStartMs": 3378040,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "كانوا يريدون ترك كل شيء."
    } ]
  }, {
    "tStartMs": 3380770,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "الاوطان والاهل والمال."
    } ]
  }, {
    "tStartMs": 3383890,
    "dDurationMs": 7410,
    "segs": [ {
      "utf8": "انا لا استطيع ان اترك شيئا الا اذا كنت انظر\nالى ما سيأتي من بعد من نتائج."
    } ]
  }, {
    "tStartMs": 3391600,
    "dDurationMs": 8100,
    "segs": [ {
      "utf8": "انا لا أستطيع أن أترك أمرا إلا وأنا موعود\nبشيء اعظم منه وهذا وعد من الله عز وجل ان"
    } ]
  }, {
    "tStartMs": 3399700,
    "dDurationMs": 5670,
    "segs": [ {
      "utf8": "الذين امنوا وعملوا الصالحات انا لا نضيع اجر\nمن احسن عملا."
    } ]
  }, {
    "tStartMs": 3405640,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "ثق بالله احسن الظن بالله."
    } ]
  }, {
    "tStartMs": 3408580,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "ان تركت وطن فان الله سبحانه سيبدلك خيرا منه."
    } ]
  }, {
    "tStartMs": 3413470,
    "dDurationMs": 9570,
    "segs": [ {
      "utf8": "وهكذا كان ترك النبي صلى الله عليه وسلم وترك\nاصحابه مكة الوطن والاولاد والمال"
    } ]
  }, {
    "tStartMs": 3423040,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "وابدلهم الله مكانا خيرا من ذلك المكان."
    } ]
  }, {
    "tStartMs": 3427120,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "وعاد لهم الوطن وعادت معه اوطان الى يوم\nالقيامة."
    } ]
  }, {
    "tStartMs": 3432160,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "فتحت مكة وعادوا الى مكة ولكن عادوا منتصرين."
    } ]
  }, {
    "tStartMs": 3437440,
    "dDurationMs": 5910,
    "segs": [ {
      "utf8": "عادوا بالحق الذي حملوه في صدورهم وفي قلوبهم\nالى يوم القيامة."
    } ]
  }, {
    "tStartMs": 3443710,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "لماذا؟ لان الله لا يضيع اجر من احسن عملا."
    } ]
  }, {
    "tStartMs": 3447630,
    "dDurationMs": 9360,
    "segs": [ {
      "utf8": "واربط معها بداية السورة لنبلوهم أيهم أحسن\nعملا واربط مع الجزاء إنا لا نضيع اجر من احسن"
    } ]
  }, {
    "tStartMs": 3457020,
    "dDurationMs": 9570,
    "segs": [ {
      "utf8": "عملا اولئك لهم جنات عدن الجزاء سريع الدنيا\nمنتهية لهم جنات عدن تجري من تحتهم"
    } ]
  }, {
    "tStartMs": 3466590,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "الانهار يحلون فيها من اساور من ذهب ويلبسون\nثيابا خضرا من سندس واستبرق."
    } ]
  }, {
    "tStartMs": 3474720,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "هكذا الايمان."
    } ]
  }, {
    "tStartMs": 3476160,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "مصعب بن عمير الذي خرج من مكة ولم يعد معه ترك\nكل شيء وراء ظهره."
    } ]
  }, {
    "tStartMs": 3482160,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "ترك الام. ترك الاهل."
    } ]
  }, {
    "tStartMs": 3484440,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "ترك المال."
    } ]
  }, {
    "tStartMs": 3485490,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "ترك النعيم. ترك المكانة الاجتماعية المرموقة."
    } ]
  }, {
    "tStartMs": 3489600,
    "dDurationMs": 6300,
    "segs": [ {
      "utf8": "استشهد ولم يجدوا ما يكفنه به رضي الله عنه\nوارضاه سوى ورق الشجر."
    } ]
  }, {
    "tStartMs": 3496410,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "ان وضعوه على جانب من قدميه انكشف وجهه وان\nوضعوه على وجهه انكشف قدميه."
    } ]
  }, {
    "tStartMs": 3504720,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "ما الذي حدث؟ ما هي التضحية العظيمة؟ لا يهم."
    } ]
  }, {
    "tStartMs": 3509350,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "يلبسون ثيابا خضرا من سندس واستبرق متكئين\nفيها على الارائك."
    } ]
  }, {
    "tStartMs": 3515770,
    "dDurationMs": 5310,
    "segs": [ {
      "utf8": "كان مصعب وغير مصعب من اصحاب النبي صلى الله\nعليه وسلم."
    } ]
  }, {
    "tStartMs": 3521080,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "ومن اصحاب الحق الذين لا يخرجهم الى الحق."
    } ]
  }, {
    "tStartMs": 3525400,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "يرون الاخرة امام اعينهم رؤيا العين."
    } ]
  }, {
    "tStartMs": 3528880,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "يقين حسن ظن بالله عز وجل."
    } ]
  }, {
    "tStartMs": 3532150,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "الدنيا ستنتهي ولكن الاخرة ينظرون الى النعيم\nالى الجنة."
    } ]
  }, {
    "tStartMs": 3537670,
    "dDurationMs": 7950,
    "segs": [ {
      "utf8": "ولذا كان النبي صلى الله عليه وسلم دائما يذكر\nاصحابه بذلك النعيم العظيم الذي ينتظرهم في"
    } ]
  }, {
    "tStartMs": 3545620,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "الجنة حتى تصبح الاخرة وكأنها حاضرة امام\nعيني."
    } ]
  }, {
    "tStartMs": 3551710,
    "dDurationMs": 9270,
    "segs": [ {
      "utf8": "فتسهل التضحيات وترخص الاثمان ويرخص المهر\nالحقيقي لتلك الجنة التي عرضها عرض"
    } ]
  }, {
    "tStartMs": 3560980,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "السموات والارض."
    } ]
  } ]
}
