{"model": "mlx-community/whisper-large-v3-turbo", "segments": [{"start": 0.0, "end": 10.0, "text": " منصة زادي للتعلم الشرعي المفتوح تقدم"}, {"start": 11.22, "end": 19.66, "text": " بسم الله الرحمن الرحيم وحياكم الله أيها الأخوة والأخوات"}, {"start": 19.66, "end": 23.1, "text": " ما زلنا معكم في مهارات تدارس القرآن"}, {"start": 23.1, "end": 24.76, "text": " مهارات مجلس التدارس"}, {"start": 24.76, "end": 35.58, "text": " من أهم المهارات التي تحق المجلس تفاعلا ونجاحا وأثرا بإذن الله مهارة استخراج الهدايات"}, {"start": 35.58, "end": 41.22, "text": " كيف نستخرج الهدايات وكيف يتفاعل المجلس باستخراجها"}, {"start": 41.22, "end": 47.980000000000004, "text": " أننا بعد أن نطرح أسئلة كما ذكرنا في لقاء سابق طرح الأسئلة التدابورية"}, {"start": 47.980000000000004, "end": 51.8, "text": " نفتح المجال لاستخراج الهدايات"}, {"start": 51.8, "end": 58.4, "text": " نقول مثلا من عنده استخراج هداية يستخرجها من هذه الآية"}, {"start": 58.4, "end": 60.379999999999995, "text": " أو يستنبطها من هذه الآية"}, {"start": 60.379999999999995, "end": 66.08, "text": " ولكن أيضا لنعرف طريقة استخراج الهدايات"}, {"start": 66.08, "end": 74.82, "text": " أن الهدايات أنواع هدايات إيمانية عقدية فقهية أخلاقية تربوية اجتماعية"}, {"start": 74.82, "end": 83.78, "text": " لذلك أفتح أفاق الذهن المتلقي والمتدبر والمتدارس إلى مجالات الهدايات"}, {"start": 83.78, "end": 93.6, "text": " فنقول أعطونا مجالات الهدايات في عقدية أو فقهية أو اجتماعية أو تربوية أو خلقية أو نحو ذلك"}, {"start": 93.6, "end": 95.72, "text": " دعونا نطبق ذلك على آية"}, {"start": 95.72, "end": 100.78, "text": " في قول الله عز وجل مثلا الحمد لله رب العالمين"}, {"start": 100.78, "end": 106.74, "text": " نأخذ فيها هدايات عقادية"}, {"start": 106.74, "end": 110.72, "text": " منها إثبات الروبية الله عز وجل"}, {"start": 110.72, "end": 111.96000000000001, "text": " الخلق أجمعين"}, {"start": 111.96000000000001, "end": 115.52, "text": " حاجة العباد إلى ربهم رب العالمين"}, {"start": 115.52, "end": 117.5, "text": " فهو ربهم يحتاجون إليه"}, {"start": 117.5, "end": 119.68, "text": " إثبات أسم الجلالة"}, {"start": 119.68, "end": 121.54, "text": " أسمين من أسماء الله"}, {"start": 121.54, "end": 123.6, "text": " الله نفض الجلالة والرب"}, {"start": 123.6, "end": 129.1, "text": " إثبات أيضا ما يتعلق بكمال الله عز وجل"}, {"start": 129.1, "end": 129.9, "text": " الحمد لله"}, {"start": 129.9, "end": 133.02, "text": " كل هذه هدايات عقدية"}, {"start": 133.02, "end": 135.1, "text": " لو أتينا إلى مجال الفقه"}, {"start": 135.1, "end": 138.9, "text": " يعني هدايات عقدية فقهية مثل"}, {"start": 139.6, "end": 143.42000000000002, "text": " مشروعية افتتاح الكلام بالحمد"}, {"start": 143.42000000000002, "end": 146.9, "text": " كما افتتح الله كلامه بالحمد"}, {"start": 147.82, "end": 152.08, "text": " نعرف من خلال هدايات فقهية هنا"}, {"start": 152.08, "end": 156.02, "text": " أن نعرف أن أول آية من كتاب الله عز وجل"}, {"start": 156.02, "end": 158.6, "text": " هي الحمد لله رب العالمين بعد البسملة"}, {"start": 158.6, "end": 163.85999999999999, "text": " وهكذا لو أخذنا هداية تربوية"}, {"start": 163.85999999999999, "end": 167.16, "text": " من هداية التربوية في هذه الآية مثلا"}, {"start": 167.16, "end": 175.0, "text": " أننا نبتدئ بتأريف الناس بالرب عز وجل"}, {"start": 175.0, "end": 178.4, "text": " فإن الإنسان إذا عرف ربه أطاعه"}, {"start": 178.4, "end": 182.5, "text": " ولهذا قال الله تعالى الحمد لله رب العالمين الرحمن الرحيم"}, {"start": 182.5, "end": 184.56, "text": " ثم مالك يومدي ثم قال إياك نعبد"}, {"start": 184.56, "end": 189.38, "text": " فمن الأساليب التربية الناجحة أن تبتدأ بأصول العلم"}, {"start": 189.38, "end": 192.26, "text": " وأصول العلم هي التعريف بالله تعالى"}, {"start": 192.26, "end": 196.56, "text": " قبل أن تأمرهم بتشريعات تعلمنا الإيمان ثم تعلمنا القرآن"}, {"start": 196.56, "end": 204.24, "text": " إذن المرحلية والتدرج في التربية مهم جدا أن أخذه من هذه الآية"}, {"start": 204.24, "end": 210.16, "text": " وهكذا يعني مثلا نأخذ من الأخلاق مقام الحمد قيمة الحمد"}, {"start": 210.16, "end": 214.14000000000001, "text": " وأن مقام الحمد عظيم ينبغي أن يكون إنسان حامد لله عز وجل"}, {"start": 214.14, "end": 218.55999999999997, "text": " تأملوا أن يقوم أننا أخذنا هدايات متنوعة بحسب مجالات مختلفة"}, {"start": 218.55999999999997, "end": 222.04, "text": " هناك أيضا مما يتعلق باستخراج الهدايات"}, {"start": 222.04, "end": 227.88, "text": " مهم جدا أن الهداية يدل عليها السياق والمعنى"}, {"start": 227.88, "end": 230.16, "text": " لا نأتي بهداية خارج السياق"}, {"start": 230.16, "end": 232.04, "text": " وإنما في حدود السياق"}, {"start": 232.04, "end": 236.85999999999999, "text": " الثاني أن تطرح بصياغة تدبرية لها أثر إيماني وأملي"}, {"start": 236.85999999999999, "end": 239.56, "text": " ليست القضية فقط أن نستخرج فوائد"}, {"start": 239.56, "end": 241.6, "text": " الفرق بين الفائدة والهداية"}, {"start": 241.6, "end": 243.98, "text": " أن الفائدة فائدة حامة"}, {"start": 243.98, "end": 246.28, "text": " الهداية أن تستخرج"}, {"start": 246.28, "end": 248.2, "text": " موضع هداية يتدي النس بها"}, {"start": 248.2, "end": 249.6, "text": " يعني مثلا"}, {"start": 249.6, "end": 251.22, "text": " الحمد لله فيها"}, {"start": 251.22, "end": 254.23999999999998, "text": " فضيلة مقام الحمد ومن هنا"}, {"start": 254.23999999999998, "end": 255.35999999999999, "text": " يمرغي أن يكون"}, {"start": 255.35999999999999, "end": 258.42, "text": " الإنسان من أهل الحمد"}, {"start": 258.42, "end": 259.62, "text": " يحمد الله كثيرا"}, {"start": 259.62, "end": 261.96, "text": " لاحظوا ربط هنا الفائدة"}, {"start": 261.96, "end": 263.78, "text": " بالعمل هي الهداية"}, {"start": 263.78, "end": 265.58, "text": " حقيقة"}, {"start": 265.58, "end": 268.26, "text": " مجال خصب لاستخراج الهدايات"}, {"start": 268.26, "end": 269.53999999999996, "text": " من كتاب الله عز وجل"}, {"start": 269.53999999999996, "end": 272.12, "text": " بين المتدارسين إذا طرحت"}, {"start": 272.12, "end": 274.08, "text": " بهذا الأسلوب وبهذه الطريقة"}, {"start": 274.08, "end": 276.58, "text": " نسأل الله يفتحنا ولكم"}, {"start": 276.58, "end": 278.28000000000003, "text": " من فضله"}, {"start": 278.28000000000003, "end": 280.42, "text": " وتوفيقه وصلى الله وسلم"}, {"start": 280.42, "end": 281.18, "text": " على نبي محمد"}]}