{"model": "mlx-community/whisper-large-v3-turbo", "segments": [{"start": 0.0, "end": 10.0, "text": " منصة زادي للتعلم الشرعي المفتوح تقدم"}, {"start": 30.0, "end": 53.16, "text": " المباركة لنقف على بعد ذكر مقدمات مهمة في مفهوم التدبر والفرق بينه وبين مصطلحات الأخرى وأسس التدبر وشروط التدبر وأهداف وغيات التدبر نقف الآن على مستويات التدبر ومفاتيح كل مستوى"}, {"start": 53.16, "end": 57.94, "text": " يعني بمعنى أننا إذا أردنا الانطلاق بمستوى أول"}, {"start": 57.94, "end": 62.81999999999999, "text": " في المستوى الأول التدبر ثم ننتقل بعده للمستوى الثاني ثم الثالث"}, {"start": 62.81999999999999, "end": 68.56, "text": " هذا ما سنتحدث عنه إن شاء الله اتباعا في حلقات قادمة"}, {"start": 68.56, "end": 74.44, "text": " الآن سنتحدث عن المستوى الأول وهو التدبر الإيماني"}, {"start": 74.44, "end": 81.22, "text": " التدبر الإيماني الذي ينبغي أن يكون هو مستوى العامة"}, {"start": 81.22, "end": 82.58, "text": " مستوى الناس جميعا"}, {"start": 82.58, "end": 88.0, "text": " و المقصود به أن هذا التدبر يصلك إلى الإيمان"}, {"start": 88.0, "end": 91.62, "text": " إلى معايشة القرآن والإيمان به"}, {"start": 91.62, "end": 93.25999999999999, "text": " والعمل"}, {"start": 93.25999999999999, "end": 96.72, "text": " العمل مرتبط بالإيمان"}, {"start": 96.72, "end": 99.7, "text": " الذين آمنوا و عملوا الصالحات"}, {"start": 99.7, "end": 103.03999999999999, "text": " مفاتيح هذا المستوى ثلاثة"}, {"start": 103.03999999999999, "end": 105.44, "text": " مفاتيح هذا المستوى ثلاثة"}, {"start": 105.44, "end": 107.12, "text": " بشكل مبسط"}, {"start": 107.12, "end": 112.2, "text": " الأول هو معرفة مراد الله عز وجل في الآيات"}, {"start": 112.2, "end": 114.38000000000001, "text": " قل هو الله أحد"}, {"start": 114.38000000000001, "end": 115.52000000000001, "text": " ماذا يريد الله"}, {"start": 115.52000000000001, "end": 117.38, "text": " أن الله واحد"}, {"start": 117.38, "end": 119.24000000000001, "text": " واضح جدا"}, {"start": 119.24000000000001, "end": 120.78, "text": " إنا أعطيناك الكوثر"}, {"start": 120.78, "end": 121.38, "text": " ما المراد"}, {"start": 121.38, "end": 123.06, "text": " مراد الله عز وجل"}, {"start": 123.06, "end": 124.2, "text": " أن الله عز وجل"}, {"start": 124.2, "end": 126.12, "text": " أكرم نبيه"}, {"start": 126.12, "end": 128.14000000000001, "text": " وسلاه"}, {"start": 128.14000000000001, "end": 130.82, "text": " وعنى به بهذا العطاء الكثير"}, {"start": 130.82, "end": 132.78, "text": " مقصد هذه الآية"}, {"start": 132.78, "end": 134.54, "text": " ومقصودها وغرضها"}, {"start": 134.54, "end": 136.2, "text": " ومراد الله عز وجل منها واحد"}, {"start": 136.2, "end": 138.8, "text": " قل أعوذ برب الفلق"}, {"start": 138.8, "end": 140.34, "text": " مراد الله في هذه الآية"}, {"start": 140.34, "end": 141.54, "text": " أن نستعيد بالله"}, {"start": 141.54, "end": 144.48, "text": " أن الاستعاذ لا تكون إلا بالله"}, {"start": 144.48, "end": 145.54, "text": " هذا المراد"}, {"start": 145.54, "end": 148.54, "text": " هذا يعني الحقيقة الأولى"}, {"start": 149.56, "end": 152.2, "text": " التي يفهمها كل إنسان ذو فطرة سليمة"}, {"start": 152.2, "end": 155.23999999999998, "text": " وفهم و لسان عربي مع إيمان"}, {"start": 155.23999999999998, "end": 158.94, "text": " المفتاح الثاني بعد فهم المراد"}, {"start": 158.94, "end": 162.34, "text": " هو بيان الأثر الإيماني"}, {"start": 162.34, "end": 164.0, "text": " يعني هذا المراد"}, {"start": 164.0, "end": 166.34, "text": " بماذا يوصلك إلى الإيمان"}, {"start": 166.34, "end": 169.6, "text": " أن تستشعر ما في هذا المراد"}, {"start": 169.6, "end": 170.16, "text": " مثال"}, {"start": 170.16, "end": 175.16, "text": " قول هو الله أحد المراد أثبات وحدانية الله"}, {"start": 175.16, "end": 179.78, "text": " الأثر الإيماني أن أستشعر وحدانية الله عز وجل"}, {"start": 179.78, "end": 184.7, "text": " وأن أستيقن بذلك وأن أعتقد ذلك هذا دين"}, {"start": 184.7, "end": 187.68, "text": " إذن هو استشعار قلبي"}, {"start": 187.68, "end": 192.16, "text": " المفتاح الثالث هو الأثر العملي"}, {"start": 192.16, "end": 196.4, "text": " بمعنى ماذا يدعوك ذلك"}, {"start": 196.4, "end": 198.0, "text": " أنت فهمت المراد"}, {"start": 198.0, "end": 200.82, "text": " وآمنت فلابد أن تعمل"}, {"start": 200.82, "end": 203.20000000000002, "text": " فما العمل في قوله"}, {"start": 203.20000000000002, "end": 204.20000000000002, "text": " يقوله الله وحد"}, {"start": 204.20000000000002, "end": 206.36, "text": " العمل فيها أن"}, {"start": 206.36, "end": 208.9, "text": " توحد الله في عبادتك"}, {"start": 208.9, "end": 210.02, "text": " لله عز وجل"}, {"start": 210.02, "end": 212.72, "text": " فلا تشرك بالله شيئا عمليا"}, {"start": 212.72, "end": 214.9, "text": " إذن تأمل أننا أخذنا"}, {"start": 214.9, "end": 216.86, "text": " هذه الآية بثلاث خطوات"}, {"start": 216.86, "end": 218.98000000000002, "text": " ميسرة فهم المراد"}, {"start": 218.98000000000002, "end": 221.26, "text": " الأثر الإيماني"}, {"start": 221.26, "end": 222.46, "text": " الأثر العملي"}, {"start": 222.46, "end": 225.12, "text": " دعونا نطبق في مثال"}, {"start": 225.12, "end": 227.28, "text": " أخير في قول الله عز وجل"}, {"start": 227.28, "end": 228.36, "text": " الله الصمت"}, {"start": 228.36, "end": 231.3, "text": " المراد في هذه"}, {"start": 231.3, "end": 233.18, "text": " الآية أن الله"}, {"start": 233.18, "end": 235.04, "text": " السيد الذي له"}, {"start": 235.04, "end": 237.36, "text": " السودة التام يعني بمعنى"}, {"start": 237.36, "end": 238.76, "text": " كمال الله عز وجل"}, {"start": 238.76, "end": 241.18, "text": " وغناه عن خلقه"}, {"start": 241.18, "end": 242.92000000000002, "text": " وأن الخلق"}, {"start": 242.92000000000002, "end": 245.08, "text": " محتاجون إليه هذا مراد الآية"}, {"start": 245.08, "end": 247.46, "text": " مرتبط بالمعنى لكنه"}, {"start": 247.46, "end": 249.24, "text": " نريد أن نعبر"}, {"start": 249.24, "end": 251.34, "text": " عنه بقضية مراد ماذا نفهم"}, {"start": 251.34, "end": 252.6, "text": " من هذه الآية مراد الله"}, {"start": 252.6, "end": 254.92000000000002, "text": " نأتي إلى الأثر الإيماني"}, {"start": 254.92, "end": 271.91999999999996, "text": " نستشعر كمال الله نستشعر أننا محتاجون إلى ربنا عز وجل في جميع حوائجنا نستشعر ذلك ونؤمن ونوقن ثم نعمل الأثر العملي هو أننا إذا في كل حوائجنا نتوجه إلى الله"}, {"start": 271.92, "end": 283.90000000000003, "text": " العمل أيضا أن نعتقد بعد اعتقادنا من الله عز وجل أن نجعل عملنا كله خالصا لله عز وجل"}, {"start": 283.90000000000003, "end": 286.36, "text": " فنتوجه إليه ووحده سبحانه وتعالى"}, {"start": 286.36, "end": 293.14, "text": " هذه الخطوات الثلاث أظنها واضحة لكل متدبر في مرحلته الأولى"}, {"start": 293.14, "end": 296.92, "text": " وسنتبئ ذلك بإذن الله في مستويات أخرى"}, {"start": 297.56, "end": 300.28000000000003, "text": " ولنا لقاء وبرك الله فيكم أجمعين"}, {"start": 301.92, "end": 331.90000000000003, "text": " ترجمة نانسي قنقر"}]}