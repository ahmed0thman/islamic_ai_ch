{
  "name": "huda-reader",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "sync-content": "node scripts/sync-content.mjs",
    "predev": "node scripts/sync-content.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-content.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-scene-css.mjs && node scripts/build-offline.mjs",
    "typecheck": "tsc --noEmit",
    "ask-eval": "node scripts/ask-eval.mjs",
    "rag:ingest": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/rag-ingest.mts",
    "test": "node --test src/lib/ask/*.test.ts src/lib/*.test.ts src/lib/rag/*.test.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@huggingface/transformers": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "next": "16.0.10",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
