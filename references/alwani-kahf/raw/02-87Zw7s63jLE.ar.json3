{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 14480,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "ثم تنتقل الآيات إلى عرض فتنة جديدة."
    } ]
  }, {
    "tStartMs": 18560,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "فتنة لطالما يعاني منها كثير من الناس."
    } ]
  }, {
    "tStartMs": 23240,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "فتنة الرزق منعا أو عطاء."
    } ]
  }, {
    "tStartMs": 27680,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "فتنة متجددة في كل وقت."
    } ]
  }, {
    "tStartMs": 29900,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "وكلمة الرزق."
    } ]
  }, {
    "tStartMs": 31160,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "لماذا اخترنا الرزق؟ لأن الرزق لا ينحصر في\nالمال."
    } ]
  }, {
    "tStartMs": 35360,
    "dDurationMs": 5790,
    "segs": [ {
      "utf8": "صحيح الكلام في سورة الكهف جاء عن ضرب مثل عن\nصاحب الجنتين."
    } ]
  }, {
    "tStartMs": 41510,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "عن المال بشكل خاص."
    } ]
  }, {
    "tStartMs": 44000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "ولكن القضية لم تكن فقط قضية مال."
    } ]
  }, {
    "tStartMs": 47600,
    "dDurationMs": 9240,
    "segs": [ {
      "utf8": "القضية ممكن أن تندرج تحت علم أو شهادات ممكن\nأن تندرج تحت وظائف ممكن تندرج تحت مواهب ممكن"
    } ]
  }, {
    "tStartMs": 56870,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "تندرج تحت العلم ممكن تندرج تحت."
    } ]
  }, {
    "tStartMs": 59840,
    "dDurationMs": 7260,
    "segs": [ {
      "utf8": "الاولاد اشياء متعددة مختلفة ولذا كلمة فتنة\nالرزق هي أوسع أو أشمل."
    } ]
  }, {
    "tStartMs": 67820,
    "dDurationMs": 9240,
    "segs": [ {
      "utf8": "تدبروا معي قول الله عز وجل واضرب لهم مثلا\nرجلين جعلنا لاحدهما جنتين من اعناب"
    } ]
  }, {
    "tStartMs": 77570,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "وحفظناها بنخل وجعلنا بينهما زرعا كلتا\nالجنتين آتت أكلها ولم تظلم منه شيئا وفجرنا"
    } ]
  }, {
    "tStartMs": 87560,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "خلالهما نارا وكان له ثمر فقال لصاحبه وهو\nيحاوره."
    } ]
  }, {
    "tStartMs": 94610,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "من هنا تبدأ القصة."
    } ]
  }, {
    "tStartMs": 96650,
    "dDurationMs": 7500,
    "segs": [ {
      "utf8": "انا اكثر منك مالا واعز نفرا ودخل جنته وهو\nظالم لنفسه."
    } ]
  }, {
    "tStartMs": 104810,
    "dDurationMs": 9930,
    "segs": [ {
      "utf8": "قال ما اظن ان تبيد هذه ابدا وما اظن الساعه\nقائمه ولئن رددت الى ربي لاجدن خيرا منها"
    } ]
  }, {
    "tStartMs": 114740,
    "dDurationMs": 8570,
    "segs": [ {
      "utf8": "منقلبا رجل فتح الله سبحانه وتعالى من رزقه\nعليه وأعطاه ابتلاء."
    } ]
  }, {
    "tStartMs": 123850,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "العطاء ابتلاء."
    } ]
  }, {
    "tStartMs": 125650,
    "dDurationMs": 6210,
    "segs": [ {
      "utf8": "العطاء فتنة. أن تفتح عليك ابواب الدنيا باي\nشكل من الاشكال."
    } ]
  }, {
    "tStartMs": 132070,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "منصب. وظيفة جديدة."
    } ]
  }, {
    "tStartMs": 133960,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "زيادة في اموال بيت جديد."
    } ]
  }, {
    "tStartMs": 136780,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "اولاد. كل هذا يقع تحت الابتلاء."
    } ]
  }, {
    "tStartMs": 140260,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "امتحان. فتنة نتعرض لها نحن في كل زمن وفي كل\nوقت."
    } ]
  }, {
    "tStartMs": 145900,
    "dDurationMs": 8730,
    "segs": [ {
      "utf8": "السؤال الذي ينبغي ان لا اجعل الفتنة او\nالامتحان الذي امر به يغيب عني."
    } ]
  }, {
    "tStartMs": 154660,
    "dDurationMs": 9060,
    "segs": [ {
      "utf8": "هذا السؤال واستحضار هذا السؤال في اي شيء\nسأستعمل هذه النعمة؟ في اي شيء سأستعمل هذا"
    } ]
  }, {
    "tStartMs": 163720,
    "dDurationMs": 8610,
    "segs": [ {
      "utf8": "العطاء؟ هل استعمله في الزيادة في التقرب الى\nالله عز وجل؟ هل انا اعرف مصدر هذا الرزق الذي"
    } ]
  }, {
    "tStartMs": 172330,
    "dDurationMs": 9120,
    "segs": [ {
      "utf8": "اتاني وانسبه بالفعل إلى من يستحق أن ينسب\nإليه الرزق والفضل؟ أم أني سأظل كما قصة صاحب"
    } ]
  }, {
    "tStartMs": 181450,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "الجنتين. صاحب الجنتين."
    } ]
  }, {
    "tStartMs": 185290,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "رجل أعطاه الله مالا فتح عليه في المال."
    } ]
  }, {
    "tStartMs": 189070,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "وكان المال والعطاء امتحان وابتلاء."
    } ]
  }, {
    "tStartMs": 192970,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "ولكنه رسب في ذلك الامتحان."
    } ]
  }, {
    "tStartMs": 196270,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "أول سبب من أسباب الرسوب الذي تقدمه لسورة\nالكهف."
    } ]
  }, {
    "tStartMs": 200590,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "حتى أقف عند."
    } ]
  }, {
    "tStartMs": 202720,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "انا اكثر منك مالا واعز نفرا."
    } ]
  }, {
    "tStartMs": 206140,
    "dDurationMs": 8730,
    "segs": [ {
      "utf8": "انا. انا نسب الفضل وكثرة المال والانفاق\nالذين من حوله والعزوة والبشر"
    } ]
  }, {
    "tStartMs": 214870,
    "dDurationMs": 9570,
    "segs": [ {
      "utf8": "والخدم والحشم ومن حوله من اولاد وعشيرة واهل\nنسبهم لمن لنفسه قال أنا أكثر منك."
    } ]
  }, {
    "tStartMs": 224830,
    "dDurationMs": 5670,
    "segs": [ {
      "utf8": "لم ينسب الفضل ولا النعمة ولا الرزق ولا\nالعطاء للخالق سبحانه."
    } ]
  }, {
    "tStartMs": 231760,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "لم يدرك أن كل ما نحن فيه."
    } ]
  }, {
    "tStartMs": 234060,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "النفس الذي اتنفسه ممن؟ ممن خلق."
    } ]
  }, {
    "tStartMs": 238680,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "انا لا املك شيء انا جئت الى الدنيا لا يوجد\nعندي املاك."
    } ]
  }, {
    "tStartMs": 243570,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "انا لا امتلك حتى مكونات جسمي ليست تحت\nسيطرتي."
    } ]
  }, {
    "tStartMs": 248970,
    "dDurationMs": 9510,
    "segs": [ {
      "utf8": "ولذا سبحانه حين يريد ان يوقف انفاس الحياه\nيوقفها وحين يريد سبحانه ان يوقف نبضات"
    } ]
  }, {
    "tStartMs": 258480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "القلب يوقفها عن العمل."
    } ]
  }, {
    "tStartMs": 261030,
    "dDurationMs": 9360,
    "segs": [ {
      "utf8": "من انت ايها الانسان المغرور المتكبر المتعالي\nالذي تصنع منك المحنه محنه العطاء."
    } ]
  }, {
    "tStartMs": 270660,
    "dDurationMs": 9480,
    "segs": [ {
      "utf8": "فتنه العطاء تصنع منك انسانا اخرا مغرورا لا\nيرى من حوله ولا يرى لربه سبحانه فضلا عليه."
    } ]
  }, {
    "tStartMs": 280140,
    "dDurationMs": 6420,
    "segs": [ {
      "utf8": "من انت؟ من انت حتى تنسب الفضل لنفسك وتقول\nانا اكثر منك مالا."
    } ]
  }, {
    "tStartMs": 287190,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "ثم نقطه مهمه في هذه الايه العظيمه."
    } ]
  }, {
    "tStartMs": 291660,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "أي شيء ذاك الذي تعتز به."
    } ]
  }, {
    "tStartMs": 294270,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "تعتز بالمال."
    } ]
  }, {
    "tStartMs": 295800,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "تعتز بالنفر أي شيء الذي تعتز به."
    } ]
  }, {
    "tStartMs": 299700,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "من اعتز بالمال افقره الله."
    } ]
  }, {
    "tStartMs": 302730,
    "dDurationMs": 7530,
    "segs": [ {
      "utf8": "ومن استغنى بماله عن الله سبحانه وتعالى افقره\nالله سبحانه وابكاه."
    } ]
  }, {
    "tStartMs": 310800,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "هذه حقيقة انا حين اعتز اعتز باي شيء."
    } ]
  }, {
    "tStartMs": 315300,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "ربي سبحانه ذكر في آيات اخرى متعددة في سور من\nالقرآن."
    } ]
  }, {
    "tStartMs": 320730,
    "dDurationMs": 9810,
    "segs": [ {
      "utf8": "العزة لله ولرسوله وللمؤمنين حين تعتز اعتز\nبربك سبحانه اعتز بايمانك به سبحانه"
    } ]
  }, {
    "tStartMs": 330540,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "بتقربك إليه بطاعتك إليه."
    } ]
  }, {
    "tStartMs": 333570,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "ولكن أن تعتز بعرض من عروض الدنيا كالمال لا\nقيمة له."
    } ]
  }, {
    "tStartMs": 340230,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "أي شيء هو المال ولا شيء."
    } ]
  }, {
    "tStartMs": 342960,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "انا اكثر منك مالا واعز نفرا."
    } ]
  }, {
    "tStartMs": 347610,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "ما معنى أعز نفرا."
    } ]
  }, {
    "tStartMs": 349610,
    "dDurationMs": 8820,
    "segs": [ {
      "utf8": "اعتز بقومه اعتز بمن حوله، اعتز بحاشيته، اعتز\nبالناس الذين من حوله من اصحاب المكانة"
    } ]
  }, {
    "tStartMs": 358430,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "المرموقة. ولنا ان نتدبر ليس فقط في هذا\nالقرآن."
    } ]
  }, {
    "tStartMs": 363410,
    "dDurationMs": 9510,
    "segs": [ {
      "utf8": "القرآن. القرآن لم يأت لأقرأ الكلمات فقط دون\nأن أتوقف وأربط مع ما أراه أنا في واقع حياتي"
    } ]
  }, {
    "tStartMs": 372920,
    "dDurationMs": 8730,
    "segs": [ {
      "utf8": "العملية. دعونا نرى عشرات الأشخاص ليس فقط\nبدءا من فرعون وانما مرورا بفرعون الى كثير من"
    } ]
  }, {
    "tStartMs": 381650,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "غيره من الناس ممن يعتز بحاشيته ممن يعتز بمن\nحوله من أصحاب المكانة المرموقة."
    } ]
  }, {
    "tStartMs": 390410,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "اصحاب الاموال اصبحوا اصحاب النفوذ والسلطة\nوالجاه."
    } ]
  }, {
    "tStartMs": 395030,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "بمن تعتز."
    } ]
  }, {
    "tStartMs": 396470,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "تعتقد ان هؤلاء سينصرون حين تحتاج للنصرة."
    } ]
  }, {
    "tStartMs": 401360,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "تعتقد ان هؤلاء سيرفعون عنك ضرا او يسدون اليك\nنفعا."
    } ]
  }, {
    "tStartMs": 407390,
    "dDurationMs": 9240,
    "segs": [ {
      "utf8": "تعتقد بهؤلاء؟ انظر معي وتدبروا معي هذه\nاللمسة الرائعة العظيمة في معنى التوحيد."
    } ]
  }, {
    "tStartMs": 416960,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "التوحيد ليس كلمة أنا أقولها بلساني وإن هي\nكانت جزء منها لا إله إلا الله."
    } ]
  }, {
    "tStartMs": 423470,
    "dDurationMs": 6990,
    "segs": [ {
      "utf8": "ولكن التوحيد أن تكون في قرارة نفسك تشعر بأن\nلا عزيز إلا الله."
    } ]
  }, {
    "tStartMs": 430790,
    "dDurationMs": 8730,
    "segs": [ {
      "utf8": "تشعر وتؤمن يقينا بأن لا أحد في الدنيا يستطيع\nأن يضرك أو ينفعك سوى الله سبحانه وتعالى،"
    } ]
  }, {
    "tStartMs": 440420,
    "dDurationMs": 8430,
    "segs": [ {
      "utf8": "وأن هؤلاء البشر من حولك مهما أوتوا من قوة أو\nمن منعة او سلطان أو جاه لا يغنوا عنك من الله"
    } ]
  }, {
    "tStartMs": 448850,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "شيئا ان اراد بك ضرا أو أراد بك نفعا."
    } ]
  }, {
    "tStartMs": 452660,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "قمة التوحيد."
    } ]
  }, {
    "tStartMs": 454640,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "توحيد الله."
    } ]
  }, {
    "tStartMs": 455690,
    "dDurationMs": 7860,
    "segs": [ {
      "utf8": "أحتاج انا في سورة الكهف وسورة الكهف تذكرني\nبه آية بعد آية وتعززه في قلبي."
    } ]
  }, {
    "tStartMs": 464030,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "أحتاج أن أخلصه من هذه الشوائب."
    } ]
  }, {
    "tStartMs": 466990,
    "dDurationMs": 9630,
    "segs": [ {
      "utf8": "اياك في يوم ان يلتفت قلبك لاحد او لشخص او\nلشيء من عرض الدنيا او متاعها فتظن"
    } ]
  }, {
    "tStartMs": 476620,
    "dDurationMs": 9510,
    "segs": [ {
      "utf8": "واهما جاهلا مغترا ان ذاك الشيء او ذاك الحساب\nمن المال او تلك العزوه او تلك النفر من"
    } ]
  }, {
    "tStartMs": 486130,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "الاشخاص او او او او."
    } ]
  }, {
    "tStartMs": 487990,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "او. يمكن ان تملك لك عزا او تصنع لك جاها او\nتصنع لك مجدا فان العزه بيد الله وحده"
    } ]
  }, {
    "tStartMs": 498220,
    "dDurationMs": 8520,
    "segs": [ {
      "utf8": "لا شريك له. اول خطا وقع فيه صاحب الجنتين كان\nهذا الخطا وكلنا في بعض الاحيان في وقت من"
    } ]
  }, {
    "tStartMs": 506740,
    "dDurationMs": 8220,
    "segs": [ {
      "utf8": "الاوقات نقع في هذا الخطا دون ان ننتبه اليه\nعلي ان استيقظ ولذا سوره الكهف جمعه بعد جمعه"
    } ]
  }, {
    "tStartMs": 514960,
    "dDurationMs": 8340,
    "segs": [ {
      "utf8": "توقظ في نفسي هذا الاحساس تعزز الايمان لذا\nكانت نور ما معنى النور؟ النور ان يضيء لك"
    } ]
  }, {
    "tStartMs": 523300,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "الطريق كالطريق. لا تأخذك الحياة بعيدا."
    } ]
  }, {
    "tStartMs": 527020,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "إياك أن تغتر بما لديك من مال."
    } ]
  }, {
    "tStartMs": 529630,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "وانظر إلى الآية التي تليها."
    } ]
  }, {
    "tStartMs": 531910,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "ودخل جنته وهو ظالم لنفسه."
    } ]
  }, {
    "tStartMs": 535750,
    "dDurationMs": 9540,
    "segs": [ {
      "utf8": "قال ما اظن ان تبيد هذه ابدا دخلها واعظم\nانواع الظلم وكل انواع الظلم عظيمة ولكنها كلها"
    } ]
  }, {
    "tStartMs": 545290,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "تنبت من شجرة ظلم الانسان لنفسه."
    } ]
  }, {
    "tStartMs": 548530,
    "dDurationMs": 9810,
    "segs": [ {
      "utf8": "واعظم ظلم للانسان لنفسه ان يبعدها ويصرفها عن\nخالقه بالشرك وعدم الاخلاص وابتعاد واعراض"
    } ]
  }, {
    "tStartMs": 558370,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "عن الله سبحانه وتعالى."
    } ]
  }, {
    "tStartMs": 560170,
    "dDurationMs": 7770,
    "segs": [ {
      "utf8": "وهو سبحانه من لا ينبغي ان يعرض عنه احد دخل\nجنته وهو ظالم لنفسه."
    } ]
  }, {
    "tStartMs": 568210,
    "dDurationMs": 9450,
    "segs": [ {
      "utf8": "كيف ظلم نفسه؟ بل دحضها وطمسها وطمس معالم\nالايمان من خلال الشرك من خلال نسب"
    } ]
  }, {
    "tStartMs": 577930,
    "dDurationMs": 6170,
    "segs": [ {
      "utf8": "ما وصل اليه من مال ومن جنة ومن نفر من حوله\nلنفسه."
    } ]
  }, {
    "tStartMs": 585480,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "لنفسه الضعيفة."
    } ]
  }, {
    "tStartMs": 586980,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "التي لا تملك شيئا."
    } ]
  }, {
    "tStartMs": 589470,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "ولم يتوقف الظلم عند هذا الحد."
    } ]
  }, {
    "tStartMs": 592320,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "وإنما. وهكذا الظلم."
    } ]
  }, {
    "tStartMs": 594330,
    "dDurationMs": 6450,
    "segs": [ {
      "utf8": "الإنسان حين يبدأ سلسلة الظلم لنفسه لا يمكن\nان يقف عند خلق رديء واحد."
    } ]
  }, {
    "tStartMs": 601050,
    "dDurationMs": 6150,
    "segs": [ {
      "utf8": "ولكن كل خلق يسلمه الى الخلق الاسوأ الذي يرديه\nاسفل سافلين."
    } ]
  }, {
    "tStartMs": 607680,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "قال ما اظن ان تبيد هذه أبدا."
    } ]
  }, {
    "tStartMs": 610620,
    "dDurationMs": 6630,
    "segs": [ {
      "utf8": "هل يعقل هذه الجنة العظيمة التي اراها امام\nعيني؟ أن تبيد ما أظن."
    } ]
  }, {
    "tStartMs": 617640,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "انظر الى الغرور."
    } ]
  }, {
    "tStartMs": 619140,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "انظر الى اغترار الانسان فتنة."
    } ]
  }, {
    "tStartMs": 621900,
    "dDurationMs": 7230,
    "segs": [ {
      "utf8": "ما اظن ان اخرج في يوم من الايام من هذا القصر\nالذي امتلك ما اظن ان هذه الحاشية في يوم من"
    } ]
  }, {
    "tStartMs": 629130,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "الايام يمكن ان تتخلى عني."
    } ]
  }, {
    "tStartMs": 631620,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "ما أظن. ما أظن."
    } ]
  }, {
    "tStartMs": 632940,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "ما أظن. ولكنه كذب."
    } ]
  }, {
    "tStartMs": 635280,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "ووهم كاذب."
    } ]
  }, {
    "tStartMs": 636930,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "ووهم عشت فيه وانفقت فيه حياتي وأغلى ساعات\nعمري."
    } ]
  }, {
    "tStartMs": 642870,
    "dDurationMs": 7830,
    "segs": [ {
      "utf8": "هذا صاحب الجنتين الواهم الجاهل الذي لم يكن\nيدرك حقيقة الدنيا ولا حقيقة الآخرة."
    } ]
  }, {
    "tStartMs": 650700,
    "dDurationMs": 5730,
    "segs": [ {
      "utf8": "وكان يعتقد ان عطاء الجنتين اعظم من عطاء\nالايمان وبئس من عطاء."
    } ]
  }, {
    "tStartMs": 656970,
    "dDurationMs": 6270,
    "segs": [ {
      "utf8": "اعظم عطاء واعظم رزق يمنحه الله سبحانه لاحد\nمن خلقه."
    } ]
  }, {
    "tStartMs": 663630,
    "dDurationMs": 9660,
    "segs": [ {
      "utf8": "ان يدنيك منه سبحانه بالايمان به بان يفتح على\nبصيرتك بان ينير ويضيء جنبات نفسك وقلبك وروحك"
    } ]
  }, {
    "tStartMs": 673290,
    "dDurationMs": 9810,
    "segs": [ {
      "utf8": "فتسمو لخالقها سبحانه وتحميدا وتمجيدا وتسبيحا\nوما اظن الساعه قائمه كذب بالبعث كذب"
    } ]
  }, {
    "tStartMs": 683100,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "بخالقه سبحانه."
    } ]
  }, {
    "tStartMs": 684660,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "ولئن رددت الى ربي لاجدن خيرا منها منقلبا."
    } ]
  }, {
    "tStartMs": 689010,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "غرور غاية التكبر وغاية الغرور."
    } ]
  }, {
    "tStartMs": 693120,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "وتأمل معي الى الجزء الثاني من القصة."
    } ]
  }, {
    "tStartMs": 697620,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "هنا العطاء ولكن عطاء الدنيا وهنا الجانب\nالاخر الانسان الفقير المنع."
    } ]
  }, {
    "tStartMs": 705650,
    "dDurationMs": 6660,
    "segs": [ {
      "utf8": "نحن نرى الصوره احيانا في كثير من الاحيان نحن\nكبشر انظر الى جزء فقط من الصوره لا اكمل"
    } ]
  }, {
    "tStartMs": 712310,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "الصوره لا اخذ الصوره بكمالها الجزء الاول من\nالصوره صاحب العطاء صاحب الجنتين."
    } ]
  }, {
    "tStartMs": 718940,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "الجزء الثاني من تلك الصوره انسان فقير بسيط\nمتواضع لا يمتلك من متاع الدنيا الكثير انظر"
    } ]
  }, {
    "tStartMs": 727340,
    "dDurationMs": 8490,
    "segs": [ {
      "utf8": "ماذا قال له قال له اكفرت بالذي خلقك من تراب\nثم من نطفه ثم سواك رجلا."
    } ]
  }, {
    "tStartMs": 736070,
    "dDurationMs": 9930,
    "segs": [ {
      "utf8": "نعم منع الله عنه شيئا من عطاء الدنيا شيئا من\nتراب الدنيا حتى وان كان كبرا ولكن اعطاه"
    } ]
  }, {
    "tStartMs": 746000,
    "dDurationMs": 8550,
    "segs": [ {
      "utf8": "شيئا اخر اعطاه نعمه لا تزول اعطاه نعمه\nالايمان والتوحيد والتعرف لخالقه سبحانه"
    } ]
  }, {
    "tStartMs": 754550,
    "dDurationMs": 9600,
    "segs": [ {
      "utf8": "وتعالى. وتامل معي قول الله وانظر ايهما اعز\nلكن هو الله ربي ولا اشرك بربي"
    } ]
  }, {
    "tStartMs": 764180,
    "dDurationMs": 7140,
    "segs": [ {
      "utf8": "احدا. وتأمل كم مرة تقريبا ست مرات ترد في\nسورة الكهف احد."
    } ]
  }, {
    "tStartMs": 771680,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "الواحد الاحد."
    } ]
  }, {
    "tStartMs": 772910,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "التوحيد. التوحيد."
    } ]
  }, {
    "tStartMs": 775670,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "لكن هو الله."
    } ]
  }, {
    "tStartMs": 777230,
    "dDurationMs": 9210,
    "segs": [ {
      "utf8": "ربي. العصمة من الفتن لا تكون الا من قلب يؤمن\nويتلفظ في كل نبضة من نبضاته بان لا اله الا"
    } ]
  }, {
    "tStartMs": 786440,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "الله. وان هذا الدين حق وان الساعة قائمة."
    } ]
  }, {
    "tStartMs": 790940,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "وان الدنيا الى زوال."
    } ]
  }, {
    "tStartMs": 793070,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "وان الاخره هي الباقية."
    } ]
  }, {
    "tStartMs": 795680,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "انظر. لكن هو الله ربي ولا اشرك بربي احدا."
    } ]
  }, {
    "tStartMs": 801050,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "هذا الرجل البسيط الفقير المتواضع صاحب\nالامكانيات المادية البسيطة."
    } ]
  }, {
    "tStartMs": 806210,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "الذي لا يملك شيئا من متاع الدنيا."
    } ]
  }, {
    "tStartMs": 809000,
    "dDurationMs": 7770,
    "segs": [ {
      "utf8": "هذا الانسان البسيط رزق نعمة الايمان والتوحيد\nبالله عز وجل ورزق نقطه اخرى."
    } ]
  }, {
    "tStartMs": 816890,
    "dDurationMs": 8550,
    "segs": [ {
      "utf8": "كثير منا مع الاسف في هذه الايام امام فتنه\nالرزق يضعف امامها حسن الظن بالله عز وجل."
    } ]
  }, {
    "tStartMs": 825770,
    "dDurationMs": 8190,
    "segs": [ {
      "utf8": "كم مره انا اسات الظن بالله حين يمنع عني ما\nاريد وما اسعى اليه كم مره قلت اعطى ربي فلان"
    } ]
  }, {
    "tStartMs": 833960,
    "dDurationMs": 7770,
    "segs": [ {
      "utf8": "ولم يعطني كم مره كم مره حدثت بها نفسي كم مره\nقلت لماذا فلان عنده عشر اولاد وانا ما عندي"
    } ]
  }, {
    "tStartMs": 841730,
    "dDurationMs": 7680,
    "segs": [ {
      "utf8": "ولا ولد؟ كم مره فكرت واعترضت على احكام خالقك\nحتى ولو كان هذا الاعتراض في قلبي."
    } ]
  }, {
    "tStartMs": 849800,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "كم مره خطر ببالي لماذا يفتح الله عز وجل\nالدنيا على من كفر به ويمنعها عمن لم يكفر به"
    } ]
  }, {
    "tStartMs": 857240,
    "dDurationMs": 9510,
    "segs": [ {
      "utf8": "ويؤمن به؟ كم مره تصورت واهما غير متيقن بالله\nسبحانه وتعالى غير مدرك لحكمته"
    } ]
  }, {
    "tStartMs": 866750,
    "dDurationMs": 8840,
    "segs": [ {
      "utf8": "سبحانه وعلمه وقدرته المطلقه؟ كم مره قلت مع\nنفسي لماذا الكافر يمتلك من اسباب القوه ويضرب"
    } ]
  }, {
    "tStartMs": 875590,
    "dDurationMs": 8190,
    "segs": [ {
      "utf8": "ويقتل ويسفك وانا ضعيف فقير لا استطيع ان امنع\nولا ان ادفع عن نفسي الضر ولا ان استجلب النفع."
    } ]
  }, {
    "tStartMs": 883780,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "كم مره اسات الادب واسات الظن مع الله عز وجل."
    } ]
  }, {
    "tStartMs": 888640,
    "dDurationMs": 8220,
    "segs": [ {
      "utf8": "لكن سوره الكهف تقدم لي نموذج من البشر يحسن\nالظن بالله مهما انتكست احواله الماديه."
    } ]
  }, {
    "tStartMs": 897430,
    "dDurationMs": 9900,
    "segs": [ {
      "utf8": "الدنيا طلعت او نزلت محسن الظن بالله عز وجل\nمؤمن يقول لكن هو الله ربي اعطاني او منعني اخذ"
    } ]
  }, {
    "tStartMs": 907330,
    "dDurationMs": 9300,
    "segs": [ {
      "utf8": "مني ام لم ياخذ مني عطاؤه ومنعه عطاء وعطاؤه\nومنعه ابتلاء وانا في كلا الحالتين"
    } ]
  }, {
    "tStartMs": 916660,
    "dDurationMs": 9240,
    "segs": [ {
      "utf8": "احتاج لتوحيده والايمان به والاعتصام بحبله\nلكن هو الله ربي هو ربي سواء كنت"
    } ]
  }, {
    "tStartMs": 925900,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "مريض او كنت صحيح الجسم هو ربي."
    } ]
  }, {
    "tStartMs": 930160,
    "dDurationMs": 7200,
    "segs": [ {
      "utf8": "سواء كنت أستطيع أن أمشي على قدمي أم كنت لا\nأستطيع المشي إلا على كرسي متحرك."
    } ]
  }, {
    "tStartMs": 937390,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "هو ربي وحبيبي وخالقي."
    } ]
  }, {
    "tStartMs": 939910,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "هو الحنان المنان الغفور الرحيم."
    } ]
  }, {
    "tStartMs": 943630,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "سواء أعطاني أو منع عني."
    } ]
  }, {
    "tStartMs": 946120,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "هو ربي. سواء قتلني أو قتلت في سبيله."
    } ]
  }, {
    "tStartMs": 950590,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "أو أحد اعتدى علي."
    } ]
  }, {
    "tStartMs": 952570,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "أو سلط علي."
    } ]
  }, {
    "tStartMs": 953770,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "هو ربي. هذه القضية قضية محسومة في قلبي في\nنفسي."
    } ]
  }, {
    "tStartMs": 958720,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "هذه قضية غير خاضعة للعطاء والمنع."
    } ]
  }, {
    "tStartMs": 962800,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "المؤمن الذي يخضع إيمانه بالله للعطاء والمنع."
    } ]
  }, {
    "tStartMs": 967060,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "مؤمن ضعيف الإيمان يحتاج لتصحيح التوحيد."
    } ]
  }, {
    "tStartMs": 970840,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "وسورة الكهف تعزز هذا التوحيد وتصححه من جديد."
    } ]
  }, {
    "tStartMs": 975280,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "وتوقظ في نفسي نور التوحيد ليشع على قلبي من\nجديد."
    } ]
  }, {
    "tStartMs": 980530,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "إيمانك بالله لا ينبغي أن يتزعزع ولا يكون محط\nتساؤل."
    } ]
  }, {
    "tStartMs": 984940,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "إذا أردت إيمان يصل بك لجنات الفردوس."
    } ]
  }, {
    "tStartMs": 988990,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "إذا اردت ايمانا يصل بك الى احسن العمل."
    } ]
  }, {
    "tStartMs": 992880,
    "dDurationMs": 8040,
    "segs": [ {
      "utf8": "عليك ان تدرك ان الايمان بالله وتوحيد الله\nسبحانه غير قابل للخضوع الى معادلات العطاء"
    } ]
  }, {
    "tStartMs": 1000920,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "والمنع كما يقع البعض في هذه الفتن."
    } ]
  }, {
    "tStartMs": 1004250,
    "dDurationMs": 6870,
    "segs": [ {
      "utf8": "وانظر الى قول الانسان هذا البسيط المتواضع\nالذي حرم من متاع الدنيا واعطي اعظم متاع."
    } ]
  }, {
    "tStartMs": 1011420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "ولولا اذ دخلت جنتك."
    } ]
  }, {
    "tStartMs": 1013550,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "لو انا كنت في مكانك انظر هنا انتهت موضوع\nالحسد."
    } ]
  }, {
    "tStartMs": 1018350,
    "dDurationMs": 8040,
    "segs": [ {
      "utf8": "لان بعض الناس حين يرى النعم الماديه الظاهره\nالتي قد اعطيت لفلان او فلان من الناس اول شيء"
    } ]
  }, {
    "tStartMs": 1026390,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "يتبادر الى قلبه هو قضيه الحسد."
    } ]
  }, {
    "tStartMs": 1029870,
    "dDurationMs": 8100,
    "segs": [ {
      "utf8": "الله اعطى فلان وهو كافر ولا يصلي ولا كذا ولا\nكذا ومنع عني وانا اصلي واشهد."
    } ]
  }, {
    "tStartMs": 1038240,
    "dDurationMs": 9420,
    "segs": [ {
      "utf8": "اما ايمانك وشهادتك بالله وصلاتك فهي هل لاجل\nالعطاء ان اعطاك امنت به وان منع عنك كفرت به."
    } ]
  }, {
    "tStartMs": 1048020,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "هذا ليس بإيمان."
    } ]
  }, {
    "tStartMs": 1050690,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "أما الحسد والنظر إلى إلى ما في أيدي الناس."
    } ]
  }, {
    "tStartMs": 1054230,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "انظر إلى هذا الإنسان الفقير المتواضع."
    } ]
  }, {
    "tStartMs": 1057590,
    "dDurationMs": 6330,
    "segs": [ {
      "utf8": "الحسد من أعظم الأعمال التي تأخذ الدين وتجتث\nجذور التوحيد من القلب."
    } ]
  }, {
    "tStartMs": 1063950,
    "dDurationMs": 5790,
    "segs": [ {
      "utf8": "لماذا؟ لأن الحسد يتضمن الاعتراض على حكم الله\nوحكمته سبحانه."
    } ]
  }, {
    "tStartMs": 1069950,
    "dDurationMs": 9870,
    "segs": [ {
      "utf8": "ومحاولة التدخل وإساءة الأدب مع الله عز وجل\nفي الفصل بين عباده هو رب هو خالق، هو سيد في"
    } ]
  }, {
    "tStartMs": 1079820,
    "dDurationMs": 6660,
    "segs": [ {
      "utf8": "مملكته، عز وجل، يعطي ويمنع كما يريد وكما\nيشاء ويفعل ما يريد."
    } ]
  }, {
    "tStartMs": 1086480,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "ونحن عبيد في مملكته سواء أعطانا أو منعنا،\nرضينا بذلك ام لم نرضى، هذا هو الإيمان، الرجل"
    } ]
  }, {
    "tStartMs": 1096470,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "المؤمن قال ولولا إذ دخلت جنتك لماذا؟ لو أنت؟\nلو أنت دخلت في جنتك بدل أن تقول ما اظن ان"
    } ]
  }, {
    "tStartMs": 1106460,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "تبيد هذه ابدا."
    } ]
  }, {
    "tStartMs": 1108170,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "لو دخلت انت في جنتك لقلت ما شاء الله."
    } ]
  }, {
    "tStartMs": 1111980,
    "dDurationMs": 8520,
    "segs": [ {
      "utf8": "كان يفترض بك ان تنسب القوه وان تنسب الرزق\nوان تنسب النعمه لمن لله سبحانه."
    } ]
  }, {
    "tStartMs": 1120800,
    "dDurationMs": 8940,
    "segs": [ {
      "utf8": "ما شاء الله هذا معنى وهنا كلمه ما شاء الله\nلا قوه الا بالله مفتاح لمن اراد ان يحافظ على"
    } ]
  }, {
    "tStartMs": 1129740,
    "dDurationMs": 9450,
    "segs": [ {
      "utf8": "نعمه من اراد ان يصون نعمه من الله بها عليه\nسواء كان من مال من موهبه من علم من"
    } ]
  }, {
    "tStartMs": 1139190,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "ولد اي شيء اول كلمه عليه ان يقولها وتبقى\nدائما في قلبه."
    } ]
  }, {
    "tStartMs": 1144800,
    "dDurationMs": 9900,
    "segs": [ {
      "utf8": "ما شاء الله لا قوه الا بالله وما معنى ما شاء\nالله لا قوه الا بالله هذا العطاء هي مشيئه"
    } ]
  }, {
    "tStartMs": 1154700,
    "dDurationMs": 9170,
    "segs": [ {
      "utf8": "الله عز وجل هذا العطاء نسبته لله انا لا\nاملكه انا لا استحقه انا لا اضع نفسي كما وضع"
    } ]
  }, {
    "tStartMs": 1163870,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "قارون نفسه حين قال انما اوتيته على علم."
    } ]
  }, {
    "tStartMs": 1169240,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "لا انا لم اؤتي هذا المال وهذه النعمه على\nعلم."
    } ]
  }, {
    "tStartMs": 1172840,
    "dDurationMs": 9330,
    "segs": [ {
      "utf8": "صحيح الاخذ بالاسباب مطلوب ولكني قد اخذ بكل\nاسباب الدنيا طولا وعرضا ثم لا يكون لي فيها"
    } ]
  }, {
    "tStartMs": 1182170,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "الا ما قدره الله عز وجل من منع."
    } ]
  }, {
    "tStartMs": 1185650,
    "dDurationMs": 8430,
    "segs": [ {
      "utf8": "انا ربما اخذ بالاسباب ولا انجح ولا اوفق الى\nنجاح ولا اوفق لعطاء ولا اوفق الى ربح تجاره."
    } ]
  }, {
    "tStartMs": 1194350,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "انت قد تكون تاجرا ماهرا وتعرف كل اساليب\nالنجاح في الشركات والمؤسسات ولكن ربما تفعل او"
    } ]
  }, {
    "tStartMs": 1202750,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "تقوم بصفقه ثم ربي عز وجل لا يسمح لك بان تنهي\nهذه الصفقه او تكون صفقه خاسره"
    } ]
  }, {
    "tStartMs": 1213160,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "من الذي اعطى ومنع الله."
    } ]
  }, {
    "tStartMs": 1216100,
    "dDurationMs": 9050,
    "segs": [ {
      "utf8": "اذن لا يخرج الامر عن مشيئه الله عز وجل\nومقتضى ايماني يستدعي وتوحيدا بالله عز وجل أن"
    } ]
  }, {
    "tStartMs": 1225150,
    "dDurationMs": 8370,
    "segs": [ {
      "utf8": "أؤمن بهذه الحقيقة، أن أستحضر دائما هذه\nالحقيقة، ولذا جاء يعني تأملوا الربط الآيات"
    } ]
  }, {
    "tStartMs": 1233520,
    "dDurationMs": 7980,
    "segs": [ {
      "utf8": "التي في سورة في الكلام عن القصة في بداياتها\nفي قصة أهل الكهف عندما علم الله سبحانه وتعالى"
    } ]
  }, {
    "tStartMs": 1241860,
    "dDurationMs": 9360,
    "segs": [ {
      "utf8": "نبيه والمؤمنين أدبا رفيعا ولا تقولن لشيء إني\nفاعل ذلك غدا الا ان يشاء الله كل شيء"
    } ]
  }, {
    "tStartMs": 1251220,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "بمشيئة الله عز وجل كل شيء بامره سبحانه."
    } ]
  }, {
    "tStartMs": 1255360,
    "dDurationMs": 8850,
    "segs": [ {
      "utf8": "انا حين أقول سأفعل ذلك بعد ساعة أو غدا من\nالذي يملك تلك الساعة؟ من الذي يملك ان يجعلني"
    } ]
  }, {
    "tStartMs": 1264210,
    "dDurationMs": 8310,
    "segs": [ {
      "utf8": "من اهل تلك الساعة او من اهل ذلك اليوم؟ من\nالذي يملك أنفاس الحياة؟ وبالتالي لا ينبغي لي"
    } ]
  }, {
    "tStartMs": 1272520,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "أبدا أن أنسى وأن أغفل حتى حتى ما أنسى أبدا."
    } ]
  }, {
    "tStartMs": 1277800,
    "dDurationMs": 6370,
    "segs": [ {
      "utf8": "ولا أغفل عن ذكر الله لأن لان هذا مدخل من\nمداخل الشيطان ومدخل من مداخل الفتن."
    } ]
  }, {
    "tStartMs": 1284830,
    "dDurationMs": 6300,
    "segs": [ {
      "utf8": "باي شيء ان أتصور أني أستطيع فعل شيء دون\nمشيئته سبحانه."
    } ]
  }, {
    "tStartMs": 1291490,
    "dDurationMs": 8430,
    "segs": [ {
      "utf8": "وقد يقول قائل نحن ربما في خضم الانشغالات\nنقول سأفعل ذلك غدا وأنا لا أقصدها أنا وحدي"
    } ]
  }, {
    "tStartMs": 1299920,
    "dDurationMs": 9690,
    "segs": [ {
      "utf8": "الله واعلم كل شيء بأمره ولكني نسيت ولذلك ربي\nسبحانه وتعالى قال ولا تقولن لشيء إني فاعل"
    } ]
  }, {
    "tStartMs": 1309610,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "ذلك غدا الا ان يشاء الله واذكر ربك إذا نسيت."
    } ]
  }, {
    "tStartMs": 1314980,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "النسيان منهي عنه."
    } ]
  }, {
    "tStartMs": 1317470,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "ينبغي أن لا أنسى قلبا ولسانا وعملا وسلوكا أن\nما من عمل إلا والله سبحانه وتعالى هو المريد"
    } ]
  }, {
    "tStartMs": 1327190,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "له والمحرك له هو من يمكنني من القيام بالعمل."
    } ]
  }, {
    "tStartMs": 1331780,
    "dDurationMs": 8350,
    "segs": [ {
      "utf8": "هذا ايمان هذه العبادة ما اصبحت كلمة ما شاء\nالله مجرد كلمة كلمه تقال باللسان لا اصبحت"
    } ]
  }, {
    "tStartMs": 1340130,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "عباده اصبحت من اعظم العبادات وكذا ان شاء\nالله."
    } ]
  }, {
    "tStartMs": 1345080,
    "dDurationMs": 9900,
    "segs": [ {
      "utf8": "لماذا؟ لاني حين اقول واردد هذه الكلمه استحضر\nواجدد توحيدي وايماني بانه ما من عمل اقوم به"
    } ]
  }, {
    "tStartMs": 1355280,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "الا ومشيئه الله غالبه علي."
    } ]
  }, {
    "tStartMs": 1358280,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "لا قوه الا بالله تاملوا معي."
    } ]
  }, {
    "tStartMs": 1361400,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "كنز من كنوز الجنه."
    } ]
  }, {
    "tStartMs": 1362990,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "لا حول ولا قوه الا بالله."
    } ]
  }, {
    "tStartMs": 1365630,
    "dDurationMs": 7770,
    "segs": [ {
      "utf8": "ما معناها. انا ضعيف ابرئ من كل حول لي وقوه\nالى من الى حولك وقوتك."
    } ]
  }, {
    "tStartMs": 1373610,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "لا قوه الا بالله."
    } ]
  }, {
    "tStartMs": 1375560,
    "dDurationMs": 8490,
    "segs": [ {
      "utf8": "لا المال ولا الجاه ولا الحاشية ولا الجيوش\nولا القصور ولا حسابات البنوك ولا اي شيء في"
    } ]
  }, {
    "tStartMs": 1384050,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "الدنيا. لا قوه الا بالله."
    } ]
  }, {
    "tStartMs": 1386660,
    "dDurationMs": 9450,
    "segs": [ {
      "utf8": "من استقوى بالله اعانه وقواه من استقوى بالله\nاعانه وقواه ومن استقوى بغيره"
    } ]
  }, {
    "tStartMs": 1396260,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "اذله واذله واضعفه وارداه."
    } ]
  }, {
    "tStartMs": 1399920,
    "dDurationMs": 9780,
    "segs": [ {
      "utf8": "هذه حقيقه انت تستقوي بمن بجيوش بحاشيه بنفر\nكما في صاحب الجنتين انظر الى"
    } ]
  }, {
    "tStartMs": 1409700,
    "dDurationMs": 8430,
    "segs": [ {
      "utf8": "النهايه ولكن دعونا قبل أن نصل إلى النهاية\nدعونا نكمل حوار هذا الإنسان المؤمن المتواضع"
    } ]
  }, {
    "tStartMs": 1418400,
    "dDurationMs": 9660,
    "segs": [ {
      "utf8": "صاحب الرزق البسيط الذي لم تجعل منه فتنة\nتقليل الرزق أو تقتير الرزق عبدا مخالفا"
    } ]
  }, {
    "tStartMs": 1428060,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "لربه جاحدا ساخطا على قضاء ربه."
    } ]
  }, {
    "tStartMs": 1432050,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "وأنا أتساءل كم مرة من المرات لم ننجح في هذا\nالاختبار؟ كم مرة ابتلينا بقلة الرزق أو بضيق"
    } ]
  }, {
    "tStartMs": 1441770,
    "dDurationMs": 8760,
    "segs": [ {
      "utf8": "الرزق ولو لفترة محددة ولم ننجح كم مرة؟ كم\nمرة تزعزع الإيمان وتزعزعت محبة الله عز وجل في"
    } ]
  }, {
    "tStartMs": 1450530,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "قلوبنا ولو بيننا وبين أنفسنا لم نبح بذلك\nلأحد."
    } ]
  }, {
    "tStartMs": 1455310,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "نتيجة لقلة الرزق."
    } ]
  }, {
    "tStartMs": 1457320,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "نتيجة لعدم تحقق أمنية كنا نسعى إليها."
    } ]
  }, {
    "tStartMs": 1460950,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "نتيجة لعدم ربحنا في تجارة ياما طلبناها\nوسعينا إليها."
    } ]
  }, {
    "tStartMs": 1465870,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "كم مرة. كم مرة انظر الى قول هذا الرجل."
    } ]
  }, {
    "tStartMs": 1471030,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "ان ترن. انا اقل منك مالا وولدا."
    } ]
  }, {
    "tStartMs": 1473700,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "أنت ترى قلة المال والولد."
    } ]
  }, {
    "tStartMs": 1476730,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "أما أنا فلا أرى القل في المال والولد."
    } ]
  }, {
    "tStartMs": 1479790,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "عسى ربي ان يؤتين خيرا من جنتك."
    } ]
  }, {
    "tStartMs": 1483630,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "هذه الجنة التي تغتر بها انت في الدنيا."
    } ]
  }, {
    "tStartMs": 1486900,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "عسى ربي. اسأل ربي سبحانه ان يؤتيني خيرا\nمنها."
    } ]
  }, {
    "tStartMs": 1491100,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "الرجل المؤمن كان متعلق قلبه بالاخره."
    } ]
  }, {
    "tStartMs": 1495210,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "كان ينظر الى جنان الآخرة التي لا تفنى."
    } ]
  }, {
    "tStartMs": 1498810,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "التي لا تزول ولا تحول."
    } ]
  }, {
    "tStartMs": 1501240,
    "dDurationMs": 7110,
    "segs": [ {
      "utf8": "أما جنان الدنيا حتى وإن بقيت ولم تهلك باي\nنوع من انواع العواصف او الكوارث."
    } ]
  }, {
    "tStartMs": 1508680,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "في النهاية ستزول."
    } ]
  }, {
    "tStartMs": 1510720,
    "dDurationMs": 7180,
    "segs": [ {
      "utf8": "ولذا ربي بدأ في بداية سورة الكهف وإنا\nلجاعلون ما عليها صعيدا جرزا."
    } ]
  }, {
    "tStartMs": 1518200,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "خلاص القضية منتهية."
    } ]
  }, {
    "tStartMs": 1520870,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "كل ما على الأرض إلى زوال."
    } ]
  }, {
    "tStartMs": 1523900,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "البقاء الحقيقي هو لجنان الآخرة."
    } ]
  }, {
    "tStartMs": 1527500,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "ولذا هذا الرجل المتواضع البسيط نجح في فتنة\nالرزق."
    } ]
  }, {
    "tStartMs": 1533170,
    "dDurationMs": 6540,
    "segs": [ {
      "utf8": "كيف نجح؟ أن قلة الرزق لم تجعله يصل الى مرحلة\nالسخط على ربه."
    } ]
  }, {
    "tStartMs": 1539740,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "بل على العكس جاءته."
    } ]
  }, {
    "tStartMs": 1541990,
    "dDurationMs": 5550,
    "segs": [ {
      "utf8": "جعلته يرتقي وينجح ويمر ويعبر ليصل الى مرحلة\nالرضا."
    } ]
  }, {
    "tStartMs": 1547930,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "وهذا هو النجاح."
    } ]
  }, {
    "tStartMs": 1549730,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "النجاح الحقيقي."
    } ]
  }, {
    "tStartMs": 1551530,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "اني حين أبتلى بضيق في الرزق."
    } ]
  }, {
    "tStartMs": 1554770,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "اي شيء ممكن."
    } ]
  }, {
    "tStartMs": 1556150,
    "dDurationMs": 7650,
    "segs": [ {
      "utf8": "الله سبحانه وتعالى يمنع عني الاطفال لا يهبني\nاطفال او يمنع عني زواج او يمنع عني او يرزقني"
    } ]
  }, {
    "tStartMs": 1563800,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "باولاد الاولاد فيهم مشكلة او او اي شيء ملك\nسبحانه وتعالى."
    } ]
  }, {
    "tStartMs": 1569830,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "هذا النوع من أنواع الابتلاءات والامتحانات."
    } ]
  }, {
    "tStartMs": 1574300,
    "dDurationMs": 7500,
    "segs": [ {
      "utf8": "عليك أن تحوله بدل أن يصل بك لمرحلة السخط على\nربك وقضائه وحكمه."
    } ]
  }, {
    "tStartMs": 1582220,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "عليك أن يصل بك إلى مرحلة الإيمان وقوة الرضا\nبأمر الله سبحانه وتعالى."
    } ]
  }, {
    "tStartMs": 1589780,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "ويرسل عليها حسبانا من السماء فتصبح صعيدا\nزلقا."
    } ]
  }, {
    "tStartMs": 1594610,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "الرجل الفقير المؤمن."
    } ]
  }, {
    "tStartMs": 1596200,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "الامور كانت واضحة عنده."
    } ]
  }, {
    "tStartMs": 1598510,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "الفتن ما كانت لتغيره."
    } ]
  }, {
    "tStartMs": 1600970,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "لماذا؟ هذا أثر التوحيد والإيمان."
    } ]
  }, {
    "tStartMs": 1604270,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "هذا ما تريده سورة الكهف."
    } ]
  }, {
    "tStartMs": 1606160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "أن تصنعه في قلبي وقلبك."
    } ]
  }, {
    "tStartMs": 1609220,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "أو يصبح ماؤها غورا."
    } ]
  }, {
    "tStartMs": 1610870,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "فلن تستطيع له طلبا."
    } ]
  }, {
    "tStartMs": 1612820,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "يا صاحب الجنتين."
    } ]
  }, {
    "tStartMs": 1614680,
    "dDurationMs": 9090,
    "segs": [ {
      "utf8": "من الذي أجرى لك النهر يا صاحب الجنتين؟ من\nالذي أخرج لك الماء وجعله متدفقا ولم يذهب به"
    } ]
  }, {
    "tStartMs": 1623770,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "في جوف الأرض؟ يا صاحب الجنتين."
    } ]
  }, {
    "tStartMs": 1626530,
    "dDurationMs": 6830,
    "segs": [ {
      "utf8": "من الذي أعطاك الآية التي تليها مباشرة لم\nتأخذ أبدا آيات كثيرة."
    } ]
  }, {
    "tStartMs": 1633540,
    "dDurationMs": 9420,
    "segs": [ {
      "utf8": "مباشرة جاءت الآية واحيط بثمره هذا الرجل الذي\nكان قبل قليل يقول ما أظن أن تبيد هذه أبدا"
    } ]
  }, {
    "tStartMs": 1643260,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "أحيط بثمره."
    } ]
  }, {
    "tStartMs": 1644610,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "انتهت الجنتان."
    } ]
  }, {
    "tStartMs": 1647130,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "أصبحت قضية منتهية."
    } ]
  }, {
    "tStartMs": 1648600,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "اصبحت ماضي. اصبحت ذكرى."
    } ]
  }, {
    "tStartMs": 1650850,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "ولنا ان نتساءل كم من مغرور مغتر بجاهه."
    } ]
  }, {
    "tStartMs": 1655770,
    "dDurationMs": 7080,
    "segs": [ {
      "utf8": "وبنفسه وبماله وسلطته وملكه وعرشه زلزل العرش\nمن تحت قدميه."
    } ]
  }, {
    "tStartMs": 1663990,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "كم. كم من مغتر بماله وحاشيته أخذ عنه كل شيء."
    } ]
  }, {
    "tStartMs": 1669990,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "وسلب منه كل شيء."
    } ]
  }, {
    "tStartMs": 1672000,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "فاصبح يقلب كفيه حسرة وندامة."
    } ]
  }, {
    "tStartMs": 1675510,
    "dDurationMs": 6300,
    "segs": [ {
      "utf8": "هذه في الدنيا ليس في الآخرة على ما أنفق فيها\nوهي خاوية على عروشها."
    } ]
  }, {
    "tStartMs": 1682050,
    "dDurationMs": 7810,
    "segs": [ {
      "utf8": "ووصل إلى الحقيقة التي لا ينبغي أن تغيب عن قلب\nإنسان بانسان يقظ يريد العصمة من من الفتن."
    } ]
  }, {
    "tStartMs": 1690400,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "يا ليتني لم اشرك بربي احدا."
    } ]
  }, {
    "tStartMs": 1693340,
    "dDurationMs": 9480,
    "segs": [ {
      "utf8": "اذا الشرك ما من عمل يمكن ان يستجلب النقم\nوالعذاب والابتلاء في الدنيا كالشرك بالله عز"
    } ]
  }, {
    "tStartMs": 1702940,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "وجل وعدم تمحيص التوحيد."
    } ]
  }, {
    "tStartMs": 1705730,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "يا ليتني لم اشرك بربي احدا."
    } ]
  }, {
    "tStartMs": 1708610,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "اذا اكتشف صاحب الجنتين بعد فوات الاوان."
    } ]
  }, {
    "tStartMs": 1712720,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "بعد انقضاء المحنة."
    } ]
  }, {
    "tStartMs": 1714670,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "بعد انقضاء الفتنة."
    } ]
  }, {
    "tStartMs": 1716560,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "بعد انقضاء الامتحان."
    } ]
  }, {
    "tStartMs": 1718090,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "بعد ان قيل خلاص ضاع القلم."
    } ]
  }, {
    "tStartMs": 1720190,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "انتهى الوقت اكتشف انه كان على خطأ."
    } ]
  }, {
    "tStartMs": 1724090,
    "dDurationMs": 7620,
    "segs": [ {
      "utf8": "اكتشف ان اعظم جريمة ارتكبها في حق نفسه ظلمه\nلنفسه ببعده عن الله سبحانه وتعالى."
    } ]
  }, {
    "tStartMs": 1731740,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "عدم توحيده واشراكه ولم تكن له فئه ينصرونه."
    } ]
  }, {
    "tStartMs": 1736030,
    "dDurationMs": 9530,
    "segs": [ {
      "utf8": "تلك الفئة العزوة الحاشية التي كان يستنصر بها\nوكان يقول انا اكثر منك مالا ويغتال بها وأعز"
    } ]
  }, {
    "tStartMs": 1745560,
    "dDurationMs": 9450,
    "segs": [ {
      "utf8": "نفرا انتهت لم تكن له فئه ينصرونه من دون الله\nوما كان منتصرا هنالك الولايه"
    } ]
  }, {
    "tStartMs": 1755010,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "لله الحق هو خير ثوابا وخير عقبا."
    } ]
  }, {
    "tStartMs": 1759540,
    "dDurationMs": 7980,
    "segs": [ {
      "utf8": "انظر الى هذه الايات العظيمه ماذا تصنع في\nنفسي شيء طبيعي بعد كل تدبر وقفات مع هذه الايه"
    } ]
  }, {
    "tStartMs": 1767880,
    "dDurationMs": 7170,
    "segs": [ {
      "utf8": "اني انا ابدا استشعر معاني النور الذي تضيئه\nفي قلبي وفي صدري سوره الكهف العظيمه."
    } ]
  }, {
    "tStartMs": 1775200,
    "dDurationMs": 8010,
    "segs": [ {
      "utf8": "شيء طبيعي كثره الرزق وفتح ابواب الدنيا لا\nتدل على رضا الله عز وجل ولا تدل على ان هذا"
    } ]
  }, {
    "tStartMs": 1783210,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "الانسان كريم عند ربه."
    } ]
  }, {
    "tStartMs": 1785580,
    "dDurationMs": 7500,
    "segs": [ {
      "utf8": "كما ان قله الرزق او ضيق ذات اليد لسبب او\nلاخر لا تدل على ان الله لا يحبك."
    } ]
  }, {
    "tStartMs": 1793080,
    "dDurationMs": 9870,
    "segs": [ {
      "utf8": "ربك يحبك ربك قد يمنع عنك ليعطيك وقد يعطيك\nويبتليك وعليك في كلتا الحالتين ان تنجح"
    } ]
  }, {
    "tStartMs": 1802950,
    "dDurationMs": 9560,
    "segs": [ {
      "utf8": "في الامتحان وأن تتعلم كيف تجيب على أسئلة تلك\nالامتحانات قولا وفعلا ورضا وعطاء"
    } ]
  }, {
    "tStartMs": 1812780,
    "dDurationMs": 6150,
    "segs": [ {
      "utf8": "واخذا بالاسباب، مع إدراك أن قدرة الله سبحانه\nوتعالى مطلقة."
    } ]
  }, {
    "tStartMs": 1819230,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "ولذا جاءت الآية التي تليها."
    } ]
  }, {
    "tStartMs": 1822800,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "واضرب لهم مثل الحياه الدنيا."
    } ]
  }, {
    "tStartMs": 1825320,
    "dDurationMs": 9030,
    "segs": [ {
      "utf8": "الدنيا التي تغترون بها كماء أنزلناه من\nالسماء فاختلط به نبات الارض فاصبح هشيما تذروه"
    } ]
  }, {
    "tStartMs": 1834350,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "الرياح. وكان الله على كل شيء مقتدرا."
    } ]
  }, {
    "tStartMs": 1837890,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "هذه الدنيا التي قد شغلتكم وشغلتكم بها أخذا\nوردا وعطاءا صعودا ونزولا."
    } ]
  }, {
    "tStartMs": 1845330,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "وهذا وهذا وذاك."
    } ]
  }, {
    "tStartMs": 1847460,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "هذه الدنيا لا قيمة لها."
    } ]
  }, {
    "tStartMs": 1850370,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "مختصرها في آية واحدة كماء انزلناه من السماء\nفاختلط به نبات الأرض."
    } ]
  }, {
    "tStartMs": 1857180,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "ثم ماذا؟ في آية واحدة اصبح هشيما تذروه\nالرياح."
    } ]
  }, {
    "tStartMs": 1861730,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "انتهى. وكان الله على كل شيء مقتدرا."
    } ]
  }, {
    "tStartMs": 1865780,
    "dDurationMs": 5970,
    "segs": [ {
      "utf8": "اذن من السعيد فيها يا رب السعيد الذي يتزود\nمنها باحسن العمل."
    } ]
  }, {
    "tStartMs": 1872050,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "ومن الشقي ليس الذي حرم او قتر عليه."
    } ]
  }, {
    "tStartMs": 1875680,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "الرزق فيها ليس الذي ظلم ولم يستطع ان يرد\nالظلم عنه."
    } ]
  }, {
    "tStartMs": 1880420,
    "dDurationMs": 9600,
    "segs": [ {
      "utf8": "ليس هذا وذاك الشقي الحقيقي في هذه الدنيا من\nخرج منها وهو يعتقد انه يحسن العمل"
    } ]
  }, {
    "tStartMs": 1890020,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "والله قد اضل سعيه."
    } ]
  }, {
    "tStartMs": 1891880,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "كما ستاتي الايات الاخيره في سوره الكهف."
    } ]
  }, {
    "tStartMs": 1895540,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "السعيد الحقيقي هو الذي ياخذ الدنيا على انها\nفرصه وغنيمه يغتنم منها كل ثانيه وكل لحظه"
    } ]
  }, {
    "tStartMs": 1905530,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "فلا تمر عليه ولا ترمش عينه ابدا الا بذكر لله\nسبحانه في قلبه او على لسانه او بفعله وسلوكه."
    } ]
  }, {
    "tStartMs": 1915400,
    "dDurationMs": 7890,
    "segs": [ {
      "utf8": "جعل الدنيا ميدانا للاعمال الصالحه سباقا\nيتسابق فيه ليس لجمع الأموال ولا للزيادة من"
    } ]
  }, {
    "tStartMs": 1923290,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "مدح ولا ثناء الناس ولا جري ولا لهث وراء\nمتاعها الزائل الذي لا قيمة له."
    } ]
  }, {
    "tStartMs": 1929980,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "وإنما سعيا في الخيرات."
    } ]
  }, {
    "tStartMs": 1932170,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "وعملا للصالحات."
    } ]
  }, {
    "tStartMs": 1933970,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "وإرضاء لرب يجازي بالخير خيرا واحسانا."
    } ]
  }, {
    "tStartMs": 1938230,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "رب رحمن رحيم كريم."
    } ]
  }, {
    "tStartMs": 1940840,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "قدرته مطلقة."
    } ]
  }, {
    "tStartMs": 1942190,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "وكان الله على كل شيء مقتدرا."
    } ]
  }, {
    "tStartMs": 1946810,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "ثم إن من أعظم أسباب النجاة من كل الفتن."
    } ]
  }, {
    "tStartMs": 1950590,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "فتنة الرزق."
    } ]
  }, {
    "tStartMs": 1951730,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "فتنة الدين. فتنة كل الفتن."
    } ]
  }, {
    "tStartMs": 1955030,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "أن أدرك حقيقة الدنيا."
    } ]
  }, {
    "tStartMs": 1956740,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "وألا تغيب تلك الحقيقة عن عيني وعن ناظري."
    } ]
  }, {
    "tStartMs": 1961150,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "انظر للآية التي تليها."
    } ]
  }, {
    "tStartMs": 1963100,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "المال والبنون زينة الحياة الدنيا."
    } ]
  }, {
    "tStartMs": 1966880,
    "dDurationMs": 7050,
    "segs": [ {
      "utf8": "زينة. ما الذي ستأخذه معك؟ انظر إلى كل من\nقبلك وكل من سيأتون بعدك."
    } ]
  }, {
    "tStartMs": 1973960,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "انظر نظرة متدبر."
    } ]
  }, {
    "tStartMs": 1975970,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "انظر نظرة انسان."
    } ]
  }, {
    "tStartMs": 1978000,
    "dDurationMs": 8040,
    "segs": [ {
      "utf8": "لم تشغله الحياه بحيث انه لا تعطيه ولو حتى\nلحظات يسكن فيها الى نفسه ويتدبر في هذا الخلق"
    } ]
  }, {
    "tStartMs": 1986040,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "وفي هذه الدنيا."
    } ]
  }, {
    "tStartMs": 1987630,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "سوره الكهف توقظ الانسان الغافل."
    } ]
  }, {
    "tStartMs": 1990690,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "توقظ الجاهل."
    } ]
  }, {
    "tStartMs": 1992070,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "توقظ المغتر."
    } ]
  }, {
    "tStartMs": 1993690,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "المال والبنون زينه الحياه."
    } ]
  }, {
    "tStartMs": 1996030,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "الدنيا زينه والدنيا هي كلها ستنتهي."
    } ]
  }, {
    "tStartMs": 1999900,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "والباقيات الصالحات خير عند ربك ثوابا وخير\nاملا."
    } ]
  }, {
    "tStartMs": 2005270,
    "dDurationMs": 8070,
    "segs": [ {
      "utf8": "وقد تكون تلك الباقيات الصالحات قولك سبحان\nالله والحمد لله ولا اله الا الله والله اكبر"
    } ]
  }, {
    "tStartMs": 2013670,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "خير مما طلعت عليه الشمس خير من كل شيء."
    } ]
  }, {
    "tStartMs": 2018170,
    "dDurationMs": 9960,
    "segs": [ {
      "utf8": "مجرد ان تقول بقلب صادق الحمد لله الم نقل قبل\nقليل في بدايه السوره في الحديث كيف من قال"
    } ]
  }, {
    "tStartMs": 2028130,
    "dDurationMs": 8610,
    "segs": [ {
      "utf8": "توضا فاحسن الوضوء وقام وقال سبحانك اللهم\nاشهد ان لا اله الا انت أنت أستغفرك وأتوب"
    } ]
  }, {
    "tStartMs": 2036770,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "إليك. هذه الكلمات ليست مجرد كلمات."
    } ]
  }, {
    "tStartMs": 2040550,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "هذه الكلمات تشكل قمة التوحيد."
    } ]
  }, {
    "tStartMs": 2044330,
    "dDurationMs": 8910,
    "segs": [ {
      "utf8": "وقمة شعوري بأني لابد أن أسبح الله أن أستغفر\nوضعت في رق وختم عليه لا يكسر إلى يوم القيامة"
    } ]
  }, {
    "tStartMs": 2053690,
    "dDurationMs": 5940,
    "segs": [ {
      "utf8": "متى يوم القيامة يوم يفرح المؤمنون بأي شيء\nبثواب الله."
    } ]
  }, {
    "tStartMs": 2059930,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "بنصره برزقه."
    } ]
  }, {
    "tStartMs": 2061850,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "بجنانه. بقصوره ببيوته."
    } ]
  }, {
    "tStartMs": 2065000,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "هذا الفضل الذي يفرح به المؤمن."
    } ]
  }, {
    "tStartMs": 2067220,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "فضل الله ورحمته خير مما يجمعون."
    } ]
  }, {
    "tStartMs": 2070460,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "هذه حقيقة توقظ عيني عليها."
    } ]
  }, {
    "tStartMs": 2074030,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "وبصري وبصيرتي سورة الكهف."
    } ]
  }, {
    "tStartMs": 2076730,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "ثم مباشرة ينتهي الكلام ليبين لي ويحضر مشهد\nالآخرة."
    } ]
  }, {
    "tStartMs": 2084410,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "لماذا هذا الانتقال السريع في سورة الكهف."
    } ]
  }, {
    "tStartMs": 2087740,
    "dDurationMs": 8630,
    "segs": [ {
      "utf8": "والربط المتواصل مع مشاهد الآخرة؟ لأنه يريد\nأن يجعل الدنيا عندي شيء بسيط هي بسيطه الدنيا"
    } ]
  }, {
    "tStartMs": 2096640,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "قيمتها الحقيقيه في الأعمال التي أقوم بها\nوليس في قيمتها المادية."
    } ]
  }, {
    "tStartMs": 2101860,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "القيمة المادية حتى وإن دامت لا قيمة لها\nمباشرة."
    } ]
  }, {
    "tStartMs": 2107170,
    "dDurationMs": 7800,
    "segs": [ {
      "utf8": "ويوم نسير الجبال وترى الأرض الجبال بقوتها\nبسكونها أنا كإنسان."
    } ]
  }, {
    "tStartMs": 2115000,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "أنا الإنسان الذي اغتر أحيانا بنفسي."
    } ]
  }, {
    "tStartMs": 2118360,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "انا صخرة بسيطة لا استطيع ان احملها."
    } ]
  }, {
    "tStartMs": 2121750,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "اليس كذلك؟ صخره صخره لا استطيع ان احملها."
    } ]
  }, {
    "tStartMs": 2126010,
    "dDurationMs": 9690,
    "segs": [ {
      "utf8": "الجبال بطولها وعرضها وثباتها يسيرها ربي\nسبحانه وترى الارض بارزه وتأملوا معي وترى"
    } ]
  }, {
    "tStartMs": 2135940,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "كل شيء حاضر امام عينيك."
    } ]
  }, {
    "tStartMs": 2138040,
    "dDurationMs": 9660,
    "segs": [ {
      "utf8": "لماذا؟ ليشحن القلب بشحنة ايمانيه تستحضر\nمشاهد القيامة وحشرناهم فلم نغادر منهم احدا."
    } ]
  }, {
    "tStartMs": 2148300,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "حشرنا الكل كل من خلقه الله عز وجل ولا واحد\nيترك سبحانه قدرته العظيمه المطلقه في"
    } ]
  }, {
    "tStartMs": 2158020,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "كل شيء قادر مسيطر على ملكه وخلقه."
    } ]
  }, {
    "tStartMs": 2162910,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "وعرضوا على ربك صفا ياتي الاستعراض."
    } ]
  }, {
    "tStartMs": 2165940,
    "dDurationMs": 9570,
    "segs": [ {
      "utf8": "انظر الى التواصل ها تواصل مستمر بين مشاهد\nالدنيا والاخره وعرضوا على ربك صفا اه وقفنا صف"
    } ]
  }, {
    "tStartMs": 2175870,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "امام الله عز وجل دون ان يغادر منا احد لا من\nقريب ولا من بعيد."
    } ]
  }, {
    "tStartMs": 2181450,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "احصاهم وعدهم عدا."
    } ]
  }, {
    "tStartMs": 2184270,
    "dDurationMs": 9000,
    "segs": [ {
      "utf8": "ما في احد ممكن ان يتخلف لقد جئتمونا كما\nخلقناكم اول مره بل زعمتم الن نجعل لكم موعدا."
    } ]
  }, {
    "tStartMs": 2193300,
    "dDurationMs": 9990,
    "segs": [ {
      "utf8": "هذا الانسان المغرور الذي تغيب عن عينيه\nالاخره يعتقد انه لن يعود لربه سبحانه ونحن"
    } ]
  }, {
    "tStartMs": 2203290,
    "dDurationMs": 8100,
    "segs": [ {
      "utf8": "نرى ونشهد في بعض الاحيان تخرج منا حتى نحن\nكبشر تصرفات ونحن نؤمن بالله ونقرأ سورة الكهف"
    } ]
  }, {
    "tStartMs": 2211570,
    "dDurationMs": 6750,
    "segs": [ {
      "utf8": "تصدر منا في بعض الاحيان تصرفات لا يمكن ان\nتشي بان هذا الانسان يؤمن باليوم الاخر."
    } ]
  }, {
    "tStartMs": 2218530,
    "dDurationMs": 7410,
    "segs": [ {
      "utf8": "صحيح انا اؤمن بي باللسان وكلشي وبقلبي اؤمن\nلكن احيانا اتصرف تصرفات من لا يؤمن بالله"
    } ]
  }, {
    "tStartMs": 2227350,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "والعياذ بالله."
    } ]
  }, {
    "tStartMs": 2228490,
    "dDurationMs": 6090,
    "segs": [ {
      "utf8": "كيف؟ حين أنسى الله سبحانه وتعالى حين لا اؤدي\nالامانات الى اهلها."
    } ]
  }, {
    "tStartMs": 2234700,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "حين أبخس الناس حقوقهم."
    } ]
  }, {
    "tStartMs": 2236470,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "وكأني لن ارد الى ربي."
    } ]
  }, {
    "tStartMs": 2238330,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "فيسألني ربي سيسألني عن كل شيء."
    } ]
  }, {
    "tStartMs": 2241720,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "وتأملوا الاية التي تليها."
    } ]
  }, {
    "tStartMs": 2243970,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "ووضع الكتاب."
    } ]
  }, {
    "tStartMs": 2245620,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "فترى المجرمين كل شيء في كتاب."
    } ]
  }, {
    "tStartMs": 2248440,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "لا أستطيع أن أنكر."
    } ]
  }, {
    "tStartMs": 2250360,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "انظر الى السلطان بينها شهادة مكتوبة موثقة\nبالتفاصيل."
    } ]
  }, {
    "tStartMs": 2257290,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "باليوم. بالليلة بالساعة."
    } ]
  }, {
    "tStartMs": 2259900,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "فعلت كذا."
    } ]
  }, {
    "tStartMs": 2260980,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "قلت كذا. ويقولون يا ويلتنا."
    } ]
  }, {
    "tStartMs": 2264250,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "رأى المجرمون الكتاب."
    } ]
  }, {
    "tStartMs": 2266560,
    "dDurationMs": 6770,
    "segs": [ {
      "utf8": "فماذا قالوا؟ يا ويلتنا مال هذا الكتاب لا\nيغادر صغيرة ولا كبيرة."
    } ]
  }, {
    "tStartMs": 2273330,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "وقال بعض المفسرين."
    } ]
  }, {
    "tStartMs": 2275280,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "الصغيرة هي اي شيء."
    } ]
  }, {
    "tStartMs": 2276930,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "هي مجرد اني انا."
    } ]
  }, {
    "tStartMs": 2278310,
    "dDurationMs": 8730,
    "segs": [ {
      "utf8": "ابتسم بسمة مجرد ان ابتسم لان هذه الابتسامة\nوراها شيء ممكن يكون سخرية بأحد من الناس."
    } ]
  }, {
    "tStartMs": 2287040,
    "dDurationMs": 8850,
    "segs": [ {
      "utf8": "ممكن ان يكون استقلالا باحد ممكن تصغيرا\nاحتقارا وممكن ان يكون صداقة ومواساة والمؤاخاة"
    } ]
  }, {
    "tStartMs": 2295950,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "واقبال على الاخرين لتفريج همومهم وقربهم."
    } ]
  }, {
    "tStartMs": 2299910,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "من الذي يعلم نيتي وانا ابتسم ربي."
    } ]
  }, {
    "tStartMs": 2303870,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "سبحان المطلع على كل شيء وكل شيء عنده بمقدار\nوكل شيء عنده مكتوب."
    } ]
  }, {
    "tStartMs": 2310080,
    "dDurationMs": 9570,
    "segs": [ {
      "utf8": "وقالوا ويقولون يا ويلتنا مال هذا الكتاب لا\nيغادر صغيرة ولا كبيرة إلا أحصاها."
    } ]
  }, {
    "tStartMs": 2320370,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "ليس فقط مجرد كتابة."
    } ]
  }, {
    "tStartMs": 2322290,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "لا هو احصاها."
    } ]
  }, {
    "tStartMs": 2325170,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "كل شيء مكتوب."
    } ]
  }, {
    "tStartMs": 2326220,
    "dDurationMs": 7860,
    "segs": [ {
      "utf8": "انا نسيت بحكم اني أقوم بأشياء متعددة ولكن كل\nشيء عند ربي في كتاب لا يضل ربي ولا ينسى"
    } ]
  }, {
    "tStartMs": 2334260,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "ووجدوا ما عملوا حاضرا."
    } ]
  }, {
    "tStartMs": 2337560,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "كل شيء. الدنيا بكل."
    } ]
  }, {
    "tStartMs": 2339690,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "بكل ما فيها موجودة في هذا الكتاب."
    } ]
  }, {
    "tStartMs": 2343020,
    "dDurationMs": 7320,
    "segs": [ {
      "utf8": "اين ذهبت لذة النعيم الذي كنت فيه؟ أين ذهبت\nلذة الأموال التي كنت أجمعها يمينا وشمالا."
    } ]
  }, {
    "tStartMs": 2350760,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "الحلال والحرام."
    } ]
  }, {
    "tStartMs": 2352410,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "والربا والاختلاس."
    } ]
  }, {
    "tStartMs": 2354150,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "واخذ حقوق الناس."
    } ]
  }, {
    "tStartMs": 2355830,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "وعدم اخراج الزكاة واكل اموال الناس بالباطل."
    } ]
  }, {
    "tStartMs": 2359670,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "اين ذهبت؟ راحت انتهت وبقيت الحسره والندامه."
    } ]
  }, {
    "tStartMs": 2364680,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "وبقي الجزاء على العمل."
    } ]
  }, {
    "tStartMs": 2366660,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "ووجدوا ما عملوا حاضرا ولا يظلم ربك احدا."
    } ]
  }, {
    "tStartMs": 2371190,
    "dDurationMs": 8610,
    "segs": [ {
      "utf8": "الله يا رب ما اعدلك وما اعظمك واي رب ربي\nالذي لا يظلم عباده وهو مقتدر عليهم."
    } ]
  }, {
    "tStartMs": 2379950,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "بالله عليكم."
    } ]
  }, {
    "tStartMs": 2381300,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "نحن اليوم كبشر احيانا نملك شيئا من متاع\nالدنيا."
    } ]
  }, {
    "tStartMs": 2386120,
    "dDurationMs": 8280,
    "segs": [ {
      "utf8": "شيء بسيط احيانا يدخل تحت ايدينا بحكم الخدمه\nاو بحكم الوظيفه او بشيء احد من الناس تحت"
    } ]
  }, {
    "tStartMs": 2394400,
    "dDurationMs": 9240,
    "segs": [ {
      "utf8": "ايدينا. هل نراعي الله عز وجل فيهم؟ كيف نراعي\nربي سبحانه وتعالى؟ انظر الى قوله ولا يظلم ربك"
    } ]
  }, {
    "tStartMs": 2403640,
    "dDurationMs": 9870,
    "segs": [ {
      "utf8": "احدا ولله المثل الاعلى هو قوي وقادر ولكنه لا\nيظلم اقام دعائم مملكته على العدل والعداله"
    } ]
  }, {
    "tStartMs": 2413930,
    "dDurationMs": 8790,
    "segs": [ {
      "utf8": "بينما البشر في بعض الاحيان قد يقيم على الظلم\nويغتر بقوته وسلطته ولكن الخالق سبحانه له"
    } ]
  }, {
    "tStartMs": 2422720,
    "dDurationMs": 8610,
    "segs": [ {
      "utf8": "المثل الاعلى يربينا يعلمني ان السلطه والقوه\nابتلاء وعليك ان لا تظلم حين تقوى عليك."
    } ]
  }, {
    "tStartMs": 2431450,
    "dDurationMs": 8430,
    "segs": [ {
      "utf8": "القوه نفسها في حد ذاتها هي ابتلاء علي حين\nامتلك اسباب القوه ألا أقع في ظلم احد."
    } ]
  }, {
    "tStartMs": 2440540,
    "dDurationMs": 8850,
    "segs": [ {
      "utf8": "ثم تأتي في سياق الآيات الى الشيء الاساس وراء\nقضية الفتن والابتلاءات."
    } ]
  }, {
    "tStartMs": 2449420,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "قصة آدم الخلق."
    } ]
  }, {
    "tStartMs": 2452720,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "قصة الصراع الذي سيبقى بين الحق والباطل."
    } ]
  }, {
    "tStartMs": 2455990,
    "dDurationMs": 8730,
    "segs": [ {
      "utf8": "الشيطان. وإذ قلنا للملائكة اسجدوا لآدم\nفسجدوا إلا إبليس كان من الجن ففسق عن امر ربه"
    } ]
  }, {
    "tStartMs": 2465320,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "افتتخذونه وذريته اولياء في استنكار عجيب."
    } ]
  }, {
    "tStartMs": 2469760,
    "dDurationMs": 9030,
    "segs": [ {
      "utf8": "انظر الى القران كيف يربي انظروا الى ايات\nسورة الكهف كيف تقيم في نفسي هذه المشاعر"
    } ]
  }, {
    "tStartMs": 2478790,
    "dDurationMs": 8070,
    "segs": [ {
      "utf8": "العظيمة افتتخذونه وذريته اولياء من دوني\nتريدون لكم وليا من دون الله."
    } ]
  }, {
    "tStartMs": 2487190,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "ودعونا نربط مع قصة صاحب الجنتين."
    } ]
  }, {
    "tStartMs": 2490970,
    "dDurationMs": 6510,
    "segs": [ {
      "utf8": "هنالك الولايه لله الحق الذي اعتز بحاشيته\nالذي اعتز بقومه من حوله."
    } ]
  }, {
    "tStartMs": 2497480,
    "dDurationMs": 9650,
    "segs": [ {
      "utf8": "فاذله الله انا بمن اعتز أنا من أوالي أوالي\nالشيطان وهم لكم عدو بئس للظالمين بدلا."
    } ]
  }, {
    "tStartMs": 2507490,
    "dDurationMs": 6300,
    "segs": [ {
      "utf8": "استبدل من بمن خالقي سبحانه وتعالى أبدله بمن\nجل في علاه."
    } ]
  }, {
    "tStartMs": 2514420,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "أستبدل الشيطان بخالقي سبحانه والشيطان وهو\nعدو."
    } ]
  }, {
    "tStartMs": 2519910,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "وأنا أعلم أنه عدو."
    } ]
  }, {
    "tStartMs": 2521920,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "وأترك موالاة الله سبحانه وتعالى."
    } ]
  }, {
    "tStartMs": 2524500,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "لكن الموالاة ليست مجرد كلمة تقال باللسان."
    } ]
  }, {
    "tStartMs": 2529090,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "الموالاة فعل الموالاة سلوك."
    } ]
  }, {
    "tStartMs": 2531970,
    "dDurationMs": 9450,
    "segs": [ {
      "utf8": "فما قيمة أن أقول إن وليي الله الذي نزل\nالكتاب وهو يتولى الصالحين وأرددها بلساني ولكن"
    } ]
  }, {
    "tStartMs": 2541420,
    "dDurationMs": 8400,
    "segs": [ {
      "utf8": "أفعالي أبدا لا تعطي هذا المعنى ولا تعكس معنى\nالموالاة معنى الشعور والإحساس أن أوالي كل ما"
    } ]
  }, {
    "tStartMs": 2549820,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "يأمر به الله سبحانه وتعالى."
    } ]
  }, {
    "tStartMs": 2552220,
    "dDurationMs": 6150,
    "segs": [ {
      "utf8": "هذا المعنى العظيم أحتاج أن أعزه في قلبي وفي\nنفسي في سورة الكهف."
    } ]
  }, {
    "tStartMs": 2559990,
    "dDurationMs": 6960,
    "segs": [ {
      "utf8": "وينتهي الكلام الى ان يصل عن قضيه النار وراى\nالمجرمون النار فظنوا انهم مواقعوها."
    } ]
  }, {
    "tStartMs": 2567400,
    "dDurationMs": 5790,
    "segs": [ {
      "utf8": "والقضايا كلها تبين لي مشاهد القيامه حاضره\nامام عيني."
    } ]
  }, {
    "tStartMs": 2573220,
    "dDurationMs": 8340,
    "segs": [ {
      "utf8": "احتاج احتاج وانا في خضم الصراعات والفتن\nوالمحن والانشغال بالدنيا ان استحضر الاخره"
    } ]
  }, {
    "tStartMs": 2581560,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "امام عيني. ولقد صرفنا العودة من جديد الى\nالقرآن العظيم."
    } ]
  }, {
    "tStartMs": 2587260,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "العصمة من الفتن."
    } ]
  }, {
    "tStartMs": 2588790,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "ولقد صرفنا في هذا القران للناس من كل مثل."
    } ]
  }, {
    "tStartMs": 2593590,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "ما من موقف."
    } ]
  }, {
    "tStartMs": 2594970,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "وما من محنة. وما من فتنة."
    } ]
  }, {
    "tStartMs": 2597280,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "وما من ابتلاء يمر بك في حياتك."
    } ]
  }, {
    "tStartMs": 2600670,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "إلا ستجد في القرآن ملاذا."
    } ]
  }, {
    "tStartMs": 2604000,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "الا ستجد في القرآن اجابة."
    } ]
  }, {
    "tStartMs": 2606850,
    "dDurationMs": 8640,
    "segs": [ {
      "utf8": "الا ستجد في القرآن نورا يهديك نورا ينير به\nالله عز وجل ويفتح به على قلبك وبصيرتك وحياتك."
    } ]
  }, {
    "tStartMs": 2615700,
    "dDurationMs": 6180,
    "segs": [ {
      "utf8": "وكان الانسان اكثر شيء جدلا وما منع الناس ان\nيؤمنوا اذ جاءهم الهدى."
    } ]
  }, {
    "tStartMs": 2622030,
    "dDurationMs": 8610,
    "segs": [ {
      "utf8": "سنه من سنن الله عز وجل ربي سبحانه في هذه\nالايات يفتح الابواب بعد كل المعاصي بعد كل ما"
    } ]
  }, {
    "tStartMs": 2630640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "ذكر من ذنوب عباده."
    } ]
  }, {
    "tStartMs": 2632530,
    "dDurationMs": 8490,
    "segs": [ {
      "utf8": "باب التوبه والرحمه مفتوح سبحانه لا يغلق يحب\nعباده يتقرب اليهم بالنعم سبحانه وتعالى"
    } ]
  }, {
    "tStartMs": 2641020,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "ويعطيهم الفرصه تلو الاخرى."
    } ]
  }, {
    "tStartMs": 2644890,
    "dDurationMs": 7650,
    "segs": [ {
      "utf8": "وما نرسل المرسلين الا مبشرين ومنذرين ويجادل\nالذين كفروا بالباطل ليدحضوا به الحق."
    } ]
  }, {
    "tStartMs": 2652540,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "وتأملوا معي كم مره في سوره الكهف يذكر الحق."
    } ]
  }, {
    "tStartMs": 2657250,
    "dDurationMs": 9480,
    "segs": [ {
      "utf8": "الحق الحق الحق احق ان يتبع الحق احق ان يرى\nويتبع والباطل احق ان"
    } ]
  }, {
    "tStartMs": 2666760,
    "dDurationMs": 6660,
    "segs": [ {
      "utf8": "يزهق ويداس عليه وان يرى بعين عين تعرف معنى\nالحق وقيمه الحق."
    } ]
  }, {
    "tStartMs": 2673780,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "ولذا قال ويجادل الذين كفروا بأي شيء بالباطل."
    } ]
  }, {
    "tStartMs": 2679680,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "المعركة خاسرة لأنها معركة باطل ضد حق."
    } ]
  }, {
    "tStartMs": 2683640,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "واتخذوا اياتي وما انذروا هزوا."
    } ]
  }, {
    "tStartMs": 2686970,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "وتأمل معي الاستنكار كيف يستنكر الله سبحانه\nوتعالى عن عباده المعرضين عنه."
    } ]
  }, {
    "tStartMs": 2694020,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "ومن اظلم ممن ذكر بايات ربه فاعرض عنها\nالإعراض عن الله سبحانه."
    } ]
  }, {
    "tStartMs": 2700800,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "الإعراض عن القرآن."
    } ]
  }, {
    "tStartMs": 2702120,
    "dDurationMs": 6090,
    "segs": [ {
      "utf8": "خاصة حين يقيض الله لك من يذكرك به وأنت تعرض."
    } ]
  }, {
    "tStartMs": 2708570,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "ومن اظلم ممن ذكر بايات ربه."
    } ]
  }, {
    "tStartMs": 2711810,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "وهذا حال الكفار مع النبي صلى الله عليه وسلم."
    } ]
  }, {
    "tStartMs": 2716730,
    "dDurationMs": 8040,
    "segs": [ {
      "utf8": "الله سبحانه ارسل لهم رسول من انفسهم وعزيز\nعليه وحريص على هدايتهم."
    } ]
  }, {
    "tStartMs": 2724770,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "ومع ذلك اعرضوا عنه فاعرض عنها ونسي ما قدمت\nيداه."
    } ]
  }, {
    "tStartMs": 2730020,
    "dDurationMs": 9200,
    "segs": [ {
      "utf8": "ومن أعظم الأعمال التي تورث التخبط والوقوع في\nالفتن والعمى هي أي شيء."
    } ]
  }, {
    "tStartMs": 2739610,
    "dDurationMs": 7980,
    "segs": [ {
      "utf8": "الإعراض عن آيات الله عز وجل سواء منها ما كان\nفي هذا الكتاب العظيم، أو ما كان في الواقع وفي"
    } ]
  }, {
    "tStartMs": 2747590,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "الكون الذي نعيش فيه، ونسي ما قدمت يداه فأصبح\nحاله أي حال."
    } ]
  }, {
    "tStartMs": 2754160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "إنا جعلنا على قلوبهم اكنه."
    } ]
  }, {
    "tStartMs": 2756920,
    "dDurationMs": 9150,
    "segs": [ {
      "utf8": "وتدبروا معي أيها الأخوة والأخوات إعجاز\nالقرآن العظيم في هذه الآية قال إنا جعلنا على"
    } ]
  }, {
    "tStartMs": 2766070,
    "dDurationMs": 9210,
    "segs": [ {
      "utf8": "قلوبهم اكنه كان الجزاء من جنس العمل من جديد\nهو ذكر الله عز وجل، أرسل له من يذكره بآيات"
    } ]
  }, {
    "tStartMs": 2775280,
    "dDurationMs": 8190,
    "segs": [ {
      "utf8": "ربه، ولكنه أعرض بملء إرادته، فماذا كان\nالجزاء؟ جعل الله على قلبه غطاء."
    } ]
  }, {
    "tStartMs": 2783650,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "إنا جعلنا على قلوبهم اكنه."
    } ]
  }, {
    "tStartMs": 2786440,
    "dDurationMs": 9960,
    "segs": [ {
      "utf8": "فأي عدالة أعظم من عدالة الله عز وجل؟ حاشا\nسبحانه عادل حتى مع من كفر به انا جعلنا"
    } ]
  }, {
    "tStartMs": 2796400,
    "dDurationMs": 8520,
    "segs": [ {
      "utf8": "على قلوبهم اكنه ان يفقهوه وفي اذانهم وقرا\nوان تدعهم الى الهدى فلن يهتدوا اذا ابدا."
    } ]
  }, {
    "tStartMs": 2805160,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "خلاص قفل واغلق عند كل منافذ الادراك."
    } ]
  }, {
    "tStartMs": 2810230,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "لا قلب يسمع ويعي ولا عين ترى وتبصر الهدى ولا\nاذن تسمع."
    } ]
  }, {
    "tStartMs": 2816620,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "انتهت القضيه لن يهتدوا ابدا."
    } ]
  }, {
    "tStartMs": 2819650,
    "dDurationMs": 7890,
    "segs": [ {
      "utf8": "وتامل رحمه خالق العباد سبحانه وتعالى الذي\nشملت رحمته كل شيء."
    } ]
  }, {
    "tStartMs": 2827960,
    "dDurationMs": 8130,
    "segs": [ {
      "utf8": "الذي وسعت رحمته حتى الانسان الذي كفر به\nواعرض عنه وربك الغفور ذو الرحمه."
    } ]
  }, {
    "tStartMs": 2836480,
    "dDurationMs": 9120,
    "segs": [ {
      "utf8": "حتى بعد ما اغلقوا كل شيء حتى بعد ما ان هم ما\nيريدوا الهدى يبقى ربي غفور ذو رحمه سبحانه."
    } ]
  }, {
    "tStartMs": 2846860,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "لماذا وربك الغفور ذو الرحمه في هذا الموضع\nبالذات."
    } ]
  }, {
    "tStartMs": 2851450,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "الله عز وجل يريد ان يبقي الباب مفتوحا لعباده\nحتى من كفر به لا تزال لديك فرصه حتى ان"
    } ]
  }, {
    "tStartMs": 2861290,
    "dDurationMs": 7920,
    "segs": [ {
      "utf8": "كنت من المعرضين افرض انك اعرضت طول حياتك عن\nربك سبحانه ثم في يوم من الايام جلست مع نفسك"
    } ]
  }, {
    "tStartMs": 2869210,
    "dDurationMs": 9240,
    "segs": [ {
      "utf8": "وتفكرت في امرك وقلت واتخذت القرار الشجاع\nوقلت والله كفى ظلما لنفسي والله كفى بعدا عن"
    } ]
  }, {
    "tStartMs": 2878450,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "ربي. اريد ان اعود."
    } ]
  }, {
    "tStartMs": 2880580,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "اياك في يوم ان تقنط من رحمه ربك."
    } ]
  }, {
    "tStartMs": 2883940,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "وعليك دائما ان تتيقن ان رحمه خالقك سبحانه\nوتعالى اعظم من ذنوبك التي اذنبت وانك"
    } ]
  }, {
    "tStartMs": 2893780,
    "dDurationMs": 9960,
    "segs": [ {
      "utf8": "مهما اذنبت فان الرحمه هي ابقى واعظم واظهر\nوربك الغفور ذو الرحمه لو يؤاخذهم بما"
    } ]
  }, {
    "tStartMs": 2903740,
    "dDurationMs": 7400,
    "segs": [ {
      "utf8": "كسبوا لعجل لهم العذاب لا يؤجل حليم الحليم\nسبحانه وتعالى يتأنى على عباده."
    } ]
  }, {
    "tStartMs": 2911170,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "عز وجل يمهل ولكن لا يهمل."
    } ]
  }, {
    "tStartMs": 2914920,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "لماذا يمهل."
    } ]
  }, {
    "tStartMs": 2916510,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "الامهال ابتلاء وامتحان."
    } ]
  }, {
    "tStartMs": 2919330,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "الامهال فرصة."
    } ]
  }, {
    "tStartMs": 2921130,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "اعود لخالقي."
    } ]
  }, {
    "tStartMs": 2922360,
    "dDurationMs": 6450,
    "segs": [ {
      "utf8": "استرجع. استرجع نفسي التي ظلمت ولا استمر في\nالغي والظلم والعدوان."
    } ]
  }, {
    "tStartMs": 2930340,
    "dDurationMs": 7860,
    "segs": [ {
      "utf8": "وانظر الى الانتقال السريع بين مصير الافراد\nومصائر الشعوب والامم حين تبتعد وتتخذ قرار"
    } ]
  }, {
    "tStartMs": 2938200,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "الابتعاد عن خالقها وتلك القرى اهلكناهم."
    } ]
  }, {
    "tStartMs": 2942460,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "ولكن متى لما ظلموا اذا هو الظلم."
    } ]
  }, {
    "tStartMs": 2947440,
    "dDurationMs": 7980,
    "segs": [ {
      "utf8": "عادل سبحانه وتعالى في تقرير مصائر الشعوب\nوالامم لا يهلك امه من الامم بدون سبب."
    } ]
  }, {
    "tStartMs": 2955420,
    "dDurationMs": 9180,
    "segs": [ {
      "utf8": "الامم والافراد والشعوب هي التي تقدم اسباب\nهلاكها بين أيديها حين تختار منهجا سوى منهج"
    } ]
  }, {
    "tStartMs": 2964600,
    "dDurationMs": 9360,
    "segs": [ {
      "utf8": "الله سبحانه وتعالى وجعلنا لمهلكهم موعدا كل\nشيء بمقدار فلا تغرنك الحياه الدنيا ولا"
    } ]
  }, {
    "tStartMs": 2973960,
    "dDurationMs": 8340,
    "segs": [ {
      "utf8": "تستبطئ النصر ولا تستبطئ النصر ولا تقل يا رب\nطالت المده يا رب لماذا لم تنصرني لحد الان انا"
    } ]
  }, {
    "tStartMs": 2982300,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "مظلوم لا يا مظلوم لا تستبطئ نصر الله وفرج\nالله سبحانه."
    } ]
  }, {
    "tStartMs": 2987940,
    "dDurationMs": 9570,
    "segs": [ {
      "utf8": "الفرج قادم والنصر قادم ولكن لكل اجل كتاب ولكل\nمهلك قوم او افراد او ظلم"
    } ]
  }, {
    "tStartMs": 2997870,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "موعد عند الله سبحانه وتعالى الذي كل شيء عنده\nبمقدار."
    } ]
  }, {
    "tStartMs": 3005940,
    "dDurationMs": 5910,
    "segs": [ {
      "utf8": "ثم تنتقل الى سياق السوره انتقال عظيم الى قصه\nثانيه."
    } ]
  }, {
    "tStartMs": 3013110,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "قصه موسى عليه السلام قصه موسى عليه السلام مع\nرجل صالح اتاه الله من لدنه من لدنه علما هذا"
    } ]
  }, {
    "tStartMs": 3023600,
    "dDurationMs": 9480,
    "segs": [ {
      "utf8": "السياق أو هذه القصة هي في حد ذاتها تكشف لي\nعن قصص أخرى أو عن فتن أخرى"
    } ]
  }, {
    "tStartMs": 3033260,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "وقعت في قصة موسى مع هذا الرجل الصالح."
    } ]
  }, {
    "tStartMs": 3037400,
    "dDurationMs": 9360,
    "segs": [ {
      "utf8": "كيف موسى عليه السلام أراد أن يتعلم؟ طبعا\nهناك أيضا ذكرت كتب التفاسير أنه قد قال انه"
    } ]
  }, {
    "tStartMs": 3046760,
    "dDurationMs": 8340,
    "segs": [ {
      "utf8": "انا من اكثر الناس علما فاراد الله سبحانه\nوتعالى ان يعلمه وأن يؤدب انبيائه ويؤدب موسى"
    } ]
  }, {
    "tStartMs": 3055100,
    "dDurationMs": 8490,
    "segs": [ {
      "utf8": "عليه السلام من خلال هذا التأديب الرباني ولكل\nالأمم بما فيها من تقرأ القرآن الذين نحن"
    } ]
  }, {
    "tStartMs": 3063590,
    "dDurationMs": 9870,
    "segs": [ {
      "utf8": "اليوم. فموسى عليه السلام الله سبحانه وتعالى\nقال له وأخبره بأن هناك رجلا صالحا سيأتي في"
    } ]
  }, {
    "tStartMs": 3073460,
    "dDurationMs": 7650,
    "segs": [ {
      "utf8": "المكان المحدد عليك أن تتعلم منه وانظر الى\nأدب النبوة من جديد والتواضع لله سبحانه"
    } ]
  }, {
    "tStartMs": 3081110,
    "dDurationMs": 9750,
    "segs": [ {
      "utf8": "وتعالى. الإنسان لا ينبغي مهما أوتي من علم أن\nينسب أي نوع من أنواع العلوم مادية"
    } ]
  }, {
    "tStartMs": 3090860,
    "dDurationMs": 6270,
    "segs": [ {
      "utf8": "علمية. كل شيء لا ينبغي أن ينسبه لنفسه، لا\nينبغي أن ينسب الفضل من جديد."
    } ]
  }, {
    "tStartMs": 3097130,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "توقظني سورة الكهف علي أن أنسبه لمن أنسبه."
    } ]
  }, {
    "tStartMs": 3101360,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "ينسب الفضل لخالقي سبحانه وتعالى."
    } ]
  }, {
    "tStartMs": 3105650,
    "dDurationMs": 7920,
    "segs": [ {
      "utf8": "موسى عليه السلام وصل إلى المكان المحدد فلما\nبلغ مجمع بينهما نسيا حوتهما."
    } ]
  }, {
    "tStartMs": 3113870,
    "dDurationMs": 7860,
    "segs": [ {
      "utf8": "كانت هذه هي العلامة التي يريد موسى أن يلتقي\nمن خلالها بهذا الرجل الصالح الشاهد في"
    } ]
  }, {
    "tStartMs": 3121730,
    "dDurationMs": 6300,
    "segs": [ {
      "utf8": "الموضوع. بدأ فلما جاوزا قال لفتاه اتنا\nغداءنا وصلوا إلى المكان."
    } ]
  }, {
    "tStartMs": 3128480,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "طبعا الفتى أخبره بأنه قد نسي الحوت عند ذلك\nالمكان."
    } ]
  }, {
    "tStartMs": 3134000,
    "dDurationMs": 9020,
    "segs": [ {
      "utf8": "وذهب الحوت إلى آخره وقال من جديد قال ذلك ما\nكنا نبغ فارتدا على اثارهما قصصا."
    } ]
  }, {
    "tStartMs": 3143680,
    "dDurationMs": 9480,
    "segs": [ {
      "utf8": "موسى عليه السلام اتخذ قرار ان يسير نحو\nالتعلم لذلك قال لا ابرح حتى ابلغ مجمع البحرين"
    } ]
  }, {
    "tStartMs": 3153160,
    "dDurationMs": 9300,
    "segs": [ {
      "utf8": "او امضي حقبا فاذا قد حدد الكلام فوجدا عبدا\nمن عبادنا اتيناه رحمه من عندنا"
    } ]
  }, {
    "tStartMs": 3162790,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "وعلمناه من لدنا علما."
    } ]
  }, {
    "tStartMs": 3165940,
    "dDurationMs": 8760,
    "segs": [ {
      "utf8": "العلم مهما كان حتى وان كان فيه اشياء مكتسبة\nانا اتعلم اقوم بتعلمها ذهابا إلى مدرسة أو إلى"
    } ]
  }, {
    "tStartMs": 3174700,
    "dDurationMs": 7080,
    "segs": [ {
      "utf8": "جامعة أو اطلاعا إلى كتب ولكن من هو العليم\nالذي علمني؟ ولذا جاء في سورة أخرى."
    } ]
  }, {
    "tStartMs": 3182110,
    "dDurationMs": 9180,
    "segs": [ {
      "utf8": "علم الإنسان بالقلم علم الإنسان ما لم يعلم هو\nالذي يعلم سبحانه هو الذي يهدي كل شيء ويعلمه."
    } ]
  }, {
    "tStartMs": 3191590,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "بل دعونا نقول أكثر من هذا."
    } ]
  }, {
    "tStartMs": 3193960,
    "dDurationMs": 8940,
    "segs": [ {
      "utf8": "من الذي علمك أن تمشي؟ هب انك انت أنت تعلمت\nمن كتاب أن تقرأ وأن تكتب وتعلمت العلوم وصعدت"
    } ]
  }, {
    "tStartMs": 3202900,
    "dDurationMs": 8580,
    "segs": [ {
      "utf8": "إلى القمر واكتشفت واكتشفت كما هي فتنة العالم\nالمعاصر اليوم اغترار الانسان بما توصل اليه من"
    } ]
  }, {
    "tStartMs": 3211480,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "علوم هم ذهب."
    } ]
  }, {
    "tStartMs": 3213040,
    "dDurationMs": 5670,
    "segs": [ {
      "utf8": "افترض انك قد حصلت على كل ذلك ولكن دعونا نجب\nعلى سؤال بسيط."
    } ]
  }, {
    "tStartMs": 3218740,
    "dDurationMs": 9720,
    "segs": [ {
      "utf8": "من الذي علمك أن تمشي؟ من؟ من الذي علمك أن\nتأكل؟ من الذي علمك؟ كيف تأكل"
    } ]
  }, {
    "tStartMs": 3228490,
    "dDurationMs": 7890,
    "segs": [ {
      "utf8": "الأشياء البسيطة التي لا ننتبه إليها؟ هل\nقرأتها في كتاب؟ هل أحد من الناس ألف في كتاب؟"
    } ]
  }, {
    "tStartMs": 3236410,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "علم الناس كيف يأكلون."
    } ]
  }, {
    "tStartMs": 3239020,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "علمهم كيف يشربون."
    } ]
  }, {
    "tStartMs": 3241300,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "طيب من علمك."
    } ]
  }, {
    "tStartMs": 3242920,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "كيف تتنفس؟ من علمك؟ من علمك."
    } ]
  }, {
    "tStartMs": 3247390,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "كيف تجعل قلبك ينبض."
    } ]
  }, {
    "tStartMs": 3250390,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "من علمك. الاشياء التي نتصور ونعتقد انها\nبسيطة."
    } ]
  }, {
    "tStartMs": 3256800,
    "dDurationMs": 9600,
    "segs": [ {
      "utf8": "لا يمكن أن نكون قد تعلمنا إلا من عند الله\nسبحانه الذي خلق كل شيء وهداه الذي علم كل"
    } ]
  }, {
    "tStartMs": 3266400,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "شيء، وعلم الإنسان ما لم يعلم."
    } ]
  }, {
    "tStartMs": 3271140,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "قصة موسى عليه السلام قصة تبين معنى قضية أن\nيعلم الإنسان وينظر إلى ظواهر"
    } ]
  }, {
    "tStartMs": 3280980,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "الأمور وبواطنها."
    } ]
  }, {
    "tStartMs": 3283530,
    "dDurationMs": 8730,
    "segs": [ {
      "utf8": "قصة تؤكد على على حقيقة أن الأمور ليست\nبظواهرها، وأن الأمور لا تقرأ فقط بمقدماتها،"
    } ]
  }, {
    "tStartMs": 3292650,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "لا وإنما هناك حكمة من ورائها."
    } ]
  }, {
    "tStartMs": 3296490,
    "dDurationMs": 7470,
    "segs": [ {
      "utf8": "القصص التي وردت في قضية موسى عليه السلام مع\nهذا الرجل تبين أن ما يدور معي من فتن"
    } ]
  }, {
    "tStartMs": 3303960,
    "dDurationMs": 5490,
    "segs": [ {
      "utf8": "واختبارات ومواقف وأحداث الحياة لها حكمة لها."
    } ]
  }, {
    "tStartMs": 3309690,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "لها غرض."
    } ]
  }, {
    "tStartMs": 3311070,
    "dDurationMs": 9120,
    "segs": [ {
      "utf8": "أراد الله سبحانه وتعالى من خلال ذلك الغرض ان\nيحقق اشياء معينة وفي نهاية الأمر هي لصالحي"
    } ]
  }, {
    "tStartMs": 3320190,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "كإنسان طالما أنا أؤمن بأن الله ربي."
    } ]
  }, {
    "tStartMs": 3324960,
    "dDurationMs": 6630,
    "segs": [ {
      "utf8": "طالما أني لا أشرك بالله عز وجل طالما أني قد\nرضيت بحكمه وقدره وقضائه."
    } ]
  }, {
    "tStartMs": 3331830,
    "dDurationMs": 9660,
    "segs": [ {
      "utf8": "وان الدنيا مهما اسودت امام عيني باحداثها\nوصعابها بمشاكلها وفتنها علي"
    } ]
  }, {
    "tStartMs": 3341490,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "دائما أن أبحث عن بصيص نور في خضم الظلام الذي\nأحيا فيه."
    } ]
  }, {
    "tStartMs": 3346860,
    "dDurationMs": 8220,
    "segs": [ {
      "utf8": "في خضم الفتن والمحن والافكار علي دائما أن\nأبقي على ومضة التفاؤل وحسن الظن واليقين بالله"
    } ]
  }, {
    "tStartMs": 3355440,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "متقدا في قلبي وفي نفسي."
    } ]
  }, {
    "tStartMs": 3359640,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "اتفق الرجل الصالح مع موسى عليه السلام على\nالصبر."
    } ]
  }, {
    "tStartMs": 3364890,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "وتأملوا معي قول الله عز وجل."
    } ]
  }, {
    "tStartMs": 3367890,
    "dDurationMs": 9360,
    "segs": [ {
      "utf8": "أولا أدب موسى عليه السلام حين سأل الرجل فقال\nهل اتبعك على ان تعلمني مما علمت رشدا؟"
    } ]
  }, {
    "tStartMs": 3378000,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "وتدبروا معي كم مرة تكرر الكلمة."
    } ]
  }, {
    "tStartMs": 3381750,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "رشد. مرشد."
    } ]
  }, {
    "tStartMs": 3383640,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "رشد. لماذا هذه التصاريف لا يخرج من الفتن إلا\nالرشاد."
    } ]
  }, {
    "tStartMs": 3389310,
    "dDurationMs": 9090,
    "segs": [ {
      "utf8": "والإنسان الحقيقي السعيد هو الذي يقيض الله\nسبحانه وتعالى له الرشد والرشاد"
    } ]
  }, {
    "tStartMs": 3398610,
    "dDurationMs": 8370,
    "segs": [ {
      "utf8": "فيجعله عند ربه رشيدا مرشدا لغيره ويرزقه\nالرشد والرشاد."
    } ]
  }, {
    "tStartMs": 3408060,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "قال إنك لن تستطيع معي صبرا."
    } ]
  }, {
    "tStartMs": 3410610,
    "dDurationMs": 8010,
    "segs": [ {
      "utf8": "أنا ما عندي مانع أنه أنا أعلمك أي شيء لكن\nالعلم بالتعلم والصبر بالتصبر."
    } ]
  }, {
    "tStartMs": 3418620,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "والعلم يحتاج إلى صبر."
    } ]
  }, {
    "tStartMs": 3421230,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "قاعدة عظيمة."
    } ]
  }, {
    "tStartMs": 3423540,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "قاعدة عظيمة خاصة في عالمنا المعاصر."
    } ]
  }, {
    "tStartMs": 3426600,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "نحتاج إليها. كل شيء نريده سريع."
    } ]
  }, {
    "tStartMs": 3429390,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "كل شيء نريده سريع."
    } ]
  }, {
    "tStartMs": 3431280,
    "dDurationMs": 6030,
    "segs": [ {
      "utf8": "العلم بالسرعه والشهاده بالسرعه والوظيفه\nبالسرعه والتسلق على المناصب بالسرعه كل شيء"
    } ]
  }, {
    "tStartMs": 3437310,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "بالسرعه. العلم لا يؤتى الا بالصبر عليه."
    } ]
  }, {
    "tStartMs": 3442350,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "وكيف تصبر على ما لم تحط به خبرا."
    } ]
  }, {
    "tStartMs": 3446790,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "والكلام لنا نحن بطبيعة الحال."
    } ]
  }, {
    "tStartMs": 3450210,
    "dDurationMs": 5970,
    "segs": [ {
      "utf8": "أنا أحتاج إلى الصبر في الأشياء التي لا أحيط\nبها علما ولا خبرة."
    } ]
  }, {
    "tStartMs": 3456510,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "بمعنى آخر حين أتعرض لموقف من المواقف في\nحياتي."
    } ]
  }, {
    "tStartMs": 3461970,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "موقف قد يكون صعب."
    } ]
  }, {
    "tStartMs": 3463980,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "ولا أعرف لماذا حدث وكيف حدث."
    } ]
  }, {
    "tStartMs": 3467100,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "وأي شيء حدث."
    } ]
  }, {
    "tStartMs": 3469170,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "علي أن اصبر."
    } ]
  }, {
    "tStartMs": 3470880,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "علي أن أنظر."
    } ]
  }, {
    "tStartMs": 3471930,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "لا أكتفي فقط بمقدمة الحادثة التي حدثت معي."
    } ]
  }, {
    "tStartMs": 3476460,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "انظر إلى الأمام."
    } ]
  }, {
    "tStartMs": 3478140,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "بمعنى آخر كما نقول في العامية عين خير."
    } ]
  }, {
    "tStartMs": 3482250,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "تفاءل بالخير."
    } ]
  }, {
    "tStartMs": 3484080,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "انظر إلى المستقبل."
    } ]
  }, {
    "tStartMs": 3486030,
    "dDurationMs": 9700,
    "segs": [ {
      "utf8": "انظر إلى المنح التي ستؤتى تؤتى أو تأتي إليك\nمن خلال هذه المنحة فما من منحة تقع إلا"
    } ]
  }, {
    "tStartMs": 3495730,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "وفي طياتها منح."
    } ]
  }, {
    "tStartMs": 3497620,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "لمن؟ لمن امن."
    } ]
  }, {
    "tStartMs": 3499240,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "واستيقن بالله سبحانه وتعالى."
    } ]
  }, {
    "tStartMs": 3503740,
    "dDurationMs": 8790,
    "segs": [ {
      "utf8": "المهم ان موسى عليه السلام وافق على هذا الشرط\nوقال ستجدني ان شاء الله صابرا ولا اعصي لك"
    } ]
  }, {
    "tStartMs": 3512530,
    "dDurationMs": 8040,
    "segs": [ {
      "utf8": "امرا. اتفقا على ألا يسأله عن شيء أبدا إلى أن\nتنتهي فترة الاختبار."
    } ]
  }, {
    "tStartMs": 3520660,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "وهنا لنا وقفة."
    } ]
  }, {
    "tStartMs": 3522640,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "لا تسأل عن شيء."
    } ]
  }, {
    "tStartMs": 3523930,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "كل شيء يتم أمام عينيك."
    } ]
  }, {
    "tStartMs": 3526810,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "لا تفكر. نحن اليوم كبشر."
    } ]
  }, {
    "tStartMs": 3529270,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "احيانا اريد ان اعرف ما الحكمة مما حدث لي."
    } ]
  }, {
    "tStartMs": 3533500,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "اصابني مكروه فقد مني لا سمح الله ولد مال."
    } ]
  }, {
    "tStartMs": 3538330,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "لم اعطى شيء."
    } ]
  }, {
    "tStartMs": 3539860,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "اريد ان اعرف الحكمة."
    } ]
  }, {
    "tStartMs": 3541360,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "النفس البشرية بطبيعتها تريد ان تعرف لماذا\nحدث هذا؟"
    } ]
  } ]
}
