{"model": "mlx-community/whisper-large-v3-turbo", "segments": [{"start": 0.0, "end": 10.0, "text": " منصة زادي للتعلم الشرعي المفتوح تقدم"}, {"start": 11.26, "end": 20.44, "text": " السلام عليكم ورحمة الله وبركاته وحياكم الله أيها الأخوة والأخوات"}, {"start": 20.44, "end": 24.18, "text": " ونواصل معكم في هذه الحلقة"}, {"start": 24.18, "end": 31.28, "text": " مما يتعلق بتدارس القرآن منهجية وضوابط"}, {"start": 31.28, "end": 36.58, "text": " هذا أمر مهم جدا لمن يريد أن يحيي مجالس تدارس القرآن"}, {"start": 36.58, "end": 44.44, "text": " نستطيع أيها الإخوة أن نحدد منهجية التدارس بآية واحدة"}, {"start": 44.44, "end": 46.599999999999994, "text": " واضحة"}, {"start": 46.599999999999994, "end": 48.72, "text": " كل الوضوح في منهجية"}, {"start": 48.72, "end": 50.92, "text": " مجلس القرآن"}, {"start": 50.92, "end": 52.92, "text": " بيّنها الله تعالى"}, {"start": 52.92, "end": 54.9, "text": " في وظيفة النبي صلى الله عليه وسلم"}, {"start": 54.9, "end": 55.78, "text": " في أربع آيات"}, {"start": 55.78, "end": 58.16, "text": " لكن الآية الأولى منها"}, {"start": 58.16, "end": 59.459999999999994, "text": " قال تعالى"}, {"start": 59.459999999999994, "end": 63.28, "text": " يتلو عليهم آياتك"}, {"start": 63.28, "end": 65.36, "text": " ويعلمهم الكتاب"}, {"start": 65.36, "end": 66.08, "text": " والحكمة"}, {"start": 66.08, "end": 67.72, "text": " ويزكيهم"}, {"start": 67.72, "end": 70.82, "text": " ربنا ويبعث فيهم رسولا منهم"}, {"start": 70.82, "end": 72.82, "text": " يتلو عليهم آياتك ويعلمهم الكتاب"}, {"start": 72.82, "end": 73.74, "text": " والحكمة ويزكيهم"}, {"start": 73.74, "end": 79.17999999999999, "text": " تأملوا أيها الأخوة هذه الأمور الثلاثة وذكرها الله في أربع آيات مع تقديم وتأخير"}, {"start": 79.17999999999999, "end": 86.39999999999999, "text": " كما قال الله تعالى كما رسلنا فيكم رسولا منكم يتلع عليكم آياتنا ويزكيكم ويعلمكم كتابه الحكمة"}, {"start": 86.39999999999999, "end": 88.52, "text": " دعونا نتأمل الآية هذه الأولى"}, {"start": 88.52, "end": 96.38, "text": " يتبين لنا بالآية الأولى أن أركان التدارس مجلس التدارس الثلاثة في المنهجية"}, {"start": 96.38, "end": 101.16, "text": " أولا تلاوة للتصحيح لتهيئة النفوس"}, {"start": 101.16, "end": 104.88, "text": " ثانياً يعلمهم ويكتاب حكمة يعلمهم الفهم"}, {"start": 104.88, "end": 109.02, "text": " يفهمهم ويبين لهم المعنى ويتعلق به"}, {"start": 109.02, "end": 114.16, "text": " وأيضاً من العلم يعلمهم ما في هذه الآيات من حقائق"}, {"start": 114.16, "end": 117.64, "text": " ومقاصد وما يريده الله عز وجل"}, {"start": 117.64, "end": 121.17999999999999, "text": " والحكمة يبين لهم طريقة"}, {"start": 121.17999999999999, "end": 124.1, "text": " حكمة هي وضع الشيء في موضعه"}, {"start": 124.1, "end": 125.19999999999999, "text": " كيف نطبق"}, {"start": 125.2, "end": 134.16, "text": " كيف طريقة المناسبة الصحيحة لتطبيق كتاب الله عز وجل وتمثله"}, {"start": 134.16, "end": 139.68, "text": " من خلال هديه عليه الصلاة والسلام من خلال قوله من خلال فعله"}, {"start": 139.68, "end": 146.8, "text": " ثم في الأخير يزكيهم بمعنى يتعاهدهم يتعاهدهم يصحح واقعهم"}, {"start": 146.8, "end": 151.76, "text": " يعني إذا أخطأ أحدهم فيرجعه إلى القرآن"}, {"start": 151.76, "end": 160.16, "text": " من خلال المجلس نفسه أيضا قد يكون هناك مراجعة تصحيح تبيين إلى غير ذلك"}, {"start": 160.16, "end": 167.48, "text": " إذن المنهجية لها أسس منها تلاوة تصحيحا وتهيئة تعليم للفهم"}, {"start": 167.48, "end": 173.76, "text": " ولمعرفة مراد الله عز وجل ومتضمنته هذه الآية من العلم"}, {"start": 173.76, "end": 181.88, "text": " والحكمة هي العمل والتزكية هي تعاهد وتواصي وتأكيد وترسيخ وغير ذلك"}, {"start": 181.88, "end": 188.45999999999998, "text": " هذه ما يتعلق بالمنهجية وهذه المنهجية تأكد في أربع آيات"}, {"start": 188.45999999999998, "end": 194.73999999999998, "text": " لكن هذه الأربع آيات نلحظ فيها تقديم التزكية في ثلاث آيات منها"}, {"start": 194.74, "end": 204.4, "text": " هذه الآية الثلاث قدم فيها التزكية ليؤكد حقيقة على أن التزكية غاية ومهمة جدا في هذه المجالس"}, {"start": 204.4, "end": 212.24, "text": " إذن المنهجية مهمة أن نركز فيها على التزكية التي هي التزكية في حقيقتها تخلية وتحلية"}, {"start": 212.24, "end": 216.98000000000002, "text": " تزكية بتخلية من الصفات السيئة وتحلية بالصفات الحسنة"}, {"start": 216.98000000000002, "end": 223.18, "text": " فننظر بخلال هذا المجالس كيف نصحح واقعنا وصحح نفوسنا وما في حياتنا"}, {"start": 223.18, "end": 229.12, "text": " مما يحدد المنهجية أيضا ما جاء عن السلف"}, {"start": 229.12, "end": 231.34, "text": " قال أبو عبد الرحمن السلم رحمه الله"}, {"start": 231.34, "end": 238.02, "text": " كحدثنا الذين كانوا يقرؤوننا القرآن عثمان وعبد الله بن مسعود وغيرهما"}, {"start": 238.02, "end": 242.32, "text": " أنهم كانوا إذا تعلموا عشر آيات من النبي صلى الله عليه وسلم"}, {"start": 242.32, "end": 246.44, "text": " لم يتجاوزوها حتى يعلم ما فيها من العلم والعمل"}, {"start": 246.44, "end": 250.12, "text": " قال فتعلمنا العلم والقرآن والإلم والأمل جميعا"}, {"start": 250.12, "end": 256.3, "text": " لاحظوا هذه منهجية أنهم يأخذون قدرا عشر آيات خمسة آيات"}, {"start": 256.3, "end": 259.7, "text": " يتعلمون منها العلم والعمل"}, {"start": 259.7, "end": 263.48, "text": " هذا المنهج الصحيح الواضح مع كتاب الله عز وجل"}, {"start": 263.48, "end": 265.74, "text": " لمن أراد أن يقتذ بالسلف"}, {"start": 265.74, "end": 270.84000000000003, "text": " هذا المنهج بهذا الوضوح يسير على ما يسره الله"}, {"start": 270.84000000000003, "end": 272.58, "text": " لكن هناك ضوابط أيها الأخوة"}, {"start": 272.58, "end": 279.76, "text": " مهمة جدا في مجلس التدارس حتى لا نخرج لا نحيط لا ننحرف لا نخطأ"}, {"start": 279.76, "end": 282.2, "text": " لا نجترع على كتاب الله عز وجل"}, {"start": 282.2, "end": 285.56, "text": " من أهم الظوابط في ذلك في هذا المجلس"}, {"start": 285.56, "end": 288.84, "text": " حتى نحقق أكبر فائدة وأكبر تمرة"}, {"start": 288.84, "end": 292.82, "text": " أن المجلس اجتماع"}, {"start": 292.82, "end": 294.96, "text": " الثنين فأكثر"}, {"start": 294.96, "end": 297.88, "text": " وأن يكون لهذا الاجتماع شخص مؤهل"}, {"start": 297.88, "end": 300.4, "text": " فيه شخص مؤهل علميا"}, {"start": 300.4, "end": 302.88, "text": " يكون قادر على التصحيح والتضعيف"}, {"start": 302.88, "end": 305.82, "text": " قادر على ضبط المجلس إدارته إلى غير ذلك"}, {"start": 305.82, "end": 309.64, "text": " إذن هو مجلس لا بد أن يكون له مقيم وضابط"}, {"start": 309.64, "end": 312.44, "text": " يحكمه أيضا"}, {"start": 312.44, "end": 314.44, "text": " هذا المجلس ليس إلقاعا"}, {"start": 314.44, "end": 316.21999999999997, "text": " وإنما حوارا من ضوابطه"}, {"start": 316.21999999999997, "end": 318.15999999999997, "text": " يكونه حوار ونقاش وأخذ"}, {"start": 318.15999999999997, "end": 320.44, "text": " ورد بطرح أسئله بإجابات"}, {"start": 320.44, "end": 322.32, "text": " إشكالات ليس"}, {"start": 322.32, "end": 324.38, "text": " فقط إلقاع هذا ضابط مهم"}, {"start": 324.38, "end": 325.84, "text": " في التدارس أيضا"}, {"start": 325.84, "end": 328.09999999999997, "text": " في التدارس أيضا عدم"}, {"start": 328.09999999999997, "end": 330.14, "text": " القول في كتاب الله إلا بعلم"}, {"start": 330.14, "end": 332.2, "text": " لا ينبغي ولا يجوز أن يجترئ"}, {"start": 332.2, "end": 334.18, "text": " المتدارسون على القول"}, {"start": 334.18, "end": 335.96, "text": " في هذه الآية إلا بعلم"}, {"start": 335.96, "end": 338.59999999999997, "text": " إذن لا تتحدث ولا تتكلم"}, {"start": 338.6, "end": 340.68, "text": " في كتاب الله إلا بألم"}, {"start": 340.68, "end": 346.5, "text": " في من معك كل يدلي بدلوه بحسب علمه"}, {"start": 346.5, "end": 347.48, "text": " بحسب علمه"}, {"start": 347.48, "end": 350.36, "text": " الأخير من الضوابط بارك الله فيكم"}, {"start": 350.36, "end": 355.92, "text": " هو عدم الجدل واللغط في تدارس كتاب الله عز وجل"}, {"start": 355.92, "end": 359.34000000000003, "text": " لا يجوز الجدل ولا يجوز اللغط"}, {"start": 359.34000000000003, "end": 361.86, "text": " احتراما لكتاب الله وتعظيما له"}, {"start": 361.86, "end": 366.58000000000004, "text": " ولهذا قال النهو السلام إذا اختلفتم في كتاب الله فقوموا"}, {"start": 366.58, "end": 369.91999999999996, "text": " فينبغي أن يكون مجلسا معظما"}, {"start": 369.91999999999996, "end": 372.71999999999997, "text": " في الأخير من الضوابط المهمة أيضا"}, {"start": 372.71999999999997, "end": 374.24, "text": " التي ربما لم أذكرها"}, {"start": 374.24, "end": 375.82, "text": " هي قضية أن يكون المجلس"}, {"start": 375.82, "end": 377.4, "text": " يعنى بالعلم والعمل"}, {"start": 377.4, "end": 379.8, "text": " ليس فقط علم"}, {"start": 379.8, "end": 381.21999999999997, "text": " وإنما علم وعمل"}, {"start": 381.21999999999997, "end": 382.79999999999995, "text": " ننظر إلى جوانب العلم"}, {"start": 382.79999999999995, "end": 384.12, "text": " ننظر إلى جوانب العمل"}, {"start": 384.12, "end": 387.82, "text": " حقيقة بهذا يتحقق المجلس منهجية"}, {"start": 387.82, "end": 389.24, "text": " صحيحة"}, {"start": 389.24, "end": 392.2, "text": " وأثر مبارك بإذن الله تعالى"}, {"start": 392.2, "end": 393.91999999999996, "text": " وبرك الله فيكم"}, {"start": 393.91999999999996, "end": 394.79999999999995, "text": " ولنا لقاء"}, {"start": 394.79999999999995, "end": 395.7, "text": " وحياكم الله"}, {"start": 396.58, "end": 398.58, "text": " شكرا"}]}