{"model": "mlx-community/whisper-large-v3-turbo", "segments": [{"start": 0.0, "end": 10.0, "text": " منصة زادي للتعلم الشرعي المفتوح تقدم"}, {"start": 11.26, "end": 17.0, "text": " بسم الله الرحمن الرحيم"}, {"start": 17.0, "end": 18.44, "text": " الحمد لله رب العالمين"}, {"start": 18.44, "end": 21.0, "text": " وبعد حياكم الله أيها الأخوة والأخوات"}, {"start": 21.0, "end": 23.400000000000002, "text": " وما زلنا في تدارس القرآن"}, {"start": 23.400000000000002, "end": 28.44, "text": " ونحن الآن في محطة مهمة"}, {"start": 28.44, "end": 30.32, "text": " في مجالس تدارس القرآن"}, {"start": 30.32, "end": 32.86, "text": " وهي محطة الخطوات العملية"}, {"start": 32.86, "end": 34.4, "text": " في التدارس"}, {"start": 34.4, "end": 36.56, "text": " يعني بمعنى كيف نبدأ"}, {"start": 36.56, "end": 38.2, "text": " وبماذا نبدأ"}, {"start": 38.2, "end": 39.08, "text": " وبماذا ننتهي"}, {"start": 39.08, "end": 42.8, "text": " خطوات مبنية على المهارات"}, {"start": 42.8, "end": 44.02, "text": " التي ذكرناها من قبل"}, {"start": 44.02, "end": 46.7, "text": " مبنية على الأدلة التي ذكرناها"}, {"start": 46.7, "end": 48.58, "text": " أول خطوة"}, {"start": 48.58, "end": 50.42, "text": " هي مدخل مشوق"}, {"start": 50.42, "end": 52.760000000000005, "text": " بالتعريف بالسورة ومقصدها"}, {"start": 52.760000000000005, "end": 53.900000000000006, "text": " وإحوال نزولها"}, {"start": 53.900000000000006, "end": 56.88, "text": " ولا بد أن يكون مشوقا"}, {"start": 56.88, "end": 59.34, "text": " حتى يشد أذهان المستمعين"}, {"start": 59.34, "end": 61.38, "text": " هذا من قبل المؤلم نفسه"}, {"start": 61.38, "end": 63.32, "text": " أو من قبل أحد الطلاب"}, {"start": 63.32, "end": 64.58, "text": " ثانيا"}, {"start": 64.58, "end": 67.06, "text": " تلاوة الآيات"}, {"start": 67.06, "end": 69.36, "text": " ويمكن أن تتقدم تلاوة الآيات"}, {"start": 69.36, "end": 70.5, "text": " على المدخل لا شك"}, {"start": 70.5, "end": 73.44, "text": " لكن المدخل مقصود به"}, {"start": 73.44, "end": 75.44, "text": " أن يكون شادا لانتباه حتى يرى"}, {"start": 75.44, "end": 76.42, "text": " ما هي هذه السورة"}, {"start": 76.42, "end": 78.74000000000001, "text": " ثم يدخل إلى السورة"}, {"start": 78.74000000000001, "end": 80.80000000000001, "text": " يقول معنا سورة كذا ثم نتلوها"}, {"start": 80.80000000000001, "end": 83.02000000000001, "text": " وعلى كل حال هذا راجع إلى"}, {"start": 83.02000000000001, "end": 85.74000000000001, "text": " مهارات المؤلم في قدرته"}, {"start": 85.74, "end": 88.69999999999999, "text": " ومشرف المجلس على قدرته على التنوع"}, {"start": 88.69999999999999, "end": 92.74, "text": " ثالثا قراءة تفسير مختصر"}, {"start": 92.74, "end": 94.8, "text": " يعني الانطلاق من تفسير مختصر"}, {"start": 94.8, "end": 98.0, "text": " مهم جدا أن يعرف المتدارسون معنى الآيات"}, {"start": 98.0, "end": 100.61999999999999, "text": " سواء في المجلس أو قبل المجلس"}, {"start": 100.61999999999999, "end": 102.89999999999999, "text": " لا إشكال أن يقول المشرف مثلا"}, {"start": 102.89999999999999, "end": 106.86, "text": " أننا سنتدارس هذا اليوم سورة الأعلى"}, {"start": 106.86, "end": 108.89999999999999, "text": " فاقرأوها من تفسير كذا"}, {"start": 108.89999999999999, "end": 111.8, "text": " أو أننا نقرأ التفسير في نفس المجلس"}, {"start": 111.8, "end": 113.17999999999999, "text": " ثم نتدارس"}, {"start": 113.17999999999999, "end": 114.32, "text": " لا إشكال في هذا"}, {"start": 114.32, "end": 117.19999999999999, "text": " هذه كلها مقدمات"}, {"start": 117.19999999999999, "end": 118.82, "text": " مدخل المشوق"}, {"start": 118.82, "end": 120.88, "text": " جلاوة الآيات قراءة تفسير"}, {"start": 120.88, "end": 123.39999999999999, "text": " هذه كلها مقدمات للتدارس"}, {"start": 123.39999999999999, "end": 127.13999999999999, "text": " بعد ذلك تأتي ثلاث أمور في نفس التدارس"}, {"start": 127.13999999999999, "end": 132.18, "text": " يعني هي عملية التدارس تقوم على ثلاث أمور"}, {"start": 132.18, "end": 133.57999999999998, "text": " بعد هذه المقدمات الثلاث"}, {"start": 133.57999999999998, "end": 137.7, "text": " أولا ونعتبر رابعا من خطوات"}, {"start": 137.7, "end": 142.38, "text": " من عمليات التدارس طرح الأسئلة التدبرية"}, {"start": 142.38, "end": 148.68, "text": " إيمانية عملية موضعية واقعية علمية كما ذكرنا من قبل"}, {"start": 148.68, "end": 153.26, "text": " طرح الأسئلة بين الشيخ والطلاب أو بين المشرف والطلاب"}, {"start": 153.26, "end": 155.66, "text": " هذه حقيقة عملية التدارس"}, {"start": 155.66, "end": 165.44, "text": " أيضا يدخل في عملية التدارس محاولة ربط الطلاب والمتدارسين بالآثار"}, {"start": 165.44, "end": 169.78, "text": " ماذا نستفيد منها عمليا؟ ماذا نستفيد منها إيمانيا؟"}, {"start": 169.78, "end": 172.1, "text": " ماذا نخلص منها إلى غير ذلك؟"}, {"start": 172.1, "end": 179.96, "text": " وأيضا مع هاتين الخطوتين خطوة استخراج الهدايات من الطلاب"}, {"start": 179.96, "end": 183.95999999999998, "text": " الطالب قد يكون عنده أو المتدارسين عندهم هدايات"}, {"start": 183.95999999999998, "end": 189.7, "text": " لم يذكرها المشرف أو الشيخ ولم يستقصي بها من خلال الأسئلة"}, {"start": 189.7, "end": 196.9, "text": " إذن طرح أسئلة بيان الأثر الإيماني والعملي طرح هدايات واستخراج هدايات العامة"}, {"start": 196.9, "end": 204.70000000000002, "text": " بعد ذلك نأتي إلى قضية خطوات في ختام المجلس"}, {"start": 204.70000000000002, "end": 209.26, "text": " نحن تكلمنا في مقدمة المجلس في عملية المجلس في ختام المجلس"}, {"start": 209.26, "end": 217.22, "text": " في ختام المجلس هناك خلاصة لرسائل عملية مهمة نستفيدها من السورة كلها أو من مقطع خلاصة"}, {"start": 217.22, "end": 223.26, "text": " لا بد أن يختم المجلس بخلاصة مهمة بعصارة المجلس"}, {"start": 223.26, "end": 231.2, "text": " يعني كأنك الآن يعني مثل يعني اللبن يخض يخرج منه زبدة"}, {"start": 231.2, "end": 239.23999999999998, "text": " هذه الزبدة في نهاية المجلس بعد أن استخلصت هدايات وضلالات وأسئلة وآثار إيمانية"}, {"start": 239.23999999999998, "end": 244.78, "text": " جميل جدا أن تخلص إلى أهم الوصايا أو أهم الرسائل"}, {"start": 244.78, "end": 251.26, "text": " بعد ذكر هذه الرسائل مهم جدا أن يختم المشرف والطلاب"}, {"start": 251.26, "end": 256.08, "text": " أي ضوان المتدارسون بتوصيات عملية كيف نفعل"}, {"start": 256.08, "end": 259.65999999999997, "text": " إذا كان هناك نحن سنقوم بكذا إذا كان هناك عمل"}, {"start": 259.65999999999997, "end": 265.74, "text": " هذه الحقيقة الآيات نستخلص منها أعمال مهمة نستفيدها في حياتنا"}, {"start": 265.74, "end": 270.14, "text": " غير الرسائل هذه أعمال واجبات عملية وتطبيقات عملية"}, {"start": 270.14, "end": 278.71999999999997, "text": " وتزكية بمعنى تعاهد النفوس في تحقيق وترسيخ وتثبيت وتطبيق"}, {"start": 278.72, "end": 281.98, "text": " هذه الرسائل والهدايات التي استخلصناها"}, {"start": 281.98, "end": 284.04, "text": " بهذه الخطوات الثمان"}, {"start": 284.04, "end": 288.78000000000003, "text": " نستطيع أن نحقق مجلسا مثاليا"}, {"start": 288.78000000000003, "end": 290.16, "text": " وعيدها باختصار"}, {"start": 290.16, "end": 291.48, "text": " مدخل مشوق"}, {"start": 291.48, "end": 293.06, "text": " تلاوة الآيات"}, {"start": 293.06, "end": 295.0, "text": " قراءة تفسير مختصر"}, {"start": 295.0, "end": 297.76000000000005, "text": " طرح الأسئلة التدبرية المتنوعة"}, {"start": 297.76000000000005, "end": 300.28000000000003, "text": " بيان الأثر الإيماني والعملي"}, {"start": 300.28000000000003, "end": 302.1, "text": " استخلاص هدايات"}, {"start": 302.1, "end": 308.0, "text": " خلاصة رسائل مستخلصة من السورة"}, {"start": 308.0, "end": 312.6, "text": " توصيات في العمل والتطبيق وختام المجلس"}, {"start": 312.6, "end": 315.38, "text": " بارك الله فيكم ولنا لقاء إن شاء الله"}, {"start": 315.38, "end": 318.54, "text": " نواصل فيه حديثنا وحياكم الله"}]}